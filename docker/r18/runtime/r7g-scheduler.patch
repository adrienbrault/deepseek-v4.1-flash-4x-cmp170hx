+# Fair accounting adapted from Morrowmake/vLLM scheduler.py and step.py.
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+class _FairStep:
+    """One allowance, shared across both scheduling loops, discarded after this step.
+
+    The donor supplies the contended total and even split. This port removes
+    bypass, snapshots actual charges, and makes M an admission bound as well.
+    Decode/speculation retains the parent's token and input-row accounting.
+    """
+    def __init__(self, scheduler):
+        self.charges = {}
+        self.limit = scheduler.fair_split
+        total = scheduler.max_num_scheduled_tokens
+        if any(not r.is_prefill_chunk for r in scheduler.running):
+            total = min(total, scheduler.fair_cap)
+        # Count before lookup: cache hits can conservatively reserve a share.
+        # Actual work is classified later, after cache lookup and SWA replay.
+        running = sum(r.is_prefill_chunk for r in scheduler.running)
+        slots = max(0, scheduler.max_num_active_reqs - len(scheduler.running)
+                    - scheduler.num_waiting_for_streaming_input)
+        waiting = len(scheduler.kv_holding_waiting)
+        if scheduler._pause_state == PauseState.UNPAUSED:
+            waiting += len(scheduler.waiting)
+        shares = min(self.limit, running + min(waiting, slots)) if self.limit else 1
+        # Init rejects a cap/split combination that cannot cross the MTP
+        # lookahead window; never enlarge the requested contended allowance.
+        self.left = total
+        self.share = total // max(1, shares)
+
+    def cap(self, request, computed, tokens):
+        if not (request.is_prefill_chunk if computed is None else computed < request.num_tokens - 1):
+            return tokens
+        # Even tiny final chunks consume a prompt share. There is no bypass.
+        if self.limit and len(self.charges) >= self.limit:
+            return 0
+        return min(tokens, self.share, self.left)
+
+    def charge(self, request, computed, tokens):
+        # Call only after successful KV allocation, before request state moves.
+        # None means the running-loop prefill flag; waiting uses actual work.
+        if request.is_prefill_chunk if computed is None else computed < request.num_tokens - 1:
+            self.charges[request.request_id] = tokens
+            self.left -= tokens
+            assert self.left >= 0
+
+    def refund(self, request_id):
+        # Never reclassify from a victim's possibly changed computed counter.
+        # pop makes an uncharged victim (or repeated refund) a precise no-op.
+        self.left += self.charges.pop(request_id, 0)
+
+
