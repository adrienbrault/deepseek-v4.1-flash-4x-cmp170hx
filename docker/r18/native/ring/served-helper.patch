+        "tvm_ffi_version": importlib.metadata.version("apache-tvm-ffi"),
+        "torch_version": str(torch.__version__),
+        "torch_cuda": torch.version.cuda,
+        "python_soabi": sysconfig.get_config_var("SOABI"),
+        "cxx11_abi": bool(torch._C._GLIBCXX_USE_CXX11_ABI),
+    }
+    if abi["flashinfer_version"] != FLASHINFER_VERSION or any(
+        manifest[key] != value for key, value in abi.items()
+    ):
+        raise RuntimeError("true-ring FlashInfer/FFI/Torch/CUDA ABI differs from the image build")
+    fi = Path(flashinfer.__file__).resolve().parent
+    for rel, expected in manifest["stock_fi_sources"].items():
+        if digest(fi / rel) != expected:
+            raise RuntimeError("stock FI source changed: " + rel)
+    native = tvm_ffi.load_module(str(Path(root) / "native.so"))
