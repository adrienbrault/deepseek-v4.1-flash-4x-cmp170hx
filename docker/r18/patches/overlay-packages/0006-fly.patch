Subject: Check the v0.34 verifier cache ABI and preserve persistent-slot mappings.

diff --git a/fly_names/fly_names/runtime.py b/fly_names/fly_names/runtime.py
--- a/fly_names/fly_names/runtime.py
+++ b/fly_names/fly_names/runtime.py
@@ -171,6 +171,8 @@
