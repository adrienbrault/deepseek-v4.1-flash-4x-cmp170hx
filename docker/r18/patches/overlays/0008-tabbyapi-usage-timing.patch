+def set_usage_timing(usage: UsageTiming, metrics: PerRequestMetrics) -> None:
+    """Copy the available timing measurements onto the response's usage."""
+    usage.prompt_tokens_per_sec = metrics.prefill_tokens_per_second
+    usage.completion_tokens_per_sec = metrics.decode_tokens_per_second
+    prompt_ms = metrics.time_to_first_token_ms
+    completion_ms = metrics.generation_time_ms
+    queue_ms = metrics.queue_time_ms
+    if prompt_ms is not None:
+        usage.prompt_time = prompt_ms / 1000
+    if completion_ms is not None:
+        usage.completion_time = completion_ms / 1000
+    if queue_ms is not None and prompt_ms is not None and completion_ms is not None:
+        usage.total_time = (queue_ms + prompt_ms + completion_ms) / 1000


