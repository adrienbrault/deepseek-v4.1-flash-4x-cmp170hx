+def _splitk_numerics_pv(p, k, PV_PRECISION: tl.constexpr):
+    # QK is unchanged. Only the unnormalized softmax probability operand changes.
+    if PV_PRECISION == 1:
+        p_hi = p.to(tl.bfloat16)
+        p_lo = (p - p_hi.to(tl.float32)).to(tl.bfloat16)
+        return tl.dot(p_lo, k, acc=tl.dot(p_hi, k))
+    elif PV_PRECISION == 2:
+        # Deliberately slow diagnostic: full FP32 operands, no TF32 truncation.
+        return tl.dot(p.to(tl.float32), k.to(tl.float32), input_precision="ieee")
+    else:
+        return tl.dot(p.to(k.dtype), k)
+
+
