+        # rows, so grouping doesn't need unique() or a device-to-host count.
+        replay_meta.active_lora_ids.copy_(
+            torch.arange(-1, self.max_loras, device=replay_indices.device)
+        )
+        replay_meta.num_active_loras_cpu.fill_(self.max_loras + 1)
+        starts = replay_meta.lora_token_start_loc
+
+        @contextmanager
+        def replay_context(rows: torch.Tensor, num_tokens: int):
+            full_indices = self._token_lora_indices
+            full_length = self.indices_len[0]
+            full_meta = self.token_mapping_meta
+            num_rows = rows.numel()
+            assert full_length is not None
+            assert num_rows <= num_tokens <= replay_indices.numel()
+            torch.index_select(
