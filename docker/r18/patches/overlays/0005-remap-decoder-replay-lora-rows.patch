+            # Logits/sampler indices describe the scattered outputs and stay
+            # on the outer batch throughout.
+            self._token_lora_indices = replay_indices
+            self.indices_len[0] = num_tokens
+            self.token_mapping_meta = replay_meta
+            try:
+                yield
+            finally:
+                self._token_lora_indices = full_indices
+                self.indices_len[0] = full_length
+                self.token_mapping_meta = full_meta
