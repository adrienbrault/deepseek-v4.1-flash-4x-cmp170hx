+            )
+            if num_rows < num_tokens:
+                replay_indices[num_rows:num_tokens].fill_(-1)
+
+            # Dense wo_b reads the raw token indices. Generic GPU Punica reads
+            # the same slots in int32 plus a stable grouping of compact rows.
+            mapping = replay_meta.token_lora_mapping[:num_tokens]
+            mapping.copy_(replay_indices[:num_tokens])
+            torch.sort(
+                mapping, stable=True,
+                out=(sorted_slots[:num_tokens], sorted_rows[:num_tokens]),
+            )
+            replay_meta.token_indices_sorted_by_lora_ids[:num_tokens].copy_(
+                sorted_rows[:num_tokens]
+            )
+            torch.searchsorted(
+                sorted_slots[:num_tokens], replay_meta.active_lora_ids,
+                right=True, out_int32=True, out=starts[1:],
+            )
