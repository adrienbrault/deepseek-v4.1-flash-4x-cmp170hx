+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Opt-in startup accounting and bounded serving diagnostics."""
+
+import functools
+import json
+import os
+import time
+from pathlib import Path
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+
+def profile_steps() -> set[int]:
+    """Matching worker calls to capture; defaults retain the decode diagnostic."""
+    steps = {int(s) for s in os.environ.get(
+        "DSV41_DEBUG_PROFILE_STEPS", "40,41"
+    ).split(",")}
+    if not steps or min(steps) < 1:
+        raise ValueError("DSV41_DEBUG_PROFILE_STEPS must contain positive integers")
+    return steps
+
+
+def export_profile(profiler, tokens: int, hit: int, elapsed_ms: float) -> None:
+    """Export separate traces for every distributed rank when requested."""
+    directory = os.environ.get("DSV41_DEBUG_PROFILE_DIR")
+    if not directory:
+        return
+    import torch.distributed as dist
+
+    rank = dist.get_rank() if dist.is_initialized() else 0
+    root = Path(directory)
+    root.mkdir(parents=True, exist_ok=True)
+    stem = root / f"prefill-rank{rank}-t{tokens}-hit{hit}"
+    profiler.export_chrome_trace(str(stem) + ".trace.json")
+    table = profiler.key_averages().table(
+        sort_by="self_cuda_time_total", row_limit=200
+    )
+    Path(str(stem) + ".txt").write_text(table)
+    Path(str(stem) + ".meta.json").write_text(json.dumps({
+        "rank": rank, "scheduled_tokens": tokens, "matching_call": hit,
+        "synchronized_wall_ms": elapsed_ms,
+        "profile_steps": sorted(profile_steps()),
+    }, indent=2) + "\n")
+
+
+def memory_census(phase, device):
+    if os.environ.get("DSV41_MEMORY_CENSUS", "0") != "1":
+        return
+    import torch
+    from vllm.distributed import get_pp_group, get_tp_group
+
+    torch.cuda.synchronize(device)
+    stats = torch.cuda.memory_stats(device)
+    free, total = torch.cuda.mem_get_info(device)
+    allocated = torch.cuda.memory_allocated(device)
+    reserved = torch.cuda.memory_reserved(device)
+    logger.info(
+        "DSV41_MEMORY phase=%s pp=%d tp=%d allocated=%.3f reserved=%.3f "
+        "reserved_minus_allocated=%.3f inactive_split=%.3f "
+        "external=%.3f free=%.3f GiB allocator=%s",
+        phase, get_pp_group().rank_in_group, get_tp_group().rank_in_group,
+        allocated / 2**30, reserved / 2**30, (reserved - allocated) / 2**30,
+        stats.get("inactive_split_bytes.all.current", 0) / 2**30,
+        (total - free - reserved) / 2**30, free / 2**30,
+        torch.cuda.get_allocator_backend(),
+    )
+
+
+def debug_call(label, *switches):
+    """Log host phase duration; timing explicitly synchronizes at outer boundaries."""
+    def decorate(fn):
+        @functools.wraps(fn)
+        def wrapped(self, *args, **kwargs):
+            if not any(os.environ.get(key) == "1" for key in switches):
+                return fn(self, *args, **kwargs)
+            import torch
+
+            attr = "_dsv41_debug_" + label + "_" + fn.__name__
+            step = getattr(self, attr, 0) + 1
+            setattr(self, attr, step)
+            tokens = getattr(args[0], "total_num_scheduled_tokens", None) if args else None
+            gpu = torch.cuda.is_initialized()
+            capturing = gpu and torch.cuda.is_current_stream_capturing()
+            sync = gpu and not capturing and os.environ.get("DSV41_DEBUG_TIMING") == "1"
+            profile = (
+                label == "worker" and not capturing
+                and os.environ.get("DSV41_DEBUG_PROFILE") == "1"
+                and tokens == int(os.environ.get("DSV41_DEBUG_PROFILE_T", "1"))
+            )
+            if profile:
+                count = getattr(self, "_dsv41_profile_count", 0) + 1
+                self._dsv41_profile_count = count
+                profile = count in profile_steps()
+            if sync:
+                torch.cuda.synchronize()
+            start = time.perf_counter()
+            if profile:
+                from torch.profiler import ProfilerActivity, profile as torch_profile
+
+                torch.cuda.synchronize()
+                profile_start = time.perf_counter()
+                with torch_profile(
+                    activities=[ProfilerActivity.CPU, ProfilerActivity.CUDA],
+                    record_shapes=True,
+                ) as p:
+                    result = fn(self, *args, **kwargs)
+                    torch.cuda.synchronize()
+                elapsed_ms = (time.perf_counter() - profile_start) * 1e3
+                export_profile(p, tokens, count, elapsed_ms)
+                logger.info("DSV41 PROFILE %s", p.key_averages().table(
+                    sort_by="self_cuda_time_total", row_limit=40,
+                ))
+            else:
+                result = fn(self, *args, **kwargs)
+            if sync:
+                torch.cuda.synchronize()
+            if step <= 96 or step % 64 == 0:
+                logger.info(
+                    "DSV41_DEBUG phase=%s step=%d tokens=%s host_ms=%.3f synchronized=%s",
+                    f"{label}.{fn.__name__}", step, tokens,
+                    (time.perf_counter() - start) * 1e3, sync,
+                )
+            return result
+        return wrapped
+    return decorate
