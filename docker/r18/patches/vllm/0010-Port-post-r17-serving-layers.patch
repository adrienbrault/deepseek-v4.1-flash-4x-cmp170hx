+def _dsv41_dense_rank1(x, output, a, b, token_lora_indices):
+    """Dense wo_b LoRA; all tensor indexing uses fixed Python slices only.
+
+    M may be smaller than metadata (slice it), never larger (shape-only assert).
+    No device scalars, sorting, gather/scatter, or persistent scratch buffers.
+    Preserve inactive output bytes, including signed zero and NaN payloads.
+    """
+    assert x.ndim == output.ndim == 2
+    m = x.shape[0]
+    assert output.shape[0] == m and token_lora_indices.ndim == 1
+    assert m <= token_lora_indices.shape[0], "wo_b rows exceed LoRA metadata"
+    assert a.shape == (1, 1, 1, x.shape[1])
+    assert b.shape == (1, 1, output.shape[1], 1)
+    assert x.dtype == output.dtype == a.dtype == b.dtype == torch.bfloat16
+    assert x.device == output.device == a.device == b.device == token_lora_indices.device
+    idx = token_lora_indices[:m]
+    for slot in range(a.shape[0]):
+        mask = (idx == slot).unsqueeze(1)
+        t = x.float() @ a[slot, 0].float().T
+        t = t * mask
+        delta = (t @ b[slot, 0].float().T).to(output.dtype)
+        # add_(0) changes -0 to +0; select the original inactive bytes instead.
+        output.copy_(torch.where(mask, output + delta, output))
+    return output
+
