+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Opt-in prefill overlap of TP reductions with row-wise compute (SM80 TP4).
+
+Between two attention cores every operation of a DeepSeek V4.1 decoder layer
+is row-wise: the attention output projection, its all-reduce, the mHC
+post/pre seam, the MoE and its all-reduce. Only the sparse attention core
+mixes tokens. The pipeline therefore splits the rows after the attention core
+into two halves and keeps one communication stream busy:
+
+    comm:  AR_attn(h0)  AR_attn(h1)        AR_moe(h0)       AR_moe(h1)
+    main:  [o-proj]     seam(h0)+MoE(h0)   seam(h1)+MoE(h1)  join
+
+MoE(h0) runs under AR_attn(h1) and MoE(h1) under AR_moe(h0). Every rank
+issues the four collectives in the same order on the same stream, so the
+collective sequence is identical across ranks (deadlock-free by construction).
+Decode, CUDA graph capture and small batches never enter the pipeline.
+
+Torch is imported lazily so the scheduling logic is testable without CUDA:
+callers pass an ``ops`` object (``TorchOps`` in serving, fakes in tests).
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+
+ENV = "DSV41_PREFILL_OVERLAP"
+ENV_MIN_ROWS = "DSV41_PREFILL_OVERLAP_MIN_ROWS"
+ENV_CHECK = "DSV41_PREFILL_OVERLAP_CHECK"
+ENV_CHECK_DIR = "DSV41_PREFILL_OVERLAP_CHECK_DIR"
+DEFAULT_MIN_ROWS = 512
+DECODE_MAX_ROWS = 48
+
+
+@dataclass(frozen=True)
+class Settings:
+    min_rows: int
+    check: bool
+    check_dir: str | None
+
+
+def parse_settings(environ=os.environ) -> Settings | None:
+    value = environ.get(ENV, "0")
+    if value not in ("0", "1"):
+        raise ValueError(f"{ENV} must be 0 or 1, got {value!r}")
+    if value == "0":
+        return None
+    raw = environ.get(ENV_MIN_ROWS, str(DEFAULT_MIN_ROWS))
+    if not raw.isdigit() or int(raw) < 2 * (DECODE_MAX_ROWS + 1) or int(raw) > 65536:
+        raise ValueError(f"{ENV_MIN_ROWS} must be an integer in [98, 65536]")
+    check = environ.get(ENV_CHECK, "0")
+    if check not in ("0", "1"):
+        raise ValueError(f"{ENV_CHECK} must be 0 or 1")
+    return Settings(int(raw), check == "1", environ.get(ENV_CHECK_DIR) or None)
+
+
+def validate(*, device_capability, tp, pp, dp, expert_parallel, ubatching,
+             sequence_parallel, fuse_mhc_all_reduce, gemm_rs, quant_name,
+             batch_invariant, moe_chunk, lora) -> None:
+    """Refuse every configuration the pipeline was not designed for."""
+    problems = []
+    if device_capability != (8, 0):
+        problems.append("SM80")
+    if (tp, pp, dp) != (4, 1, 1):
+        problems.append("TP4/PP1/DP1")
+    if expert_parallel:
+        problems.append("no expert parallel")
+    if ubatching:
+        problems.append("no ubatching/TBO (it also disables SWA bounded replay)")
+    if sequence_parallel:
+        problems.append("no sequence parallel")
+    if fuse_mhc_all_reduce or gemm_rs:
+        problems.append("no fused mHC all-reduce or GEMM-RS")
+    if quant_name != "exl3":
+        problems.append("EXL3 weights")
+    if batch_invariant:
+        problems.append("no batch-invariant mode")
+    if moe_chunk:
+        problems.append("DSV41_PREFILL_MOE_CHUNK=0 (r13 pipeline is the MoE-only predecessor)")
+    if lora:
+        problems.append("no LoRA")
+    if problems:
+        raise ValueError(f"{ENV}=1 requires: " + ", ".join(problems))
+
+
+def eligible(settings: Settings | None, rows: int, capturing: bool) -> bool:
+    return settings is not None and not capturing and rows >= settings.min_rows
+
+
+def half_ranges(rows: int) -> list[tuple[int, int]]:
+    if rows < 2:
+        raise ValueError("need at least two rows to split")
+    mid = rows // 2
+    return [(0, mid), (mid, rows)]
+
+
+_COMM_STREAMS: dict = {}
+
+
+def comm_stream(device):
+    """One communication stream per device, shared by every layer, so all
+    pipelined collectives of a rank stay in one issue order."""
+    stream = _COMM_STREAMS.get(device)
+    if stream is None:
+        import torch
+
+        stream = _COMM_STREAMS[device] = torch.cuda.Stream(device=device)
+    return stream
+
+
+class TorchOps:
+    """Stream/event primitives for the serving path."""
+
+    def __init__(self, comm_stream):
+        import torch
+
+        self.torch = torch
+        self.comm = comm_stream
+
+    def main(self):
+        return self.torch.cuda.current_stream()
+
+    def record(self, stream):
+        event = self.torch.cuda.Event()
+        event.record(stream)
+        return event
+
+    def wait(self, stream, event):
+        stream.wait_event(event)
+
+    def on(self, stream):
+        return self.torch.cuda.stream(stream)
+
+    def keep(self, tensor, stream):
+        tensor.record_stream(stream)
+
+    def own(self, tensor):
+        # Producers may return views of persistent scratch that the next call
+        # reuses; the communication stream reads an owned copy.
+        return tensor.contiguous().clone()
+
+    def join(self, main, comm):
+        main.wait_stream(comm)
+
+    def cat(self, parts):
+        return self.torch.cat(parts, dim=0)
+
+
+def run(partial, seam, moe_local, all_reduce, ops):
+    """Pipeline the post-attention half of a decoder layer.
+
+    partial:   [T, H] unreduced attention output (o-projection without its AR)
+    seam:      (lo, hi, reduced_attn) -> (residual, post_mix, res_mix, x, ffn_pre)
+               for rows lo:hi (the second mHC post/pre of the layer)
+    moe_local: (lo, hi, x) -> unreduced MoE output for rows lo:hi
+    all_reduce: tensor -> reduced tensor, called with ``ops.comm`` current
+    Returns (moe_out_reduced, residual, post_mix, res_mix, ffn_pre) for all rows.
+    """
+    rows = partial.shape[0]
+    ranges = half_ranges(rows)
+    main = ops.main()
+    comm = ops.comm
+    owned = ops.own(partial)
+    ops.wait(comm, ops.record(main))
+    ops.keep(owned, comm)
+    attn_done = []
+    for lo, hi in ranges:
+        with ops.on(comm):
+            reduced = all_reduce(owned[lo:hi])
+        attn_done.append((reduced, ops.record(comm)))
+    seams, moe_done = [], []
+    for (lo, hi), (reduced, event) in zip(ranges, attn_done):
+        ops.wait(main, event)
+        ops.keep(reduced, main)
+        state = seam(lo, hi, reduced)
+        local = ops.own(moe_local(lo, hi, state[3]))
+        ops.wait(comm, ops.record(main))
+        ops.keep(local, comm)
+        with ops.on(comm):
+            out = all_reduce(local)
+        moe_done.append(out)
+        seams.append(state)
+    ops.join(main, comm)
+    for out in moe_done:
+        ops.keep(out, main)
+    x = ops.cat(moe_done)
+    residual, post_mix, res_mix, _, ffn_pre = (
+        ops.cat([s[i] for s in seams]) for i in range(5)
+    )
+    return x, residual, post_mix, res_mix, ffn_pre
+
+
+def serial(partial, seam, moe_local, all_reduce):
+    """Reference order (no split): what the unmodified layer computes."""
+    rows = partial.shape[0]
+    reduced = all_reduce(partial)
+    residual, post_mix, res_mix, x, ffn_pre = seam(0, rows, reduced)
+    return all_reduce(moe_local(0, rows, x)), residual, post_mix, res_mix, ffn_pre
+
+
+def compare(name, rows, got, ref, directory=None, rank=0):
+    """Record pipelined-vs-serial differences (qualification only).
+
+    Bit identity is not expected: MoE and mHC kernels choose tiling by row
+    count and a BF16 NCCL reduction's order depends on the message size. The
+    INT8 prefill all-reduce itself is split-invariant.
+    """
+    import json
+
+    labels = ("x", "residual", "post_mix", "res_mix", "ffn_pre")
+    record = {"layer": name, "rows": rows, "rank": rank, "outputs": {}}
+    for label, a, b in zip(labels, got, ref):
+        diff = (a.float() - b.float()).abs()
+        scale = b.float().abs().max().item()
+        record["outputs"][label] = {
+            "bit_equal": bool((a == b).all().item()),
+            "max_abs": diff.max().item(),
+            "max_ref": scale,
+            "rel_rms": (diff.pow(2).mean().sqrt() / b.float().pow(2).mean().sqrt().clamp_min(1e-30)).item(),
+        }
+    if directory:
+        import re
+        from pathlib import Path
+
+        root = Path(directory)
+        root.mkdir(parents=True, exist_ok=True)
+        label = re.sub(r"[^A-Za-z0-9_.-]", "_", name)
+        (root / f"overlap-rank{rank}-{label}-t{rows}.json").write_text(
+            json.dumps(record, indent=2) + "\n"
+        )
+    return record
