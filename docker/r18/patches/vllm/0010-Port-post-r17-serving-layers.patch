+
+class RotatedSchedule:
+    """The rotated schedule over an initialized ``DSV41Int8PrefillComm``.
+
+    Uses the comm's peer buffer (rotated layout), barrier header, CTA settings
+    and grids. All work runs on the caller's current stream; one instance must
+    not be used by two streams concurrently (as 0032).
+    """
+
+    def __init__(self, comm):
+        self.comm = comm
+        lay = comm.layout
+        if lay.rs_stride <= 0 or lay.ag_stride <= 0:
+            raise ValueError("rotated schedule needs the rotated buffer layout")
+        self.rank = comm.rank
+        self.rs_base = [p + lay.rs_values for p in comm.pointers]
+        self.ag_base = [p + lay.ag_values for p in comm.pointers]
+        self.group_blocks = TILE // lay.block
+        steps = rotated_steps(self.rank)
+        self.rs_steps = [(k, peer, quarter) for phase, k, peer, quarter in steps if phase == "rs"]
+        self.ag_peers = [peer for phase, _, peer, _ in steps if phase == "ag"]
+        # Boot probe (local, inside this rank's own buffer): Triton must accept
+        # raw pointer arguments, and the copy kernel compiles now rather than
+        # at the first prefill.
+        base = self.ag_base[self.rank]
+        with torch.cuda.device(comm.device):
+            _copy_slot[(1,)](_Raw(base, torch.int8), _Raw(base + lay.ag_stride, torch.int8),
+                             256, COPY_CHUNK, num_warps=4)
+        torch.cuda.synchronize(comm.device)
+
+    def _copy_grid(self, nbytes: int) -> tuple[int]:
+        tiles = -(-nbytes // COPY_CHUNK)
+        return (max(1, min(tiles, self.comm.settings.ctas)),)
+
+    def all_reduce(self, x: torch.Tensor) -> torch.Tensor:
+        c, lay, r = self.comm, self.comm.layout, self.rank
+        block = lay.block
+        shard = x.numel() // WORLD
+        nblk = shard // block
+        flat = x.view(-1)
+        out = torch.empty_like(x)
+        for k, peer, quarter in self.rs_steps:
+            slot = self.rs_base[peer] + r * lay.rs_stride
+            grid = c._grid(nblk) if k else c._local_grid(nblk)
+            _quant_store[grid](
+                flat[quarter * shard:(quarter + 1) * shard],
+                _Raw(slot, torch.int8), _Raw(slot + shard, torch.float32),
+                nblk, block, self.group_blocks, k != 0,
+                num_warps=4, enable_fp_fusion=False)
+        _barrier[(1,)](c.ptrs, r, PHASE_RS, num_warps=1)
+        own_rs = self.rs_base[r]
+        own_ag = self.ag_base[r] + r * lay.ag_stride
+        _reduce_requant[c._local_grid(nblk)](
+            _Raw(own_rs, torch.int8), _Raw(own_rs + shard, torch.float32),
+            lay.rs_stride, lay.rs_stride // 4,
+            _Raw(own_ag, torch.int8), _Raw(own_ag + shard, torch.float32),
+            nblk, block, self.group_blocks, num_warps=4, enable_fp_fusion=False)
+        self._push_own_gather_slot(own_ag, copy_bytes(shard, block))
+        _barrier[(1,)](c.ptrs, r, PHASE_AG, num_warps=1)
+        _gather[c._local_grid(WORLD * nblk)](
+            _Raw(self.ag_base[r], torch.int8), _Raw(self.ag_base[r] + shard, torch.float32),
+            lay.ag_stride, lay.ag_stride // 4, out, shard, block, self.group_blocks,
+            num_warps=4, enable_fp_fusion=False)
+        return out
+
+    def all_gather_stacked(self, x: torch.Tensor) -> torch.Tensor:
+        """0032's stacked layout: [WORLD * x.shape[0], *x.shape[1:]]."""
+        c, lay, r = self.comm, self.comm.layout, self.rank
+        block = lay.block
+        numel = x.numel()
+        nblk = numel // block
+        out = x.new_empty((WORLD * x.shape[0], *x.shape[1:]))
+        # Pre-barrier: every rank has finished reading its gather inbox.
+        _barrier[(1,)](c.ptrs, r, PHASE_FREE, num_warps=1)
+        own_ag = self.ag_base[r] + r * lay.ag_stride
+        _quant_store[c._local_grid(nblk)](
+            x.view(-1), _Raw(own_ag, torch.int8), _Raw(own_ag + numel, torch.float32),
+            nblk, block, self.group_blocks, False, num_warps=4, enable_fp_fusion=False)
+        self._push_own_gather_slot(own_ag, copy_bytes(numel, block))
+        _barrier[(1,)](c.ptrs, r, PHASE_AG, num_warps=1)
+        _gather[c._local_grid(WORLD * nblk)](
+            _Raw(self.ag_base[r], torch.int8), _Raw(self.ag_base[r] + numel, torch.float32),
+            lay.ag_stride, lay.ag_stride // 4, out, numel, block, self.group_blocks,
+            num_warps=4, enable_fp_fusion=False)
+        return out
+
+    def _push_own_gather_slot(self, own_ag: int, nbytes: int) -> None:
+        # One peer per launch, in rotated order; kernel boundaries keep the
+        # GPU writing to a single peer at a time.
+        lay, r = self.comm.layout, self.rank
+        assert nbytes <= lay.ag_stride
+        grid = self._copy_grid(nbytes)
+        for peer in self.ag_peers:
+            dst = self.ag_base[peer] + r * lay.ag_stride
+            _copy_slot[grid](_Raw(own_ag, torch.int8), _Raw(dst, torch.int8), nbytes,
+                             COPY_CHUNK, num_warps=4)
