diff --git a/vllm/distributed/device_communicators/dsv41_int8_prefill.py b/vllm/distributed/device_communicators/dsv41_int8_prefill.py
new file mode 100644
index 0000000..3029fda
--- /dev/null
+++ b/vllm/distributed/device_communicators/dsv41_int8_prefill.py
@@ -0,0 +1,344 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Opt-in TP4 INT8 push all-reduce / all-gather for prefill-sized messages.
+
+Sibling of the r17 decode codec (``dsv41_int8_all_reduce.py``), rebuilt for
+2048 x 5120 messages on PCIe 2.0 x4:
+
+* push, not pull: every byte crosses PCIe as a posted write into the peer's
+  inbox; all reads are local. Readers poll local flags.
+* two shots: (1) quantize each block and write it to the rank that owns its
+  quarter, (2) the owner sums the four copies in FP32 in rank order 0..3,
+  requantizes, and writes the reduced quarter to every rank. Each rank sends
+  1.5 x N x (1 + 4/BLOCK) bytes, about half the BF16 ring.
+* symmetric INT8 [-127, 127], one FP32 absmax scale per BLOCK values, round to
+  nearest even, FP32 accumulation, BF16 output. Every rank dequantizes the same
+  bytes, so all ranks return bit-identical tensors.
+* split invariance: a block never straddles a row (5120 = 20 x 256) and the
+  sum order is fixed, so reducing two row halves separately gives the same bits
+  as reducing the whole message.
+* device-side epochs (monotonic, per phase and source) instead of host
+  sequence numbers; no host synchronization per call.
+
+All work runs on the caller's current stream. One instance must not be used
+by two streams concurrently; callers order streams with events (the prefill
+overlap pipeline keeps all of its collectives on one communication stream).
+CUDA graph capture is never used: the dispatch predicate refuses capture.
+
+``Settings.schedule == "rotated"`` (patch 0034) routes both collectives to
+``dsv41_int8_prefill_rotated``: same numerics and bytes, one peer per step.
+"""
+
+import torch
+import torch.distributed as dist
+
+from vllm.distributed.device_communicators.custom_all_reduce import CustomAllreduce
+from vllm.distributed.parallel_state import in_the_same_node_as
+from vllm.triton_utils import tl, triton
+
+from .dsv41_int8_prefill_policy import (
+    HEADER_BYTES,
+    PHASE_AG,
+    PHASE_FREE,
+    PHASE_RS,
+    SCHEDULE_ROTATED,
+    WORLD,
+    Settings,
+    ag_eligible,
+    ar_eligible,
+    make_layout,
+)
+
+TILE = 2048  # values per CTA iteration; GROUP = TILE // BLOCK blocks
+
+
+@triton.jit
+def _rint(x):
+    # Explicit round-to-nearest-even, as the r17 codec (no FP8 on Ampere).
+    return tl.inline_asm_elementwise(
+        "cvt.rni.s32.f32 $0, $1;", constraints="=r,f", args=[x],
+        dtype=tl.int32, is_pure=True, pack=1)
+
+
+@triton.jit
+def _fence_sys(x):
+    # Make this thread's remote (peer) stores visible system-wide before the
+    # kernel ends; the following barrier kernel then publishes the epoch.
+    return tl.inline_asm_elementwise(
+        "fence.sc.sys; mov.u32 $0, $1;", constraints="=r,r", args=[x],
+        dtype=tl.int32, is_pure=False, pack=1)
+
+
+@triton.jit
+def _quant_push(X, Ptrs, RANK: tl.constexpr, NUMEL, PART,
+                VALUES: tl.constexpr, SCALES: tl.constexpr,
+                BLOCK: tl.constexpr, GROUP: tl.constexpr, ALL_PEERS: tl.constexpr):
+    """Quantize X's blocks and write them into peer inboxes (slot RANK).
+
+    Inbox slots are compact for the current message: slot stride PART values
+    and PART / BLOCK scales.
+    ALL_PEERS=False (all-reduce shot 1, PART = NUMEL / 4): block b goes only to
+    the owner of its quarter, rank b // (PART / BLOCK).
+    ALL_PEERS=True (all-gather, PART = NUMEL): every block goes to every rank.
+    """
+    pid = tl.program_id(0)
+    nprog = tl.num_programs(0)
+    blocks = NUMEL // BLOCK
+    part_blocks = PART // BLOCK
+    tiles = tl.cdiv(blocks, GROUP)
+    g = tl.arange(0, GROUP)
+    lane = tl.arange(0, BLOCK)
+    for tile in range(pid, tiles, nprog):
+        b = tile * GROUP + g
+        live = b < blocks
+        x = tl.load(X + b[:, None] * BLOCK + lane[None, :], mask=live[:, None],
+                    other=0.0).to(tl.float32)
+        scale = tl.maximum(tl.div_rn(tl.max(tl.abs(x), 1), 127.0), 1.0e-30)
+        q = tl.minimum(127, tl.maximum(-127, _rint(tl.div_rn(x, scale[:, None]))))
+        q8 = q.to(tl.int8)
+        if ALL_PEERS:
+            for peer in tl.static_range(4):
+                base = tl.load(Ptrs + peer)
+                v = (base + VALUES).to(tl.pointer_type(tl.int8))
+                s = (base + SCALES).to(tl.pointer_type(tl.float32))
+                tl.store(v + RANK * PART + b[:, None] * BLOCK + lane[None, :], q8,
+                         mask=live[:, None])
+                tl.store(s + RANK * part_blocks + b, scale, mask=live)
+        else:
+            owner = b // part_blocks
+            local = b - owner * part_blocks
+            base = tl.load(Ptrs + owner, mask=live, other=0)
+            v = (base + VALUES).to(tl.pointer_type(tl.int8))
+            s = (base + SCALES).to(tl.pointer_type(tl.float32))
+            tl.store(v[:, None] + (RANK * PART + local[:, None] * BLOCK + lane[None, :]),
+                     q8, mask=live[:, None])
+            tl.store(s + (RANK * part_blocks + local), scale, mask=live)
+    _fence_sys(pid)
+
+
+@triton.jit
+def _barrier(Ptrs, RANK: tl.constexpr, PHASE: tl.constexpr):
+    """Publish this rank's next epoch for PHASE to every rank, then wait.
+
+    The own slot doubles as the counter (only this rank writes it). Flags are
+    monotonic, so no reset is ever needed and a fast rank's next epoch still
+    satisfies a slow rank's wait.
+    """
+    mine = tl.load(Ptrs + RANK)
+    own = (mine + (PHASE * 4 + RANK) * 8).to(tl.pointer_type(tl.uint64))
+    previous = tl.inline_asm_elementwise(
+        "ld.global.acquire.sys.u64 $0, [$1];", constraints="=l,l",
+        args=[own], dtype=tl.uint64, is_pure=False, pack=1)
+    epoch = previous + 1
+    for peer in tl.static_range(4):
+        slot = (tl.load(Ptrs + peer) + (PHASE * 4 + RANK) * 8).to(tl.pointer_type(tl.uint64))
+        tl.inline_asm_elementwise(
+            "st.global.release.sys.u64 [$1], $2; mov.u32 $0, 0;",
+            constraints="=r,l,l", args=[slot, epoch], dtype=tl.uint32,
+            is_pure=False, pack=1)
+    for peer in tl.static_range(4):
+        flag = (mine + (PHASE * 4 + peer) * 8).to(tl.pointer_type(tl.uint64))
+        seen = tl.inline_asm_elementwise(
+            "ld.global.acquire.sys.u64 $0, [$1];", constraints="=l,l",
+            args=[flag], dtype=tl.uint64, is_pure=False, pack=1)
+        while seen < epoch:
+            seen = tl.inline_asm_elementwise(
+                "ld.global.acquire.sys.u64 $0, [$1];", constraints="=l,l",
+                args=[flag], dtype=tl.uint64, is_pure=False, pack=1)
+
+
+@triton.jit
+def _reduce_push(Ptrs, RANK: tl.constexpr, SHARD,
+                 RS_VALUES: tl.constexpr, RS_SCALES: tl.constexpr,
+                 AG_VALUES: tl.constexpr, AG_SCALES: tl.constexpr,
+                 BLOCK: tl.constexpr, GROUP: tl.constexpr):
+    """Sum the four local copies of this rank's quarter in rank order 0..3,
+    requantize, and write the result into every rank's gather slot RANK."""
+    pid = tl.program_id(0)
+    nprog = tl.num_programs(0)
+    shard_blocks = SHARD // BLOCK
+    tiles = tl.cdiv(shard_blocks, GROUP)
+    g = tl.arange(0, GROUP)
+    lane = tl.arange(0, BLOCK)
+    mine = tl.load(Ptrs + RANK)
+    rs_v = (mine + RS_VALUES).to(tl.pointer_type(tl.int8))
+    rs_s = (mine + RS_SCALES).to(tl.pointer_type(tl.float32))
+    for tile in range(pid, tiles, nprog):
+        b = tile * GROUP + g
+        live = b < shard_blocks
+        total = tl.zeros((GROUP, BLOCK), dtype=tl.float32)
+        for source in tl.static_range(4):
+            q = tl.load(rs_v + source * SHARD + b[:, None] * BLOCK + lane[None, :],
+                        mask=live[:, None], other=0, cache_modifier=".cg").to(tl.float32)
+            s = tl.load(rs_s + source * shard_blocks + b, mask=live, other=0.0,
+                        cache_modifier=".cg")
+            total = total + q * s[:, None]
+        scale = tl.maximum(tl.div_rn(tl.max(tl.abs(total), 1), 127.0), 1.0e-30)
+        q2 = tl.minimum(127, tl.maximum(-127, _rint(tl.div_rn(total, scale[:, None]))))
+        q8 = q2.to(tl.int8)
+        for peer in tl.static_range(4):
+            base = tl.load(Ptrs + peer)
+            v = (base + AG_VALUES).to(tl.pointer_type(tl.int8))
+            s2 = (base + AG_SCALES).to(tl.pointer_type(tl.float32))
+            tl.store(v + RANK * SHARD + b[:, None] * BLOCK + lane[None, :], q8,
+                     mask=live[:, None])
+            tl.store(s2 + RANK * shard_blocks + b, scale, mask=live)
+    _fence_sys(pid)
+
+
+@triton.jit
+def _gather_local(Ptrs, Out, RANK: tl.constexpr, PART,
+                  AG_VALUES: tl.constexpr, AG_SCALES: tl.constexpr,
+                  BLOCK: tl.constexpr, GROUP: tl.constexpr):
+    """Dequantize the four local gather slots (PART values each) into Out.
+
+    Reads local memory only (peers wrote it); .cg bypasses the incoherent L1.
+    """
+    pid = tl.program_id(0)
+    nprog = tl.num_programs(0)
+    part_blocks = PART // BLOCK
+    blocks = part_blocks * 4
+    tiles = tl.cdiv(blocks, GROUP)
+    g = tl.arange(0, GROUP)
+    lane = tl.arange(0, BLOCK)
+    mine = tl.load(Ptrs + RANK)
+    ag_v = (mine + AG_VALUES).to(tl.pointer_type(tl.int8))
+    ag_s = (mine + AG_SCALES).to(tl.pointer_type(tl.float32))
+    for tile in range(pid, tiles, nprog):
+        b = tile * GROUP + g
+        live = b < blocks
+        source = b // part_blocks
+        local = b - source * part_blocks
+        q = tl.load(ag_v + (source * PART + local * BLOCK)[:, None] + lane[None, :],
+                    mask=live[:, None], other=0, cache_modifier=".cg").to(tl.float32)
+        s = tl.load(ag_s + source * part_blocks + local, mask=live, other=0.0,
+                    cache_modifier=".cg")
+        y = q * s[:, None]
+        tl.store(Out + b[:, None] * BLOCK + lane[None, :], y.to(tl.bfloat16),
+                 mask=live[:, None])
+
+
+@triton.jit
+def _zero_header(Ptrs, RANK: tl.constexpr, WORDS: tl.constexpr):
+    mine = tl.load(Ptrs + RANK)
+    p = mine.to(tl.pointer_type(tl.uint64))
+    i = tl.arange(0, WORDS)
+    tl.store(p + i, tl.zeros((WORDS,), dtype=tl.uint64))
+
+
+class DSV41Int8PrefillComm:
+    """Opt-in compressed prefill collectives for TP4 on one SM80 node."""
+
+    def __init__(self, group, device, settings: Settings):
+        if dist.get_world_size(group) != WORLD:
+            raise ValueError("INT8 prefill collectives require TP4")
+        if not all(in_the_same_node_as(group, source_rank=0)):
+            raise ValueError("INT8 prefill collectives require a single node")
+        self.rank = dist.get_rank(group)
+        self.group = group
+        self.device = torch.device(device)
+        self.settings = settings
+        self.layout = make_layout(settings)
+        supported = torch.cuda.get_device_capability(self.device) == (8, 0)
+        supported = supported and all(
+            peer == self.device.index
+            or torch.cuda.can_device_access_peer(self.device.index, peer)
+            for peer in range(torch.cuda.device_count())
+        )
+        # Agree before allocating: a local-only refusal would strand the peers.
+        votes = [None] * WORLD
+        dist.all_gather_object(votes, (supported, settings), group=group)
+        if not all(v[0] for v in votes):
+            raise ValueError("INT8 prefill collectives need SM80 and full peer access")
+        if any(v[1] != settings for v in votes):
+            raise ValueError("ranks disagree on INT8 prefill settings")
+        self.pointers = CustomAllreduce.create_shared_buffer(self.layout.total_bytes, group)
+        self.ptrs = torch.tensor(self.pointers, device=self.device, dtype=torch.uint64)
+        with torch.cuda.device(self.device):
+            _zero_header[(1,)](self.ptrs, self.rank, HEADER_BYTES // 8, num_warps=1)
+        torch.cuda.synchronize(self.device)
+        dist.barrier(group=group)
+        self.group_blocks = TILE // self.layout.block
+        self.num_sms = torch.cuda.get_device_properties(self.device).multi_processor_count
+        self.closed = False
+        self._rotated = None
+        if settings.schedule == SCHEDULE_ROTATED:
+            from .dsv41_int8_prefill_rotated import RotatedSchedule
+
+            self._rotated = RotatedSchedule(self)
+
+    # Dispatch predicates (identical inputs on every TP rank -> same choice).
+    def supports_all_reduce(self, x: torch.Tensor) -> bool:
+        return ar_eligible(self.settings, tuple(x.shape), str(x.dtype), x.is_contiguous(),
+                           x.is_cuda, torch.cuda.is_current_stream_capturing())
+
+    def supports_all_gather(self, x: torch.Tensor, dim: int) -> bool:
+        return ag_eligible(self.settings, self.layout, tuple(x.shape), dim, str(x.dtype),
+                           x.is_contiguous(), x.is_cuda,
+                           torch.cuda.is_current_stream_capturing())
+
+    def _grid(self, blocks: int) -> tuple[int]:
+        # Remote writers: a few CTAs saturate a x4 link and leave SMs free for
+        # overlapped compute.
+        tiles = -(-blocks // self.group_blocks)
+        return (max(1, min(tiles, self.settings.ctas)),)
+
+    def _local_grid(self, blocks: int) -> tuple[int]:
+        tiles = -(-blocks // self.group_blocks)
+        return (max(1, min(tiles, 4 * self.num_sms)),)
+
+    def all_reduce(self, x: torch.Tensor) -> torch.Tensor:
+        assert self.supports_all_reduce(x)
+        if self._rotated is not None:
+            return self._rotated.all_reduce(x)
+        lay = self.layout
+        numel = x.numel()
+        shard = numel // WORLD
+        block = lay.block
+        out = torch.empty_like(x)
+        _quant_push[self._grid(numel // block)](
+            x, self.ptrs, self.rank, numel, shard, lay.rs_values, lay.rs_scales,
+            block, self.group_blocks, False, num_warps=4, enable_fp_fusion=False)
+        _barrier[(1,)](self.ptrs, self.rank, PHASE_RS, num_warps=1)
+        _reduce_push[self._grid(shard // block)](
+            self.ptrs, self.rank, shard, lay.rs_values, lay.rs_scales,
+            lay.ag_values, lay.ag_scales, block, self.group_blocks,
+            num_warps=4, enable_fp_fusion=False)
+        _barrier[(1,)](self.ptrs, self.rank, PHASE_AG, num_warps=1)
+        # Local-only pass: no PCIe traffic, so it may use every SM.
+        _gather_local[self._local_grid(numel // block)](
+            self.ptrs, out, self.rank, shard, lay.ag_values, lay.ag_scales,
+            block, self.group_blocks, num_warps=4, enable_fp_fusion=False)
+        return out
+
+    def all_gather_stacked(self, x: torch.Tensor) -> torch.Tensor:
+        """Return [WORLD * x.shape[0], *x.shape[1:]], rank r's data at block r.
+
+        Same layout as PyNCCL's all_gather output; the caller applies the
+        existing movedim/reshape for dim != 0. Every slot, including this
+        rank's own, is the dequantized copy, so all ranks see identical bits.
+        """
+        assert x.is_contiguous() and x.numel() <= self.layout.slot
+        if self._rotated is not None:
+            return self._rotated.all_gather_stacked(x)
+        lay = self.layout
+        numel = x.numel()
+        block = lay.block
+        out = x.new_empty((WORLD * x.shape[0], *x.shape[1:]))
+        # Pre-barrier: every rank has finished reading its gather inbox.
+        _barrier[(1,)](self.ptrs, self.rank, PHASE_FREE, num_warps=1)
+        _quant_push[self._grid(numel // block)](
+            x, self.ptrs, self.rank, numel, numel, lay.ag_values, lay.ag_scales,
+            block, self.group_blocks, True, num_warps=4, enable_fp_fusion=False)
+        _barrier[(1,)](self.ptrs, self.rank, PHASE_AG, num_warps=1)
+        _gather_local[self._local_grid(WORLD * numel // block)](
+            self.ptrs, out, self.rank, numel, lay.ag_values, lay.ag_scales,
+            block, self.group_blocks, num_warps=4, enable_fp_fusion=False)
+        return out
+
+    def destroy(self):
+        if not self.closed:
+            torch.cuda.synchronize(self.device)
+            dist.barrier(group=self.group)
+            CustomAllreduce.free_shared_buffer(self.pointers, rank=self.rank)
+            self.closed = True
