@@ -0,0 +1,265 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Rotated one-peer-per-step schedule for the INT8 prefill collectives (0034).
+
+Selected by ``VLLM_DSV41_INT8_PREFILL_SCHEDULE=rotated`` on top of 0032's
+``DSV41Int8PrefillComm``; dispatch, eligibility (rows >= min_rows > 48, never
+in capture or exact scope, BF16 [rows, 5120] or the Engram all-gather shapes)
+and the cross-rank settings check are 0032's, unchanged.
+
+Why: on opera (PCIe 2.0 x4, one GPU per Zen 1 die) 0032's push two-shot sent
+half of NCCL's bytes in the same time. Each shot wrote to three peers at once,
+through base addresses loaded from a pointer table (unknown alignment, so
+byte-wide peer stores). This schedule changes only how the bytes travel:
+
+* reduce-scatter: step k = 1, 2, 3 quantizes the quarter owned by rank
+  (r + k) % 4 straight into that rank's inbox slot r; the own quarter is
+  written locally last. Across ranks each step is a permutation, so every
+  GPU sends to one peer and receives from one peer at a time.
+* the owner sums its four slots in FP32 in rank order 0..3, requantizes once
+  into its own gather slot, then copies that slot to (r + 1), (r + 2), (r + 3)
+  one at a time; every rank dequantizes the same bytes.
+* peer addresses are passed to Triton as typed pointer arguments (``_Raw``),
+  which Triton specializes on 16-byte alignment: peer stores compile to
+  16-byte vector stores.
+
+Numerics are 0032's bit for bit (same blocks, same scale and rounding, same
+sum order): the GPU gate checks rotated == two_shot on every case. Wire bytes
+per rank are 0032's, about half the BF16 ring. Synchronization is 0032's two
+device barriers per call (monotonic epochs, no host sync), so the inbox reuse
+argument carries over: a rank writes call n+1's reduce-scatter slots only after
+everyone passed call n's gather barrier (all reduces done), and call n+1's
+gather slots only after everyone passed call n+1's reduce-scatter barrier (all
+call-n gathers done, by stream order).
+"""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+from .dsv41_int8_prefill import _barrier, _fence_sys, _rint
+from .dsv41_int8_prefill_policy import (
+    PHASE_AG,
+    PHASE_FREE,
+    PHASE_RS,
+    WORLD,
+    copy_bytes,
+    rotated_steps,
+)
+
+TILE = 2048  # values per CTA iteration in the codec kernels (as 0032)
+COPY_CHUNK = 4096  # bytes per CTA iteration in the slot copy
+
+
+class _Raw:
+    """A raw device address passed to Triton as a typed pointer argument.
+
+    Triton treats any object with ``data_ptr()`` and ``dtype`` as a pointer and
+    specializes it on 16-byte alignment, so contiguous accesses through it
+    vectorize. A base loaded from a pointer table inside the kernel (0032) has
+    unknown alignment and compiles to element-wide accesses.
+    """
+
+    __slots__ = ("_ptr", "dtype")
+
+    def __init__(self, ptr: int, dtype: torch.dtype):
+        self._ptr = int(ptr)
+        self.dtype = dtype
+
+    def data_ptr(self) -> int:
+        return self._ptr
+
+
+@triton.jit
+def _quant_store(X, DstV, DstS, NBLK, BLOCK: tl.constexpr, GROUP: tl.constexpr,
+                 REMOTE: tl.constexpr):
+    """Quantize NBLK blocks of X into DstV (int8) and DstS (FP32 scales).
+
+    Same arithmetic as 0032's _quant_push: symmetric INT8 [-127, 127], scale =
+    max(absmax / 127, 1e-30), round to nearest even.
+    """
+    pid = tl.program_id(0)
+    nprog = tl.num_programs(0)
+    tiles = tl.cdiv(NBLK, GROUP)
+    g = tl.arange(0, GROUP)
+    lane = tl.arange(0, BLOCK)
+    for tile in range(pid, tiles, nprog):
+        b = tile * GROUP + g
+        live = b < NBLK
+        offs = b[:, None] * BLOCK + lane[None, :]
+        x = tl.load(X + offs, mask=live[:, None], other=0.0).to(tl.float32)
+        scale = tl.maximum(tl.div_rn(tl.max(tl.abs(x), 1), 127.0), 1.0e-30)
+        q = tl.minimum(127, tl.maximum(-127, _rint(tl.div_rn(x, scale[:, None]))))
+        tl.store(DstV + offs, q.to(tl.int8), mask=live[:, None])
+        tl.store(DstS + b, scale, mask=live)
+    if REMOTE:
+        _fence_sys(pid)
+
+
+@triton.jit
+def _reduce_requant(RsV, RsS, STRIDE_V, STRIDE_S, AgV, AgS, NBLK,
+                    BLOCK: tl.constexpr, GROUP: tl.constexpr):
+    """Sum the four local reduce-scatter slots in rank order 0..3 (FP32),
+    requantize, and write the result into this rank's own gather slot.
+
+    Local only. Same expression order as 0032's _reduce_push.
+    """
+    pid = tl.program_id(0)
+    nprog = tl.num_programs(0)
+    tiles = tl.cdiv(NBLK, GROUP)
+    g = tl.arange(0, GROUP)
+    lane = tl.arange(0, BLOCK)
+    for tile in range(pid, tiles, nprog):
+        b = tile * GROUP + g
+        live = b < NBLK
+        offs = b[:, None] * BLOCK + lane[None, :]
+        total = tl.zeros((GROUP, BLOCK), dtype=tl.float32)
+        for source in tl.static_range(4):
+            q = tl.load(RsV + source * STRIDE_V + offs, mask=live[:, None], other=0,
+                        cache_modifier=".cg").to(tl.float32)
+            s = tl.load(RsS + source * STRIDE_S + b, mask=live, other=0.0,
+                        cache_modifier=".cg")
+            total = total + q * s[:, None]
+        scale = tl.maximum(tl.div_rn(tl.max(tl.abs(total), 1), 127.0), 1.0e-30)
+        q2 = tl.minimum(127, tl.maximum(-127, _rint(tl.div_rn(total, scale[:, None]))))
+        tl.store(AgV + offs, q2.to(tl.int8), mask=live[:, None])
+        tl.store(AgS + b, scale, mask=live)
+
+
+@triton.jit
+def _copy_slot(Src, Dst, NBYTES, CHUNK: tl.constexpr):
+    """Copy NBYTES (a multiple of 16) from a local slot into a peer slot."""
+    pid = tl.program_id(0)
+    nprog = tl.num_programs(0)
+    o = tl.arange(0, CHUNK)
+    for t in range(pid, tl.cdiv(NBYTES, CHUNK), nprog):
+        offs = t * CHUNK + o
+        m = offs < NBYTES
+        v = tl.load(Src + offs, mask=m, other=0, cache_modifier=".cg")
+        tl.store(Dst + offs, v, mask=m)
+    _fence_sys(pid)
+
+
+@triton.jit
+def _gather(AgV, AgS, STRIDE_V, STRIDE_S, Out, PART, BLOCK: tl.constexpr,
+            GROUP: tl.constexpr):
+    """Dequantize the four local gather slots (PART values each) into Out.
+
+    Local reads only; .cg bypasses the incoherent L1 (peers wrote the data).
+    """
+    pid = tl.program_id(0)
+    nprog = tl.num_programs(0)
+    part_blocks = PART // BLOCK
+    blocks = part_blocks * 4
+    tiles = tl.cdiv(blocks, GROUP)
+    g = tl.arange(0, GROUP)
+    lane = tl.arange(0, BLOCK)
+    for tile in range(pid, tiles, nprog):
+        b = tile * GROUP + g
+        live = b < blocks
+        source = b // part_blocks
+        local = b - source * part_blocks
+        q = tl.load(AgV + (source * STRIDE_V + local * BLOCK)[:, None] + lane[None, :],
+                    mask=live[:, None], other=0, cache_modifier=".cg").to(tl.float32)
+        s = tl.load(AgS + source * STRIDE_S + local, mask=live, other=0.0,
+                    cache_modifier=".cg")
+        y = q * s[:, None]
+        tl.store(Out + b[:, None] * BLOCK + lane[None, :], y.to(tl.bfloat16),
+                 mask=live[:, None])
