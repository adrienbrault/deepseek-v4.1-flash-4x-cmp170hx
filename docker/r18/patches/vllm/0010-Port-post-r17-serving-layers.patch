@@ -0,0 +1,283 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Pure-Python policy for the opt-in DSV4.1 TP4 INT8 prefill collectives.
+
+No torch import: flag parsing, buffer layout and dispatch predicates are
+unit-tested without CUDA. The kernels live in ``dsv41_int8_prefill.py``.
+
+Decode safety: every predicate requires at least ``min_rows`` rows and
+``min_rows`` is forced above 48, the largest decode/verify message (8 seqs x
+6 DSpark rows) and the FlashInfer true-ring ceiling. Rows <= 48 can never take
+this path, so decode collectives keep their existing backend byte for byte.
+
+Schedules (``VLLM_DSV41_INT8_PREFILL_SCHEDULE``):
+
+* ``two_shot`` (default, patch 0032): every rank pushes to all three peers at
+  once in each shot.
+* ``rotated`` (patch 0034): the same two-shot numerics (one quantization per
+  input, FP32 sum in rank order 0..3, one requantization, every rank
+  dequantizes the same bytes), but each rank writes to one peer per step:
+  step k (1..3) sends to rank (r + k) % 4 and receives from (r - k) % 4, in
+  the reduce-scatter and again in the all-gather. Same bytes on the wire,
+  bit-identical results to ``two_shot``.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import threading
+from dataclasses import dataclass
+
+WIDTH = 5120
+WORLD = 4
+DECODE_MAX_ROWS = 48
+ALIGN = 256
+HEADER_BYTES = 512
+PHASES = 3  # 0: free (all-gather pre-barrier), 1: reduce-scatter ready, 2: gather ready
+PHASE_FREE, PHASE_RS, PHASE_AG = 0, 1, 2
+
+ENV_AR = "VLLM_DSV41_INT8_PREFILL_AR"
+ENV_AG = "VLLM_DSV41_INT8_PREFILL_AG"
+ENV_MIN_ROWS = "VLLM_DSV41_INT8_PREFILL_MIN_ROWS"
+ENV_MAX_ROWS = "VLLM_DSV41_INT8_PREFILL_MAX_ROWS"
+ENV_BLOCK = "VLLM_DSV41_INT8_PREFILL_BLOCK"
+ENV_CTAS = "VLLM_DSV41_INT8_PREFILL_CTAS"
+ENV_SCHEDULE = "VLLM_DSV41_INT8_PREFILL_SCHEDULE"
+
+DEFAULT_MIN_ROWS = 64
+DEFAULT_MAX_ROWS = 2048
+DEFAULT_BLOCK = 64
+DEFAULT_CTAS = 16
+BLOCKS = (64, 128, 256)
+SCHEDULE_TWO_SHOT = "two_shot"
+SCHEDULE_ROTATED = "rotated"
+SCHEDULES = (SCHEDULE_TWO_SHOT, SCHEDULE_ROTATED)
+PAYLOAD_ALIGN = 16  # rotated: copies are rounded up to whole 16-byte vectors
+
+# Engram all-gathers (per-rank shapes, trailing dims) are the only all-gathers
+# this path may compress: head rows [T, 6, 256] gathered on dim 1 and the
+# wkv ColumnParallel output [T, 6400] gathered on the last dim. Everything else
+# (logits, prompt logprobs, metadata) keeps the exact NCCL gather.
+ENGRAM_AG_TRAILING = ((6, 256), (6400,))
+ENGRAM_AG_MAX_SLOT = 6400  # widest allow-listed per-row width
+
+
+@dataclass(frozen=True)
+class Settings:
+    all_reduce: bool
+    all_gather: bool
+    min_rows: int
+    max_rows: int
+    block: int
+    ctas: int
+    schedule: str = SCHEDULE_TWO_SHOT
+
+
+@dataclass(frozen=True)
+class Layout:
+    block: int
+    ar_numel: int  # largest all-reduce message (elements)
+    ar_shard: int  # its per-rank quarter
+    slot: int  # all-gather slot capacity (elements per source rank)
+    rs_values: int
+    rs_scales: int
+    ag_values: int
+    ag_scales: int
+    total_bytes: int
+    # rotated schedule only: fixed slot strides (bytes). A slot holds one
+    # message's int8 values followed by its FP32 scales; 0 for two_shot.
+    rs_stride: int = 0
+    ag_stride: int = 0
+
+    def flag_offset(self, phase: int, source: int) -> int:
+        return (phase * WORLD + source) * 8
+
+
+def _flag(environ, name: str) -> bool:
+    value = environ.get(name, "0")
+    if value not in ("0", "1"):
+        raise ValueError(f"{name} must be 0 or 1, got {value!r}")
+    return value == "1"
+
+
+def _int(environ, name: str, default: int) -> int:
+    raw = environ.get(name)
+    if raw is None or raw == "":
+        return default
+    if not raw.isdigit():
+        raise ValueError(f"{name} must be a positive integer, got {raw!r}")
+    return int(raw)
+
+
+def parse_settings(environ, max_num_batched_tokens: int | None = None) -> Settings | None:
+    """Return the settings, or None when both switches are off.
+
+    Invalid values raise: a silent fallback would leave ranks disagreeing on
+    whether the path is armed only if the environment differed between them,
+    and a typo in an opt-in numerics change should stop the boot.
+    """
+    ar = _flag(environ, ENV_AR)
+    ag = _flag(environ, ENV_AG)
+    schedule = environ.get(ENV_SCHEDULE) or SCHEDULE_TWO_SHOT
+    if schedule not in SCHEDULES:
+        raise ValueError(f"{ENV_SCHEDULE} must be one of {SCHEDULES}, got {schedule!r}")
+    if not (ar or ag):
+        if schedule != SCHEDULE_TWO_SHOT:
+            # A schedule with no armed collective is a silent no-op: refuse it.
+            raise ValueError(f"{ENV_SCHEDULE}={schedule} needs {ENV_AR}=1 or {ENV_AG}=1")
+        return None
+    default_max = max_num_batched_tokens or DEFAULT_MAX_ROWS
+    max_rows = _int(environ, ENV_MAX_ROWS, default_max)
+    min_rows = _int(environ, ENV_MIN_ROWS, DEFAULT_MIN_ROWS)
+    block = _int(environ, ENV_BLOCK, DEFAULT_BLOCK)
+    ctas = _int(environ, ENV_CTAS, DEFAULT_CTAS)
+    if min_rows <= DECODE_MAX_ROWS:
+        raise ValueError(
+            f"{ENV_MIN_ROWS} must exceed {DECODE_MAX_ROWS} so decode never compresses"
+        )
+    if max_rows < min_rows or max_rows > 65536:
+        raise ValueError(f"{ENV_MAX_ROWS} must be in [{min_rows}, 65536]")
+    if block not in BLOCKS:
+        raise ValueError(f"{ENV_BLOCK} must be one of {BLOCKS}")
+    if not 1 <= ctas <= 1024:
+        raise ValueError(f"{ENV_CTAS} must be in [1, 1024]")
+    return Settings(ar, ag, min_rows, max_rows, block, ctas, schedule)
+
+
+def _align(n: int) -> int:
+    return (n + ALIGN - 1) // ALIGN * ALIGN
+
+
+def payload_bytes(numel: int, block: int) -> int:
+    """Bytes of one quantized message part: int8 values then FP32 scales."""
+    return numel + numel // block * 4
+
+
+def make_layout(settings: Settings) -> Layout:
+    """Peer-visible buffer: header, reduce-scatter inbox, gather inbox.
+
+    Reduce-scatter inbox: WORLD source slots of one quarter message each.
+    Gather inbox: WORLD source slots; a slot holds either an all-reduce quarter
+    (second shot) or one rank's whole all-gather contribution.
+
+    two_shot: values and scales live in separate regions, slots compact per
+    message (patch 0032 layout, unchanged). rotated: each slot is one fixed
+    stride (256-byte aligned) holding [values | scales] for the current
+    message, so a slot's payload is one contiguous copy.
+    """
+    block = settings.block
+    ar_numel = settings.max_rows * WIDTH
+    ar_shard = ar_numel // WORLD
+    slot = ar_shard
+    if settings.all_gather:
+        slot = max(slot, settings.max_rows * ENGRAM_AG_MAX_SLOT)
+    assert ar_shard % block == 0 and slot % block == 0
+    if settings.schedule == SCHEDULE_ROTATED:
+        rs_stride = _align(payload_bytes(ar_shard, block))
+        ag_stride = _align(payload_bytes(slot, block))
+        rs_values = HEADER_BYTES
+        ag_values = _align(rs_values + WORLD * rs_stride)
+        total = _align(ag_values + WORLD * ag_stride)
+        # *_scales carry no meaning here (scales sit inside each slot).
+        return Layout(block, ar_numel, ar_shard, slot, rs_values, rs_values,
+                      ag_values, ag_values, total, rs_stride, ag_stride)
+    rs_values = HEADER_BYTES
+    rs_scales = _align(rs_values + WORLD * ar_shard)
+    ag_values = _align(rs_scales + WORLD * (ar_shard // block) * 4)
+    ag_scales = _align(ag_values + WORLD * slot)
+    total = _align(ag_scales + WORLD * (slot // block) * 4)
+    return Layout(block, ar_numel, ar_shard, slot, rs_values, rs_scales,
+                  ag_values, ag_scales, total)
+
+
+def wire_bytes_per_rank(numel: int, block: int) -> float:
+    """Remote bytes each rank sends for one two-shot all-reduce."""
+    per_quarter = numel / WORLD * (1 + 4 / block)
+    return 2 * (WORLD - 1) * per_quarter
+
+
+def bf16_ring_bytes_per_rank(numel: int) -> float:
+    return 2 * (WORLD - 1) / WORLD * numel * 2
+
+
+def copy_bytes(numel: int, block: int) -> int:
+    """rotated: bytes one slot copy moves (payload rounded up to 16 bytes)."""
+    n = payload_bytes(numel, block)
+    return (n + PAYLOAD_ALIGN - 1) // PAYLOAD_ALIGN * PAYLOAD_ALIGN
+
+
+def rotated_steps(rank: int):
+    """The rotated schedule of one rank, in launch order.
+
+    Returns (phase, step, peer, quarter) tuples: in phase "rs" step k the rank
+    quantizes the quarter owned by peer (rank + k) % 4 into that peer's
+    reduce-scatter slot ``rank``; step 0 is its own quarter, written locally
+    last so the link starts at once. In phase "ag" step k it copies its reduced
+    quarter (``rank``) into peer (rank + k) % 4's gather slot ``rank``.
+    Each step names exactly one peer; across ranks a step is a permutation
+    (rank r receives only from (r - k) % 4), so no link carries two flows.
+    """
+    steps = []
+    for k in (1, 2, 3, 0):
+        peer = (rank + k) % WORLD
+        steps.append(("rs", k, peer, peer))
+    for k in (1, 2, 3):
+        steps.append(("ag", k, (rank + k) % WORLD, rank))
+    return steps
+
+
+# Scoped opt-out used for exact collectives (embedding gather-by-sum, checks).
+_exact = threading.local()
+
+
+@contextlib.contextmanager
+def exact_scope():
+    depth = getattr(_exact, "depth", 0)
+    _exact.depth = depth + 1
+    try:
+        yield
+    finally:
+        _exact.depth = depth
+
+
+def in_exact_scope() -> bool:
+    return getattr(_exact, "depth", 0) > 0
+
+
+def ar_eligible(settings: Settings | None, shape, dtype: str, contiguous: bool,
+                is_cuda: bool, capturing: bool) -> bool:
+    return bool(
+        settings is not None
+        and settings.all_reduce
+        and is_cuda
+        and not capturing
+        and not in_exact_scope()
+        and dtype == "torch.bfloat16"
+        and contiguous
+        and len(shape) == 2
+        and shape[1] == WIDTH
+        and settings.min_rows <= shape[0] <= settings.max_rows
+    )
+
+
+def ag_eligible(settings: Settings | None, layout: Layout | None, shape, dim: int,
+                dtype: str, contiguous: bool, is_cuda: bool, capturing: bool) -> bool:
+    if settings is None or layout is None or not settings.all_gather:
+        return False
+    if not is_cuda or capturing or in_exact_scope() or not contiguous:
+        return False
+    if dtype != "torch.bfloat16" or len(shape) < 2:
+        return False
+    if dim < 0:
+        dim += len(shape)
+    trailing = tuple(shape[1:])
+    if trailing not in ENGRAM_AG_TRAILING:
+        return False
+    if dim != (1 if trailing == (6, 256) else len(shape) - 1):
+        return False
+    rows = shape[0]
+    numel = 1
+    for n in shape:
+        numel *= n
+    return (settings.min_rows <= rows <= settings.max_rows
+            and numel % layout.block == 0 and numel <= layout.slot)
