@@ -0,0 +1,153 @@
+# SPDX-License-Identifier: MIT
+"""Default-off dispatch of the exact CUDA-gated Opera true-ring native asset.
+
+The stock FI package, workspace, tuning and caches are never replaced. Opt-in
+loads a hash-pinned private module containing the same stock kernels plus7;
+only rows6/24/48 override dispatch after a loaded-workspace graph gate.
+"""
+import hashlib
+import importlib.metadata
+import json
+import os
+from pathlib import Path
+from types import SimpleNamespace
+
+ASSETS=Path('/opt/dsv41/opera-true-ring')
+GATED_NATIVE_SHA256='0a69390478b36c6ccacfdae41f371baf891846c717434e389c9fc0b228bada8a'
+GATED_MEASUREMENTS_SHA256='14f3c891c6379232c820c5b8b013ac0184a3a238b897b6d02f5a2518e01894f2'
+_NATIVE_STATE=None
+
+def digest(path):return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+def read_assets(root=ASSETS):
+    root=Path(root);manifest=json.loads((root/'manifest.json').read_text())
+    if manifest['native_library_sha256']!=GATED_NATIVE_SHA256:
+        raise RuntimeError('native manifest does not name the qualified CUDA-gated binary')
+    for rel,expected in manifest['files'].items():
+        if digest(root/rel)!=expected:raise RuntimeError('true-ring asset changed: '+rel)
+    if digest(root/'native.so')!=manifest['native_library_sha256']:
+        raise RuntimeError('true-ring native binary differs from actual CUDA-gated asset')
+    policy=json.loads((root/'policy.json').read_text())
+    if (policy['version'],policy['world_size'],policy['hidden_dim'],policy['dtype'],policy['max_numel'],policy['gate_sha256'])!=(1,4,5120,'torch.bfloat16',245760,GATED_MEASUREMENTS_SHA256):
+        raise RuntimeError('unqualified true-ring policy geometry/gate receipt')
+    if policy['ring_configs']!={'6':{'variant':7,'blocks':2,'threads':256},
+                              '24':{'variant':7,'blocks':8,'threads':256},
+                              '48':{'variant':7,'blocks':8,'threads':256}}:
+        raise RuntimeError('unqualified true-ring configuration table')
+    return manifest,policy
+
+def initialize(*,world_size,hidden_dim,dtype,max_numel,tbo_stream):
+    """Called before the original FI workspace creates its native wrapper."""
+    global _NATIVE_STATE
+    import flashinfer
+    import flashinfer.comm.pcie_ipc_ar as ar
+    import torch
+    import tvm_ffi
+    from vllm.logger import init_logger
+    log=init_logger(__name__)
+    manifest,policy=read_assets()
+    if (world_size!=policy['world_size'] or hidden_dim!=policy['hidden_dim']
+        or str(dtype)!=policy['dtype'] or max_numel!=policy['max_numel']
+        or tbo_stream is not None or os.environ.get('VLLM_DSV41_TBO','0')!='0'):
+        raise RuntimeError('true-ring requires gated TP4/BF16/hidden5120/max48rows and no TBO')
+    if not torch.cuda.is_available() or torch.cuda.get_device_capability()!=(8,0):
+        raise RuntimeError('true-ring requires the gated SM80 CUDA platform')
+    if str(torch.__version__)!=manifest['torch_version']:
+        raise RuntimeError('true-ring Torch/CUDA ABI differs from actual hardware gate')
+    if importlib.metadata.version('flashinfer-python')!='0.7.2':
+        raise RuntimeError('true-ring requires accepted FI0.7.2')
+    fi=Path(flashinfer.__file__).resolve().parent
+    for rel,expected in manifest['stock_fi_sources'].items():
+        if digest(fi/rel)!=expected:raise RuntimeError('stock FI source changed: '+rel)
+    if _NATIVE_STATE is not None:
+        if ar.gen_pcie_ipc_comm_module is not _NATIVE_STATE['factory']:
+            raise RuntimeError('FI native factory changed after true-ring initialization')
+        return
+    if ar.get_pcie_ipc_comm_module.cache_info().currsize:
+        raise RuntimeError('stock FI native wrapper already initialized; refuse live replacement')
+    # Explicit path bypasses FI AOT/JIT provider resolution entirely. Source and
+    # binary are tied to the PASS hardware gate, not a reusable generic URI.
+    native=tvm_ffi.load_module(str(ASSETS/'native.so'))
+    if int(native.opera_ring_variant_count_v1())!=8:
+        raise RuntimeError('loaded true-ring native probe must report count8')
+    factory=lambda:SimpleNamespace(build_and_load=lambda:native)
+    ar.gen_pcie_ipc_comm_module=factory
+    _NATIVE_STATE={'factory':factory,'policy':policy,'manifest':manifest,'native':native}
+    log.info('Opera true-ring native verified: count8, sha256=%s, gate=%s; exact rows6/24/48 only',
+             manifest['native_library_sha256'],policy['gate_sha256'])
+
+
+class RingWorkspace:
+    """Delegate stock lifecycle/stream/tuning; override only three exact shapes."""
+    def __init__(self,base,policy,config_factory):
+        self._base=base;self._policy=policy
+        self._configs={int(n):config_factory(**values) for n,values in policy['ring_configs'].items()}
+    def __getattr__(self,name):return getattr(self._base,name)
+    def all_reduce(self,inp,*,out=None,config=None,enable_pdl=False):
+        if config is None and not enable_pdl and inp.dim()==2 and inp.shape[1]==5120 and str(inp.dtype)=='torch.bfloat16':
+            config=self._configs.get(inp.shape[0])
+        return self._base.all_reduce(inp,out=out,config=config,enable_pdl=enable_pdl)
+
+
+def _workspace_gate(workspace,tune_group):
+    """Small mandatory graph/ordering check on the actual loaded-model workspace."""
+    import threading
+    import torch
+    import torch.distributed as dist
+    from vllm.logger import init_logger
+    # A peer/kernel stall must fail this candidate boot, not wait for a serving
+    # timeout. Parent unit still owns complete container/process-group cleanup.
+    watchdog=threading.Timer(90,lambda:os._exit(75));watchdog.daemon=True;watchdog.start()
+    graph=None;buffers={};rank=dist.get_rank(workspace.group)
+    try:
+        def input_for(n,epoch,r):
+            i=torch.arange(n*5120,device=workspace.device,dtype=torch.int32)
+            return ((i+3*r+7*epoch)%17-8).to(torch.bfloat16).reshape(n,5120)
+        def verify(n,epoch,out):
+            expected=sum(input_for(n,epoch,r).float() for r in range(4)).bfloat16()
+            ok=bool(torch.equal(out,expected));flags=[None]*4
+            dist.all_gather_object(flags,ok,group=tune_group)
+            if not all(flags):raise RuntimeError('true-ring loaded workspace row mismatch')
+        for n in (1,6,24,48):
+            x=input_for(n,0,rank);y=torch.empty_like(x);buffers[n]=(x,y)
+            workspace.all_reduce(x,out=y);torch.cuda.synchronize(workspace.device)
+            verify(n,0,y)
+        dist.barrier(group=tune_group);torch.cuda.synchronize(workspace.device);workspace.rebind_stream()
+        graph=torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            # Odd21-call chain switches stock/ring and payload geometry on the
+            # same underlying scratch. Main inference capture remains separate.
+            for i in range(21):
+                n=(1,6,24,48)[i%4];x,y=buffers[n];workspace.all_reduce(x,out=y)
+        torch.cuda.synchronize(workspace.device);workspace.rebind_stream()
+        for epoch in range(1,6):
+            for n,(x,y) in buffers.items():x.copy_(input_for(n,epoch,rank));y.fill_(float('nan'))
+            dist.barrier(group=tune_group);graph.replay();torch.cuda.synchronize(workspace.device)
+            for n,(_,y) in buffers.items():verify(n,epoch,y)
+        init_logger(__name__).info('Opera true-ring loaded-workspace gate PASS: eager4, graph105calls, rows1/6/24/48')
+    except BaseException:
+        import traceback
+        traceback.print_exc()
+        os._exit(76)
+    else:
+        # Normal success occurs after all ranks completed their work;
+        # the watchdog hard-exits on a native stall. Never destroy shared slabs
+        # from this helper; ownership remains with the original vLLM wrapper.
+        if graph is not None:del graph
+        buffers.clear()
+        workspace.rebind_stream()
+        watchdog.cancel()
+
+
+def install(base,*,tune_group):
+    import torch.distributed as dist
+    from flashinfer.comm.pcie_ipc_policy import IpcLaunchConfig
+    if _NATIVE_STATE is None:raise RuntimeError('true-ring native was not initialized')
+    # Agree before entering the new collective sequence. All workers launched
+    # from one container must carry the same explicit environment switch.
+    stamp={'policy':_NATIVE_STATE['policy'],'binary':_NATIVE_STATE['manifest']['native_library_sha256']}
+    stamps=[None]*4;dist.all_gather_object(stamps,stamp,group=tune_group)
+    if any(x!=stamp for x in stamps):raise RuntimeError('ranks disagree on true-ring policy/binary')
+    proxy=RingWorkspace(base,_NATIVE_STATE['policy'],IpcLaunchConfig)
+    _workspace_gate(proxy,tune_group)
+    return proxy
