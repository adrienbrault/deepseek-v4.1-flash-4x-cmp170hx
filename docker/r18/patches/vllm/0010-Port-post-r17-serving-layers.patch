+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""DSV41 host-side adaptive DSpark verify width (opera adaptive-verify-r1).
+
+``VLLM_DSV41_ADAPTIVE_VERIFY_POLICY=<policy JSON>`` makes the scheduler pick,
+for every decode step, one verify width K (drafts verified per request) from
+the running requests' recent draft acceptance and a measured step-cost table.
+Empty or unset: off, and the scheduler runs exactly as before.
+
+Adapted from Morrowmake's ``adaptive_k`` acceptance rule
+(github.com/Morrowmake/vllm-cmp170hx @ a0c57b52,
+``vllm/sm80/spec_decode/adaptive_k.py``, Apache-2.0) and the truncation
+point of its DSpark ``host_width`` layer
+(``vllm/sm80/spec_decode/dspark_host_width.py``). Morrowmake's per-request
+device row mask is not ported (see the round's MORROWMAKE.md).
+
+What it does and does not change:
+
+* The drafter still drafts its full block (``num_spec_tokens_to_schedule`` is
+  untouched), so K can climb back on the next step.
+* At the start of ``Scheduler.schedule`` each running decode request's
+  placeholder draft list is truncated (rebound, never mutated: the async
+  scheduler shares one placeholder list) to K. Every downstream size follows
+  from that list: scheduled tokens ``1 + K``, KV slots, the worker's verify
+  rows, ``update_draft_token_ids_in_output``'s trim of the arriving drafts and
+  the rejection count. Verifying a prefix of the drafts is ordinary
+  speculative decoding: the target distribution is unchanged.
+* The step stays a uniform decode batch (every request ``1 + K`` rows), so it
+  replays a FULL CUDA graph if ``b * (K + 1)`` is captured for query length
+  ``K + 1`` (``capture_query_lens`` adds those query lengths).
+
+The rule (per decode step of ``b`` running requests, none prefilling,
+``b >= min_batch``)::
+
+    p_r      = (s_r + strength * prior) / (s_r + f_r + strength)
+    E(p, k)  = (1 - p^(k+1)) / (1 - p)        tokens a step commits, bonus incl.
+    K        = argmax_{k in k_choices, k <= cap} sum_r E(p_r, k) / T(b, k)
+
+``s_r`` / ``f_r`` are request r's decayed counts of accepted drafts and of
+rejections (one per verify round that did not accept every draft): a
+geometric model of per-draft acceptance, which needs no censoring correction
+when K < max. ``T(b, k)`` is the policy's step time (ms), linearly
+interpolated between listed batch sizes. Ties go to the larger k; the step
+keeps the previous K unless the best k beats it by ``hysteresis``.
+Steps with a prefilling request take ``mixed_step_k``; below ``min_batch``
+nothing is truncated.
+
+Calibration (``VLLM_DSV41_ADAPTIVE_VERIFY_FORCE_FILE=<path>``): the file is
+checked on every step (one ``stat``; re-read when it changes). A value in
+``k_choices`` forces that width on every step, anything else means policy
+mode. Each step then rewrites ``<path>.status`` atomically: the step sequence,
+the forced value, the sequence at which it took effect, and cumulative step
+counts by the width actually applied, so a client can wait for an
+acknowledged width and check that a scored interval ran only at that width.
+"""
+
+from __future__ import annotations
+
+import json
+import math
+import os
+from collections import Counter, OrderedDict
+from dataclasses import dataclass, field
+from functools import cache
+from pathlib import Path
+from typing import Any
+
+SCHEMA = "dsv41-adaptive-verify/1"
+ENV_POLICY = "VLLM_DSV41_ADAPTIVE_VERIFY_POLICY"
+ENV_FORCE_FILE = "VLLM_DSV41_ADAPTIVE_VERIFY_FORCE_FILE"
+# Placeholder-padded outputs remembered at most (outputs never processed,
+# e.g. dropped at shutdown, must not grow the map without bound).
+MAX_PADDED_OUTPUTS = 64
+
+_KEYS = frozenset(
+    {
+        "schema",
+        "max_k",
+        "k_choices",
+        "min_batch",
+        "mixed_step_k",
+        "prior",
+        "decay",
+        "strength",
+        "hysteresis",
+        "costs_ms",
+        "log_interval",
+        "source",
+    }
+)
+
+
+def _logger():
+    try:
+        from vllm.logger import init_logger
+
+        return init_logger(__name__)
+    except Exception:  # pragma: no cover - CPU tests without vLLM
+        import logging
+
+        return logging.getLogger(__name__)
+
+
+# ------------------------------------------------------------------ policy
+
+
+@dataclass(frozen=True)
+class Policy:
+    max_k: int
+    # Ascending, every value in 1..max_k, max_k included.
+    k_choices: tuple[int, ...]
+    min_batch: int
+    mixed_step_k: int
+    prior: float
+    decay: float
+    strength: float
+    hysteresis: float
+    # cost[b][k] (ms) for b = 1 .. max_batch, k in k_choices (index 0 unused).
+    cost: tuple[dict[int, float], ...]
+    log_interval: int = 0
+
+    @property
+    def max_batch(self) -> int:
+        return len(self.cost) - 1
+
+    def step_ms(self, b: int, k: int) -> float:
+        row = self.cost[min(max(b, 1), self.max_batch)]
+        return row[k]
+
+
+def _num(path: Any, what: str, value: Any) -> float:
+    if isinstance(value, bool):
+        raise ValueError(f"{path}: {what} must be a number, got {value!r}")
+    try:
+        v = float(value)
+    except (TypeError, ValueError):
+        raise ValueError(f"{path}: {what} must be a number, got {value!r}") from None
+    if not math.isfinite(v):
+        raise ValueError(f"{path}: {what} is not finite: {value!r}")
+    return v
+
+
+def _int(path: Any, what: str, value: Any) -> int:
+    if not isinstance(value, int) or isinstance(value, bool):
+        raise ValueError(f"{path}: {what} must be an integer, got {value!r}")
+    return value
+
+
+def parse_policy(
+    raw: Any, max_num_seqs: int, num_spec_tokens: int, path: Any = "policy"
+) -> Policy:
+    """Check a ``dsv41-adaptive-verify/1`` mapping (ValueError when malformed or
+    not matching the engine's ``num_spec_tokens`` / ``max_num_seqs``)."""
+    if not isinstance(raw, dict):
+        raise ValueError(f"{path}: the policy must be a JSON object")
+    if raw.get("schema") != SCHEMA:
+        raise ValueError(
+            f"{path}: schema must be {SCHEMA!r}, got {raw.get('schema')!r}"
+        )
+    unknown = set(raw) - _KEYS
+    if unknown:
+        raise ValueError(f"{path}: unknown keys {sorted(unknown)}")
+    max_k = _int(path, "max_k", raw.get("max_k"))
+    if max_k != num_spec_tokens:
+        raise ValueError(
+            f"{path}: max_k {max_k} must equal num_speculative_tokens {num_spec_tokens}"
+        )
+    choices = raw.get("k_choices")
+    if (
+        not isinstance(choices, list)
+        or not choices
+        or any(not isinstance(k, int) or isinstance(k, bool) for k in choices)
+        or len(set(choices)) != len(choices)
+        or any(not 1 <= k <= max_k for k in choices)
+    ):
+        raise ValueError(f"{path}: k_choices must be distinct integers in 1..{max_k}")
+    k_choices = tuple(sorted(choices))
+    if k_choices[-1] != max_k:
+        raise ValueError(f"{path}: k_choices must include max_k {max_k}")
+    min_batch = _int(path, "min_batch", raw.get("min_batch", 2))
+    if min_batch < 1:
+        raise ValueError(f"{path}: min_batch must be >= 1")
+    mixed = _int(path, "mixed_step_k", raw.get("mixed_step_k", max_k))
+    if mixed not in k_choices:
+        raise ValueError(
+            f"{path}: mixed_step_k {mixed} is not in k_choices {list(k_choices)}"
+        )
+    prior = _num(path, "prior", raw.get("prior", 0.7))
+    decay = _num(path, "decay", raw.get("decay", 0.9))
+    strength = _num(path, "strength", raw.get("strength", 2.0))
+    hysteresis = _num(path, "hysteresis", raw.get("hysteresis", 0.03))
+    if not 0.0 < prior < 1.0:
+        raise ValueError(f"{path}: prior must be in (0, 1)")
+    if not 0.0 <= decay < 1.0:
+        raise ValueError(f"{path}: decay must be in [0, 1)")
+    if not strength > 0.0:
+        raise ValueError(f"{path}: strength must be > 0")
+    if not 0.0 <= hysteresis < 1.0:
+        raise ValueError(f"{path}: hysteresis must be in [0, 1)")
+    log_interval = _int(path, "log_interval", raw.get("log_interval", 0))
+    if log_interval < 0:
+        raise ValueError(f"{path}: log_interval must be >= 0")
+
+    costs = raw.get("costs_ms")
+    if not isinstance(costs, dict) or not costs:
+        raise ValueError(
+            f"{path}: costs_ms must be a non-empty object of batch -> {{k: ms}}"
+        )
+    rows: dict[int, dict[int, float]] = {}
+    for key, by_k in costs.items():
+        try:
+            b = int(key)
+        except ValueError:
+            raise ValueError(
+                f"{path}: costs_ms batch {key!r} is not an integer"
+            ) from None
+        if b < 1 or str(b) != key:
+            raise ValueError(
+                f"{path}: costs_ms batch {key!r} must be a positive integer"
+            )
+        if not isinstance(by_k, dict):
+            raise ValueError(f"{path}: costs_ms[{b}] must be an object of k -> ms")
+        row: dict[int, float] = {}
+        for k in k_choices:
+            if str(k) not in by_k:
+                raise ValueError(f"{path}: costs_ms[{b}] has no k = {k}")
+            v = _num(path, f"costs_ms[{b}][{k}]", by_k[str(k)])
+            if v <= 0.0:
+                raise ValueError(f"{path}: costs_ms[{b}][{k}] must be positive")
+            row[k] = v
+        rows[b] = row
+    known = sorted(rows)
+    table: list[dict[int, float]] = [{}]
+    for b in range(1, max_num_seqs + 1):
+        if b <= known[0]:
+            row = rows[known[0]]
+        elif b >= known[-1]:
+            row = rows[known[-1]]
+        else:
+            lo = max(x for x in known if x <= b)
+            hi = min(x for x in known if x >= b)
+            w = 0.0 if hi == lo else (b - lo) / (hi - lo)
+            row = {k: rows[lo][k] + (rows[hi][k] - rows[lo][k]) * w for k in k_choices}
+        table.append(dict(row))
+    return Policy(
+        max_k=max_k,
+        k_choices=k_choices,
+        min_batch=min_batch,
+        mixed_step_k=mixed,
+        prior=prior,
+        decay=decay,
+        strength=strength,
+        hysteresis=hysteresis,
+        cost=tuple(table),
+        log_interval=log_interval,
+    )
+
+
+@cache
+def _policy_json(path: str) -> Any:
+    return json.loads(Path(path).read_text())
+
+
+def policy_path() -> str:
+    return os.environ.get(ENV_POLICY, "").strip()
+
+
+def capture_query_lens(decode_query_len: int, num_spec_tokens: int) -> list[int] | None:
+    """Uniform-decode query lengths the policy may run (``k + sampled`` for
+    every k in k_choices), for the target model's CUDA graph capture; None when
+    off, and None for a manager whose query length is not a verify step's
+    (``decode_query_len <= num_spec_tokens``: the DSpark/DFlash drafter's
+    query-block manager drafts its full block whatever the verify width)."""
+    path = policy_path()
+    if not path:
+        return None
+    sampled = decode_query_len - num_spec_tokens
+    if sampled < 1:
+        return None
+    raw = _policy_json(path)
+    choices = raw.get("k_choices") if isinstance(raw, dict) else None
+    if (
+        not isinstance(choices, list)
+        or not choices
+        or any(
+            not isinstance(k, int)
+            or isinstance(k, bool)
+            or not 1 <= k <= num_spec_tokens
+            for k in choices
+        )
+    ):
+        raise ValueError(f"{path}: k_choices must be integers in 1..{num_spec_tokens}")
+    return sorted({k + sampled for k in choices})
+
+
+# ------------------------------------------------------------------ state
+
+
+def expected_tokens(p: float, k: int) -> float:
+    """Tokens a verify round commits at depth k (bonus included) when each
+    draft is accepted with probability p given the earlier ones were."""
+    p = min(max(p, 0.0), 0.999)
+    return (1.0 - p ** (k + 1)) / (1.0 - p)
+
+
+@dataclass
+class AdaptiveVerify:
+    policy: Policy
+    # Per request: decayed accepted drafts / rejections.
+    acc_s: dict[str, float] = field(default_factory=dict)
+    acc_f: dict[str, float] = field(default_factory=dict)
+    # Request ids padded into decode by the step being scheduled, then per
+    # scheduler output (by object id) until that output is processed.
+    step_padded: set[str] = field(default_factory=set)
+    padded_by_output: OrderedDict = field(default_factory=OrderedDict)
+    last_k: int | None = None
+    force_path: str = ""
+    _force_value: int | None = None
+    _force_stamp: tuple[int, int, int] | None = None
+    _force_since: int = 0
+    _seq: int = 0
+    applied: Counter = field(default_factory=Counter)
+    # Logging.
+    chosen: Counter = field(default_factory=Counter)
+    _steps: int = 0
+    _obs_s: float = 0.0
+    _obs_f: float = 0.0
+
+    # ------------------------------------------------------------ feedback
+
+    def mark_padded(self, req_id: str) -> None:
+        """The step being scheduled pads ``req_id`` into decode with
+        ``[-1] * K`` placeholder drafts: their rejection is not evidence."""
+        self.step_padded.add(req_id)
+
+    def end_step(self, scheduler_output: Any) -> None:
+        """Attach this step's padded request ids to its scheduler output."""
+        if not self.step_padded:
+            return
+        self.padded_by_output[id(scheduler_output)] = frozenset(self.step_padded)
+        self.step_padded = set()
+        while len(self.padded_by_output) > MAX_PADDED_OUTPUTS:
+            self.padded_by_output.popitem(last=False)
+
+    def take_padded(self, scheduler_output: Any) -> frozenset[str]:
+        """The padded request ids of an output being processed (once)."""
+        if not self.padded_by_output:
+            return frozenset()
+        return self.padded_by_output.pop(id(scheduler_output), frozenset())
+
+    def observe(
+        self,
+        req_id: str,
+        num_draft_tokens: int,
+        num_accepted: int,
+        stale: bool = False,
+        padded: bool = False,
+    ) -> None:
+        """One verify round of ``req_id``: ``num_accepted`` of
+        ``num_draft_tokens`` valid drafts accepted (bonus token excluded).
+        Placeholder-padded and stale rounds are not evidence."""
+        if num_draft_tokens <= 0 or padded or stale:
+            return
+        accepted = min(max(num_accepted, 0), num_draft_tokens)
+        rejected = 1.0 if accepted < num_draft_tokens else 0.0
+        d = self.policy.decay
+        self.acc_s[req_id] = d * self.acc_s.get(req_id, 0.0) + accepted
+        self.acc_f[req_id] = d * self.acc_f.get(req_id, 0.0) + rejected
+        self._obs_s = 0.999 * self._obs_s + accepted
+        self._obs_f = 0.999 * self._obs_f + rejected
+
+    def forget(self, req_id: str) -> None:
+        self.acc_s.pop(req_id, None)
+        self.acc_f.pop(req_id, None)
+
+    def accept_rate(self, req_id: str) -> float:
+        pol = self.policy
+        s = self.acc_s.get(req_id, 0.0)
+        f = self.acc_f.get(req_id, 0.0)
+        return (s + pol.strength * pol.prior) / (s + f + pol.strength)
+
+    # -------------------------------------------------------------- choice
+
+    def choose(self, b: int, rates: list[float], cap: int) -> int:
+        """The verify width for a decode step of ``b`` requests with per-draft
+        acceptance ``rates`` and at most ``cap`` drafts on hand."""
+        pol = self.policy
+        candidates = [k for k in pol.k_choices if k <= cap]
+        if not candidates:
+            return cap
+        scores = {
+            k: sum(expected_tokens(p, k) for p in rates) / pol.step_ms(b, k)
+            for k in candidates
+        }
+        # Ties to the larger k (the served default is the widest).
+        best = max(candidates, key=lambda k: (scores[k], k))
+        last = self.last_k
+        if (
+            last is not None
+            and last in scores
+            and last != best
+            and scores[best] <= scores[last] * (1.0 + pol.hysteresis)
+        ):
+            best = last
+        return best
+
+    def _forced(self) -> int | None:
+        if not self.force_path:
+            return None
+        try:
+            st = os.stat(self.force_path)
+            stamp: tuple[int, int, int] | None = (
+                st.st_ino,
+                st.st_mtime_ns,
+                st.st_size,
+            )
+        except OSError:
+            stamp = None
+        if stamp != self._force_stamp:
+            self._force_stamp = stamp
+            try:
+                value = int(Path(self.force_path).read_text().strip() or 0)
+            except (OSError, ValueError):
+                value = 0
+            value = value if value in self.policy.k_choices else None
+            if value != self._force_value:
+                self._force_value = value
+                self._force_since = self._seq
+        return self._force_value
+
+    def _write_status(self, k: int, b: int) -> None:
+        status = {
+            "seq": self._seq,
+            "forced": self._force_value,
+            "since_seq": self._force_since,
+            "last": {"k": k, "b": b},
+            "applied": {str(key): n for key, n in sorted(self.applied.items())},
+        }
+        target = self.force_path + ".status"
+        tmp = f"{target}.{os.getpid()}.tmp"
+        try:
+            Path(tmp).write_text(json.dumps(status, sort_keys=True))
+            os.replace(tmp, target)
+        except OSError:  # pragma: no cover - read-only mount: no acknowledgement
+            pass
+
+    def begin_step(self, running: list[Any]) -> int:
+        """Choose this step's verify width and truncate the running decode
+        requests' draft lists to it (rebinding them). Returns K, the width a
+        request newly padded into decode this step must use."""
+        pol = self.policy
+        self.step_padded = set()
+        self._seq += 1
+        decoding = [r for r in running if not r.is_prefill_chunk]
+        on_hand = [len(r.spec_token_ids) for r in decoding if r.spec_token_ids]
+        cap = min(on_hand) if on_hand else pol.max_k
+        forced = self._forced()
+        b = len(running)
+        tag: int | None
+        if forced is not None:
+            k = forced
+            tag = -forced
+        elif b != len(decoding):
+            k = pol.mixed_step_k
+            tag = 0
+            self.last_k = None
+        elif b < pol.min_batch or not decoding:
+            k = pol.max_k
+            tag = None
+            self.last_k = None
+        else:
+            rates = [self.accept_rate(r.request_id) for r in decoding]
+            k = self.choose(b, rates, cap)
+            self.last_k = k
+            tag = k
+        if on_hand and k > cap:
+            # Fewer drafts on hand than chosen: the widest captured k that fits.
+            k = max((c for c in pol.k_choices if c <= cap), default=cap)
+        if k < pol.max_k:
+            for r in decoding:
+                if len(r.spec_token_ids) > k:
+                    # Rebind: AsyncScheduler hands every request one shared list.
+                    r.spec_token_ids = r.spec_token_ids[:k]
+        if tag is not None:
+            self._record(tag)
+        if self.force_path:
+            # "<k>:<b>" for decode steps, "mixed:<k>" for steps with a prefill.
+            key = f"{k}:{b}" if b == len(decoding) else f"mixed:{k}"
+            self.applied[key] += 1
+            self._write_status(k, b)
+        return k
+
+    # ------------------------------------------------------------- logging
+
+    def _record(self, tag: int) -> None:
+        interval = self.policy.log_interval
+        if not interval:
+            return
+        self.chosen[tag] += 1
+        self._steps += 1
+        if self._steps < interval:
+            return
+        total = sum(self.chosen.values()) or 1
+        hist = " ".join(
+            ("mixed" if t == 0 else f"forced{-t}" if t < 0 else f"K{t}")
+            + f":{n}({100 * n / total:.0f}%)"
+            for t, n in sorted(self.chosen.items())
+        )
+        obs = self._obs_s + self._obs_f
+        _logger().info(
+            "DSV41 adaptive verify: %d steps at batch >= %d, %s; "
+            "per-draft acceptance %.3f",
+            total,
+            self.policy.min_batch,
+            hist,
+            self._obs_s / obs if obs else float("nan"),
+        )
+        self.chosen.clear()
+        self._steps = 0
+
+
+def from_env(
+    speculative_config: Any, num_spec_tokens: int, max_num_seqs: int, dynamic_sd: bool
+) -> AdaptiveVerify | None:
+    """The scheduler's state, or None when ``VLLM_DSV41_ADAPTIVE_VERIFY_POLICY``
+    is unset or empty (nothing changes)."""
+    path = policy_path()
+    if not path:
+        return None
+    if speculative_config is None or num_spec_tokens <= 0:
+        raise ValueError(f"{ENV_POLICY} needs speculative decoding")
+    if getattr(speculative_config, "method", None) != "dspark":
+        raise ValueError(f"{ENV_POLICY} is qualified for DSpark only")
+    if dynamic_sd:
+        raise ValueError(
+            f"{ENV_POLICY} and num_speculative_tokens_per_batch_size both choose "
+            "the verify width"
+        )
+    if getattr(speculative_config, "enable_adaptive_verification", False):
+        raise ValueError(
+            f"{ENV_POLICY} and enable_adaptive_verification both choose the "
+            "verify width"
+        )
+    policy = parse_policy(_policy_json(path), max_num_seqs, num_spec_tokens, path)
+    state = AdaptiveVerify(
+        policy, force_path=os.environ.get(ENV_FORCE_FILE, "").strip()
+    )
+    _logger().info(
+        "DSV41 adaptive verify on (%s=%s): K in %s from batch %d, mixed steps K%d, "
+        "prior %.2f decay %.2f hysteresis %.2f%s",
+        ENV_POLICY,
+        path,
+        list(policy.k_choices),
+        policy.min_batch,
+        policy.mixed_step_k,
+        policy.prior,
+        policy.decay,
+        policy.hysteresis,
+        f", force file {state.force_path}" if state.force_path else "",
+    )
+    return state
