index 0000000..5ea9fae
--- /dev/null
+++ b/vllm/utils/dsv41_prefill_overlap.py
@@ -0,0 +1,150 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Opt-in, eager prefill MoE compute / PyNCCL reduction pipeline."""
+
+import json
+import os
+import re
+import weakref
+from collections.abc import Callable
+from pathlib import Path
+
+import torch
+
+from vllm.distributed import get_tp_group
+from vllm.forward_context import get_forward_context
+from vllm.utils.torch_utils import direct_register_custom_op
+
+_layers: weakref.WeakValueDictionary = weakref.WeakValueDictionary()
+
+
+def chunk_ranges(rows: int, maximum: int) -> list[tuple[int, int]]:
+    """Cover all rows with balanced chunks, avoiding a tiny decode-shaped tail."""
+    if rows <= 0 or maximum <= 0:
+        raise ValueError("rows and maximum must be positive")
+    count = (rows + maximum - 1) // maximum
+    size, extra = divmod(rows, count)
+    sizes = [size + (i < extra) for i in range(count)]
+    start = 0
+    result = []
+    for size in sizes:
+        result.append((start, start + size))
+        start += size
+    return result
+
+
+def pipeline_moe(
+    compute: Callable[[int, int], torch.Tensor],
+    rows: int,
+    maximum: int,
+    communicator,
+    stream: torch.cuda.Stream,
+) -> torch.Tensor:
+    """Reduce owned output chunks while the producer computes the next chunk.
+
+    Use PyNCCL directly: FlashInfer IPC workspaces are stream-bound. Cloning
+    each local result protects it from scratch reuse in the next MoE call.
+    """
+    producer = torch.cuda.current_stream()
+    output = None
+    try:
+        for lo, hi in chunk_ranges(rows, maximum):
+            local = compute(lo, hi).contiguous().clone()
+            if output is None:
+                output = local.new_empty((rows, *local.shape[1:]))
+                output.record_stream(stream)
+            ready = torch.cuda.Event()
+            ready.record(producer)
+            stream.wait_event(ready)
+            with torch.cuda.stream(stream):
+                communicator.all_reduce(
+                    local, out_tensor=output[lo:hi], stream=stream
+                )
+                local.record_stream(stream)
+    finally:
+        producer.wait_stream(stream)
+    assert output is not None
+    return output
+
+
+def register_moe(layer, prefix: str) -> str:
+    name = f"{prefix}:{id(layer)}"
+    _layers[name] = layer
+    return name
+
+
+def _prefill_moe(
+    hidden: torch.Tensor, input_ids: torch.Tensor | None, name: str
+) -> torch.Tensor:
+    layer = _layers[name]
+    group = get_tp_group()
+    context = get_forward_context()
+    metadata = context.attn_metadata
+    prefill = isinstance(metadata, dict) and any(
+        getattr(m, "num_prefills", 0) > 0 for m in metadata.values()
+    )
+    chunk = layer._dsv41_prefill_chunk
+    communicator = getattr(group.device_communicator, "pynccl_comm", None)
+    if (
+        not prefill
+        or hidden.shape[0] < 2 * chunk
+        or torch.cuda.is_current_stream_capturing()
+    ):
+        return group.all_reduce(layer._dsv41_local_forward(hidden, input_ids))
+    if communicator is None or communicator.disabled:
+        raise RuntimeError(
+            "DSV41 prefill overlap requires an enabled PyNCCL communicator"
+        )
+
+    stream = getattr(layer, "_dsv41_prefill_stream", None)
+    if stream is None:
+        stream = torch.cuda.Stream(device=hidden.device)
+        layer._dsv41_prefill_stream = stream
+
+    full_padding = context.is_padding
