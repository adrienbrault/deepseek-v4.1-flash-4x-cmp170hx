+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Opt-in V2 adapter for vocabulary-parallel sampling and DSpark verification."""
+
+import numpy as np
+import torch
+
+import vllm.envs as envs
+from vllm.distributed import get_tp_group
+from vllm.triton_utils import tl, triton
+from vllm.v1.worker.gpu.input_batch import get_num_sampled_and_rejected
+from vllm.v1.worker.gpu.sample.distributed import (
+    VocabParallelSampler,
+    finish_verification,
+)
+from vllm.v1.worker.gpu.sample.gumbel import gumbel_sample, tl_rand32
+from vllm.v1.worker.gpu.sample.output import SamplerOutput
+from vllm.v1.worker.gpu.sample.sampler import Sampler
+from vllm.v1.worker.gpu.spec_decode.rejection_sampler import gather_draft_sampled
+
+
+@triton.jit
+def _acceptance_uniform_kernel(out, mapping, seeds, positions, n, B: tl.constexpr):
+    i = tl.program_id(0) * B + tl.arange(0, B)
+    mask = i < n
+    req = tl.load(mapping + i, mask, other=0)
+    seed = tl.load(seeds + req)
+    pos = tl.load(positions + i, mask, other=0)
+    u = tl_rand32(seed, pos, includes_zero=False)
+    tl.store(out + i, u, mask)
+
+
+def acceptance_uniform(mapping, seeds, positions):
+    out = torch.empty_like(positions, dtype=torch.float32)
+    _acceptance_uniform_kernel[(triton.cdiv(out.numel(), 256),)](
+        out, mapping, seeds, positions, out.numel(), B=256
+    )
+    return out
+
+
+def eligible(sampler, input_batch, rejection_sampler=None) -> bool:
+    """Host-only, whole-batch decision, before any vocabulary collective."""
+    if type(sampler) is not Sampler:
+        return False
+    idx = input_batch.idx_mapping_np
+    if (
+        input_batch.num_reqs == 0
+        or input_batch.has_structured_output_reqs
+        or sampler.compute_nans
+        or sampler.return_sampling_mask
+        or sampler.trace_replay_state is not None
+        or len(sampler.logits_processors) != 3
+        or sampler.get_logprobs_dims(idx) is not None
+        or np.any(sampler.distributed_fallback[idx])
+    ):
+        return False
+    return not (
+        input_batch.num_draft_tokens
+        and rejection_sampler is not None
+        and (
+            rejection_sampler.use_block_verification
+            or rejection_sampler.fly_window_size
+            or rejection_sampler.synthetic_conditional_rates is not None
+            or rejection_sampler.watermark_key is not None
+        )
+    )
+
+
+def try_distributed_sample(
+    model, sampler, rejection_sampler, speculator, batch, hidden_states
+):
+    """Return None to run the existing full-logits path for this entire batch."""
+    if not eligible(sampler, batch, rejection_sampler):
+        return None
+    states = sampler.sampling_states
+    idx = batch.idx_mapping_np
+    all_greedy = bool(np.all(states.temperature.np[idx] == 0))
+    if (
+        batch.num_draft_tokens
+        and not all_greedy
+        and speculator.draft_logits is not None
+        and not getattr(speculator, "distributed_draft", False)
+    ):
+        return None
+    group = get_tp_group()
+    start, vocab_size = model.get_vocab_parallel_sampling_info()
+    if vocab_size > 2**24:
+        return None
+    parallel = VocabParallelSampler(group, start, vocab_size)
+    logits = parallel.mask_padding(
+        model.compute_logits_local(hidden_states[batch.logits_indices])
+    ).float()
+    mapping = batch.expanded_idx_mapping
+    temp = states.temperature.gpu[mapping]
+    greedy = temp == 0
+    logits = logits / torch.where(greedy, 1, temp)[:, None]
+    if not all_greedy and (
+        np.any(states.top_k.np[idx] < vocab_size) or np.any(states.top_p.np[idx] < 1)
+    ):
+        # Greedy rows ignore truncation even in a mixed batch.
+        k = torch.where(greedy, vocab_size, states.top_k.gpu[mapping])
+        p = torch.where(greedy, 1, states.top_p.gpu[mapping])
+        filtered = parallel.filter(logits, k, p, envs.VLLM_TP_SAMPLING_CANDIDATES)
+        if filtered is None:
+            return None
+        logits = filtered
+    pos = batch.positions[batch.logits_indices]
+
+    def draw(x):
+        return gumbel_sample(
+            x,
+            mapping,
+            states.temperature.gpu,
+            sampler.sampling_seeds,
+            pos,
+            apply_temperature=False,
+            is_drafting=False,
+            use_fp64=sampler.use_fp64_gumbel,
+            vocab_start=start,
+            return_max=True,
+        )
+
+    if batch.num_draft_tokens and rejection_sampler is not None:
+        previous, pos = gather_draft_sampled(
+            batch.input_ids,
+            batch.positions,
+            batch.logits_indices,
+            mapping,
+            batch.expanded_local_pos,
+            sampler.req_states.prefill_len.gpu,
+        )
+        proposed = previous.roll(-1)
+        is_bonus = batch.expanded_local_pos.roll(-1) == 0
+        is_bonus[-1] = True
+        if all_greedy:
+            recovered = parallel.sample(logits, draw)
+            accepted = (recovered == proposed) & (proposed >= 0) & ~is_bonus
+            sampled, count = finish_verification(
+                accepted,
+                proposed,
+                recovered,
+                batch.cu_num_logits,
+                rejection_sampler.num_speculative_steps,
+            )
+        else:
+            draft = None
+            if speculator.draft_logits is not None:
+                if not getattr(speculator, "distributed_draft", False):
+                    # A different draft implementation still owns a replicated
+                    # cache. Read only this target rank's vocabulary slice.
+                    draft = speculator.draft_logits.values[
+                        ..., start : start + logits.shape[-1]
+                    ]
+                    draft = torch.nn.functional.pad(
+                        draft, (0, logits.shape[-1] - draft.shape[-1]), value=-torch.inf
+                    )
+                else:
+                    draft = speculator.local_draft_logits
+                steps = batch.expanded_local_pos.long().clamp_max(draft.shape[1] - 1)
+                draft = draft[mapping, steps].float()
+                draft = draft / torch.where(greedy, 1, temp)[:, None]
+                draft = parallel.mask_padding(draft)
+            uniform = acceptance_uniform(mapping, sampler.sampling_seeds, pos)
+            sampled, count = parallel.verify(
+                logits,
+                draft,
+                proposed,
+                is_bonus,
+                greedy,
+                uniform,
+                draw,
+                batch.cu_num_logits,
+                rejection_sampler.num_speculative_steps,
+            )
+    else:
+        sampled = parallel.sample(logits, draw)[:, None]
+        count = batch.seq_lens.new_ones(batch.num_reqs)
+    count, rejected = get_num_sampled_and_rejected(
+        count,
+        batch.seq_lens,
+        batch.cu_num_logits,
+        batch.idx_mapping,
+        sampler.req_states.prefill_len.gpu,
+    )
+    return SamplerOutput(
+        sampled_token_ids=sampled,
+        logprobs_tensors=None,
+        num_nans=None,
+        num_sampled=count,
+        num_rejected=rejected,
+    )
