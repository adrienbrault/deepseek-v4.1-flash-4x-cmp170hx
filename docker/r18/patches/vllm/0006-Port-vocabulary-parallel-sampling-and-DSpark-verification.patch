+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Vocabulary-sharded sampling math, independent of CUDA and model state.
+
+Collectives operate on rows, never on vocabulary-sized tensors. ``draw`` returns
+(local winning value, global token id), keyed by global token id, request seed
+and position. The dense reference is the same algorithm with one shard.
+"""
+
+from collections.abc import Callable
+from typing import Any
+
+import torch
+
+Draw = Callable[[torch.Tensor], tuple[torch.Tensor, torch.Tensor]]
+
+
+def merge_winners(values: torch.Tensor, ids: torch.Tensor) -> torch.Tensor:
+    """Resolve equal maxima to the smallest global token id, as torch.argmax."""
+    maximum = values.amax(-1, keepdim=True)
+    return ids.masked_fill(values != maximum, torch.iinfo(torch.int64).max).amin(-1)
+
+
+def finish_verification(
+    accepted: torch.Tensor,
+    proposed: torch.Tensor,
+    recovered: torch.Tensor,
+    cu_num_logits: torch.Tensor,
+    max_spec_len: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Pack a variable-length accepted prefix and one recovery/bonus per request."""
+    cols = torch.arange(max_spec_len + 1, device=accepted.device)
+    rows = cu_num_logits[:-1, None].long() + cols
+    lengths = cu_num_logits.diff().long()
+    safe_rows = rows.clamp_max(accepted.numel() - 1)
+    valid = cols < lengths[:, None] - 1
+    prefix = (accepted[safe_rows] & valid).long().cumprod(-1)
+    count = prefix.sum(-1)
+    last = recovered[(cu_num_logits[:-1] + count).long()]
+    output = torch.where(cols < count[:, None], proposed[safe_rows], last[:, None])
+    output = output.masked_fill(cols > count[:, None], 0)
+    return output, (count + 1).to(torch.int32)
+
+
+class VocabParallelSampler:
+    def __init__(self, group: Any, start: int, vocab_size: int):
+        self.group = group
+        self.start = start
+        self.vocab_size = vocab_size
+
+    def mask_padding(self, logits: torch.Tensor) -> torch.Tensor:
+        ids = torch.arange(logits.shape[-1], device=logits.device) + self.start
+        return logits.masked_fill(ids >= self.vocab_size, -torch.inf)
+
+    def lse(self, logits: torch.Tensor) -> torch.Tensor:
+        # Use a common maximum before the scalar SUM reduction. FP64 makes the
+        # top-p coverage decision insensitive to FP32 accumulation order.
+        x = logits.double()
+        maximum = self.group.all_gather(x.amax(-1, keepdim=True), dim=-1).amax(
+            -1, keepdim=True
+        )
+        maximum = maximum.masked_fill(~torch.isfinite(maximum), 0)
+        total = self.group.all_reduce((x - maximum).exp().sum(-1, keepdim=True))
+        return maximum + total.log()
+
+    def token_logprob(
+        self, logits: torch.Tensor, tokens: torch.Tensor, lse: torch.Tensor
+    ) -> torch.Tensor:
+        local_ids = tokens - self.start
+        owned = (local_ids >= 0) & (local_ids < logits.shape[-1])
+        value = logits.gather(-1, local_ids.clamp(0, logits.shape[-1] - 1)[:, None])
+        value = self.group.all_reduce(value.double().masked_fill(~owned[:, None], 0))
+        return (value - lse).squeeze(-1)
+
+    def sample(self, logits: torch.Tensor, draw: Draw) -> torch.Tensor:
+        value, ids = draw(logits)
+        # All vocabulary ids must fit exactly in the value dtype used for packing.
+        pair = torch.stack((value, ids.to(value.dtype)), -1)
+        pairs = self.group.all_gather(pair, dim=-1).reshape(logits.shape[0], -1, 2)
+        return merge_winners(pairs[..., 0], pairs[..., 1].long())
+
+    def filter(
+        self, logits: torch.Tensor, k: torch.Tensor, p: torch.Tensor, bound: int
+    ) -> torch.Tensor | None:
+        """Exact top-k, then nucleus, or None if candidate coverage is unproved.
+
+        Top-k retains all cutoff ties. Nucleus order is descending score, then
+        ascending global id; keep the crossing token. A strict cutoff above
+        every omitted score certifies global ordering. Full-vocab scalar mass
+        certifies nucleus coverage. A numerical guard falls back at boundaries.
+        This method runs outside graph capture: the batch-wide proof syncs once.
+        """
+        if bound < 1:
+            return None
+        width = min(bound, logits.shape[-1])
+        values, local_ids = logits.topk(min(width + 1, logits.shape[-1]), dim=-1)
+        omitted = (
+            values[:, width : width + 1]
+            if width < logits.shape[-1]
+            else torch.full_like(values[:, :1], -torch.inf)
+        )
+        omitted = self.group.all_gather(omitted, dim=-1).amax(-1)
+        ids = local_ids[:, :width] + self.start
+        values = self.group.all_gather(values[:, :width].contiguous(), dim=-1)
+        ids = self.group.all_gather(ids.contiguous(), dim=-1)
+        # topk has unspecified tie order; establish a global canonical order.
+        order = ids.argsort(dim=-1, stable=True)
+        ids, values = ids.gather(-1, order), values.gather(-1, order)
+        order = values.argsort(dim=-1, descending=True, stable=True)
+        ids, values = ids.gather(-1, order), values.gather(-1, order)
+        finite = torch.isfinite(values)
+        limited = k < self.vocab_size
+        kth = values.gather(-1, (k.long() - 1).clamp_max(values.shape[-1] - 1)[:, None])
+        topk_keep = (~limited[:, None] | (values >= kth)) & finite
+        topk_proved = ~limited | ((k <= values.shape[-1]) & (kth[:, 0] > omitted))
+        filtered = values.masked_fill(~topk_keep, -torch.inf).double()
+        full_lse = self.lse(logits)
+        normalizer = torch.where(
+            limited[:, None], filtered.logsumexp(-1, keepdim=True), full_lse
+        )
+        mass = (filtered - normalizer).exp()
+        cumulative = mass.cumsum(-1)
+        before = cumulative - mass
+        nucleus_keep = (before < p[:, None]) & topk_keep
+        keep = torch.where(p[:, None] < 1, nucleus_keep, topk_keep)
+        count = keep.sum(-1)
+        cut = (count - 1).clamp_min(0)[:, None]
+        cutoff_value, cutoff_id = values.gather(-1, cut), ids.gather(-1, cut)
+        kept_mass = mass.masked_fill(~keep, 0).sum(-1)
+        # FP64 arithmetic cannot prove a decision at a rounded boundary. Use a
+        # conservative error guard; equality, near-equality and ties fall back.
+        guard = 64 * torch.finfo(torch.float64).eps * self.vocab_size
+        p_proved = (p >= 1) | (
+            (kept_mass > p.double() + guard)
+            & ((before - p[:, None]).abs().amin(-1) > guard)
+        )
+        coverage = (count > 0) & (cutoff_value[:, 0] > omitted)
+        if not bool((topk_proved & p_proved & coverage).all().item()):
+            return None
+        global_ids = torch.arange(logits.shape[-1], device=logits.device) + self.start
+        if_p = (logits > cutoff_value) | (
+            (logits == cutoff_value) & (global_ids <= cutoff_id)
+        )
+        if_k = logits >= kth
+        mask = torch.where(p[:, None] < 1, if_p, if_k)
+        return logits.masked_fill(~mask, -torch.inf)
+
+    def verify(
+        self,
+        target: torch.Tensor,
+        draft: torch.Tensor | None,
+        proposed: torch.Tensor,
+        is_bonus: torch.Tensor,
+        greedy: torch.Tensor,
+        uniform: torch.Tensor,
+        draw: Draw,
+        cu_num_logits: torch.Tensor,
+        max_spec_len: int,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """Leviathan rejection with sharded p/q and sharded residual Gumbel-max.
+
+        Only log partitions, owning-rank token logits, and winning pairs cross
+        ranks. q=None denotes a point-mass (greedily proposed) draft.
+        """
+        target_lse = self.lse(target)
+        log_p = self.token_logprob(target, proposed, target_lse)
+        if draft is None:
+            log_q = torch.zeros_like(log_p)
+            keys = torch.arange(target.shape[-1], device=target.device) + self.start
+            residual = target.masked_fill(keys == proposed[:, None], -torch.inf)
+        else:
+            draft_lse = self.lse(draft)
+            log_q = self.token_logprob(draft, proposed, draft_lse)
+            a = target.double() - target_lse
+            b = draft.double() - draft_lse
+            ratio = (b - a).exp()
+            residual = (a + torch.log1p(-ratio.clamp_max(1))).float()
+            residual = residual.masked_fill(~(a > b), -torch.inf)
+        valid = (proposed >= 0) & ~is_bonus
+        accepted = (log_p > uniform.double().log() + log_q) & valid
+        # Greedy recovery is the unmodified target argmax. Bonus/placeholder
+        # rows also draw from p directly. Never use a zero-mass residual there.
+        residual = torch.where((greedy | is_bonus | ~valid)[:, None], target, residual)
+        recovered = self.sample(residual, draw)
+        accepted = torch.where(greedy, (recovered == proposed) & valid, accepted)
+        return finish_verification(
+            accepted, proposed, recovered, cu_num_logits, max_spec_len
+        )
