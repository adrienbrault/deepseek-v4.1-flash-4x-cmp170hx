diff --git a/vllm/v1/attention/ops/indexer_prefill_sm80.py b/vllm/v1/attention/ops/indexer_prefill_sm80.py
new file mode 100644
index 0000000..d43edb0
--- /dev/null
+++ b/vllm/v1/attention/ops/indexer_prefill_sm80.py
@@ -0,0 +1,58 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Exact postprocessing of the existing torch.topk selection on SM80."""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _store_sorted_relative_indices(
+    values, columns, starts, output,
+    value_stride: tl.constexpr, column_stride: tl.constexpr,
+    start_stride: tl.constexpr, output_stride: tl.constexpr,
+    K: tl.constexpr, OUT_K: tl.constexpr, BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    i = tl.arange(0, BLOCK)
+    value = tl.load(values + row * value_stride + i, i < K, other=-float("inf"))
+    col = tl.load(columns + row * column_stride + i, i < K, other=0)
+    start = tl.load(starts + row * start_stride)
+    finite = (value == value) & (tl.abs(value) != float("inf"))
+    relative = tl.where((i < K) & finite, (col - start).to(tl.int32), 2147483647)
+    relative = tl.sort(relative, descending=False)
+    relative = tl.where(relative == 2147483647, -1, relative)
+    tl.store(output + row * output_stride + i, relative, i < OUT_K)
+
+
+def topk_prefill_sm80(
+    logits: torch.Tensor,
+    starts: torch.Tensor,
+    output: torch.Tensor,
+    topk: int,
+) -> None:
+    """Select with torch, fuse finite filtering, relative IDs, sorting and padding.
+
+    The caller must supply logits already masked outside each row's causal
+    interval. The SM80 MQA scorer and candidate mask both guarantee this.
+    Keeping torch.topk's default sorted=True preserves its tie selection.
+    """
+    if topk <= 0 or topk > 2048:
+        raise ValueError("SM80 fused top-k postprocessing supports 1..2048 entries")
+    assert logits.ndim == 2 and logits.dtype == torch.float32
+    assert output.shape == (logits.shape[0], topk)
+    assert output.dtype == torch.int32 and output.stride(1) == 1
+    assert starts.shape == (logits.shape[0],)
+    if logits.shape[0] == 0:
+        return
+    k = min(topk, logits.shape[1])
+    if k == 0:
+        output.fill_(-1)
+        return
+    values, columns = logits.topk(k, dim=-1)
+    _store_sorted_relative_indices[(logits.shape[0],)](
+        values, columns, starts, output,
+        values.stride(0), columns.stride(0), starts.stride(0), output.stride(0),
+        K=k, OUT_K=topk, BLOCK=triton.next_power_of_2(topk), num_warps=4,
+    )
