+def _trellis_load_tp_view(
+    loaded: "torch.Tensor", shard_id: str, tp_rank: int, tp_size: int
+) -> "torch.Tensor":
+    """Use the existing TP geometry without making a pageable packed copy.
+
+    Only the opt-in arena loader calls this helper. The final pinned bounce
+    performs the same strided gather with Tensor.copy_ before its H2D copy.
+    """
+    if shard_id in ("w1", "w3"):
+        dim = 1
+    elif shard_id == "w2":
+        dim = 0
+    else:
+        raise ValueError(f"unknown EXL3 shard_id={shard_id}")
+    if tp_size <= 1:
+        return loaded
+    off, length = _tp_slice(int(loaded.shape[dim]), tp_rank, tp_size, 16, True)
+    return loaded.narrow(dim, off, length)
+
