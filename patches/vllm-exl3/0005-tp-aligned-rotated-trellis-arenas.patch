+def _tp_slice(
+    size: int,
+    tp_rank: int,
+    tp_size: int,
+    unit: int = 1,
+    aligned: bool = False,
+) -> tuple[int, int]:
+    """Return (offset, length) in tensor indices for headers AND payloads."""
+    if tp_size <= 1:
+        return 0, size
+    align = _moe_tp_align() if aligned else 0
+    if align > 0:
+        if (size * unit) % align:
+            raise RuntimeError(
+                f"EXL3 aligned MoE TP: dimension spans {size * unit} columns, which "
+                f"is not a multiple of the VLLM_EXL3_MOE_TP_ALIGN={align} Hadamard "
+                "block; unset VLLM_EXL3_MOE_TP_ALIGN or use an expert-parallel build"
+            )
+        off, length = aligned_tp_split(size * unit, tp_rank, tp_size, align)
+        if off % unit or length % unit:
+            raise RuntimeError("EXL3 aligned TP split cuts a trellis tile")
+        return off // unit, length // unit
+    if size % tp_size:
+        raise ValueError(
+            f"EXL3 TP shard: size {size} is not divisible by tp={tp_size}"
+        )
+    chunk = size // tp_size
+    return chunk * tp_rank, chunk
+
