+def _moe_load_tp_geometry(layer: Any, param: Any = None) -> tuple[int, int]:
+    """Effective chunk owner shared by the routed loader and arena prescan."""
+    if getattr(layer, "use_ep", False):
+        return 0, 1  # whole experts; EP placement is handled by the expert map
+    rank, size = _resolve_tp_geometry(layer, param)
+    if size > 1:
+        rank = (rank + int(getattr(layer, "_exl3_tp_rotation", 0))) % size
+    return rank, size
 
 
