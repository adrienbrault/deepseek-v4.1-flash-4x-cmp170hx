+// DESK item 3: overwrite only integer/boolean fields proved by the host guard.
+// Arithmetic bodies, initial 0+value operations, fences and atomics are unchanged.
+template <int I>
+__device__ __forceinline__ MoeCoopParams fixed_params(MoeCoopParams p)
+{
+    if constexpr (I != 0)
+    {
+        p.topk = 6;
+        p.H = p.Hi = p.Ho = p.H_out = 5120;
+        p.I = I;
+        p.ksplit_a = p.ksplit_b = 1;
+        p.gated = true;
+        p.a_global = true;
+        p.gu_f32 = false;
+        p.act = MOE_COOP_ACT_SILU;
+        p.dbg = 0;
+    }
+    return p;
+}
