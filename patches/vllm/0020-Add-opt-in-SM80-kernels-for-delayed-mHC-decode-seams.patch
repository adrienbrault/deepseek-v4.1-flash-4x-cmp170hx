@@ -0,0 +1,339 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""SM80 mHC correctness gate, graph benchmark, and offline configuration search.
+
+Run from an installed vLLM checkout. --output is always written, including on
+failure. Tuning emits a separate JSON table for VLLM_MHC_SM80_CONFIG; null means
+retain the upstream implementation. No candidate is selected without checking
+against both upstream and FP32 torch. No GPU results are bundled with this tool.
+"""
+
+import argparse
+import itertools
+import json
+import math
+import os
+import statistics
+import time
+import traceback
+from functools import partial
+from pathlib import Path
+from unittest.mock import patch
+
+# This process owns its switch: baseline calls must always be upstream.
+os.environ["VLLM_MHC_SM80"] = "0"
+
+import torch
+import torch.nn.functional as F
+
+from vllm import envs
+from vllm.model_executor.kernels.mhc.sm80 import mhc_post_sm80, mhc_pre_sm80
+from vllm.model_executor.kernels.mhc.sm80_config import (
+    SM80Config,
+    config_key,
+    select_config,
+)
+from vllm.model_executor.kernels.mhc.tilelang import (
+    mhc_fused_post_pre_delayed_tilelang,
+    mhc_post_tilelang,
+    mhc_pre_delayed_tilelang,
+)
+from vllm.model_executor.kernels.mhc.torch import (
+    mhc_post_torch,
+    mhc_pre_delayed_torch,
+)
+
+
+def row_list(raw):
+    result = set()
+    for item in raw.split(","):
+        if ":" in item:
+            lo, hi = map(int, item.split(":"))
+            result.update(range(lo, hi + 1))
+        else:
+            result.add(int(item))
+    if not result or min(result) < 1:
+        raise ValueError("Rows must be positive")
+    return sorted(result)
+
+
+def make_case(rows, op, width, seed=0, variant="normal"):
+    torch.manual_seed(seed)
+    device = "cuda"
+    r = torch.randn(rows, 4, 5120, device=device, dtype=torch.bfloat16)
+    x = torch.randn(rows, 5120, device=device, dtype=torch.bfloat16)
+    fn = torch.randn(24, width, device=device) / math.sqrt(width)
+    scale = torch.randn(3, device=device) * (1 if variant == "stress" else 0.1)
+    base = torch.randn(24, device=device) * 0.1
+    prev_post = torch.rand(rows, 4, 1, device=device) * 2
+    prev_comb = torch.softmax(torch.randn(rows, 4, 4, device=device), -1)
+    pre = torch.rand(rows, 4, device=device) + 0.5
+    norm = (1 + torch.randn(5120, device=device) * 0.1).bfloat16()
+    if variant == "zero":
+        r.zero_()
+        x.zero_()
+    if width == 5120:
+        r = x.unsqueeze(1).expand(-1, 4, -1).contiguous()
+    kwargs = dict(
+        pre_mix=None if width == 5120 or variant == "identity" else pre,
+        norm_weight=None if variant == "no_norm" else norm,
+        norm_eps=1e-6,
+    )
+    if op == "pre" and width == 5120:
+        kwargs["x"] = x
+    args = (r, fn, scale, base, 1e-6, 1e-6, 1e-6, 2.0, 20)
+    if op == "fused":
+        kwargs["capture_aux"] = variant == "aux"
+        old = (x, r, prev_post, prev_comb)
+        baseline = lambda: mhc_fused_post_pre_delayed_tilelang(
+            *old, *args[1:], **kwargs
+        )
+        candidate = lambda cfg: mhc_pre_sm80(
+            *args,
+            **kwargs,
+            sublayer_out=x,
+            post_layer_mix=prev_post,
+            comb_res_mix=prev_comb,
+            config=cfg,
+        )
+        updated = mhc_post_torch(*old)
+    elif op == "pre":
+        baseline = lambda: mhc_pre_delayed_tilelang(*args, **kwargs)
+        candidate = lambda cfg: mhc_pre_sm80(*args, **kwargs, config=cfg)[1:5]
+        updated = r
+    else:
+        baseline = lambda: mhc_post_tilelang(x, r, prev_post, prev_comb)
+        candidate = lambda cfg: mhc_post_sm80(x, r, prev_post, prev_comb, cfg)
+        return baseline, candidate, mhc_post_torch(x, r, prev_post, prev_comb), r
+
+    ref_kwargs = {k: v for k, v in kwargs.items() if k in ("x", "pre_mix")}
+    reference = list(mhc_pre_delayed_torch(updated, *args[1:], **ref_kwargs))
+    if kwargs["norm_weight"] is not None:
+        reference[2] = F.rms_norm(reference[2], (5120,), norm, 1e-6)
+    if op == "fused":
+        aux = updated.mean(1) if kwargs["capture_aux"] else updated.new_empty(0, 5120)
+        reference = [updated, *reference, aux]
+    return baseline, candidate, reference, r
+
+
+def check_close(actual, reference, op):
+    if op == "post":
+        actual, reference = [actual], [reference]
+    errors = []
+    for got, want in zip(actual, reference, strict=True):
+        assert got.shape == want.shape and got.dtype == want.dtype
+        assert torch.isfinite(got).all().item(), "Nonfinite output"
+        if got.dtype == torch.float32:
+            atol, rtol = 5e-4, 1e-3
+        else:
+            atol, rtol = 2e-2, 1e-2
+        torch.testing.assert_close(got, want, atol=atol, rtol=rtol)
+        errors.append(
+            (got.float() - want.float()).abs().max().item() if got.numel() else 0.0
+        )
+    return errors
+
+
+def graph_us(functions, rows, repeats):
+    # Rotate independent weights/inputs so a one-layer L2-hot loop does not
+    # masquerade as the 80-seam target model. Use --weight-ring 1 for hot timing.
+    fn = functions[0]
+    for _ in range(3):
+        fn()
+    torch.cuda.synchronize()
+    batch = max(len(functions), 32 if rows <= 48 else 4)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        for i in range(batch):
+            output = functions[i % len(functions)]()
+    graph.replay()
+    torch.cuda.synchronize()
+    samples = []
+    for _ in range(5):
+        start, end = [torch.cuda.Event(enable_timing=True) for _ in range(2)]
+        start.record()
+        for _ in range(repeats):
+            graph.replay()
+        end.record()
+        end.synchronize()
+        samples.append(start.elapsed_time(end) * 1000 / (batch * repeats))
+    # Keep the final outputs alive until all event timing is complete.
+    del output
+    return statistics.median(samples)
+
+
+def graph_gate(baseline, candidate, cfg, reference, op, residual):
+    candidate(cfg)
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        output = candidate(cfg)
+    graph.replay()
+    check_close(output, reference, op)
+    # A second replay with different data catches stale / partially written output.
+    saved = residual.clone()
+    residual.mul_(0.75)
+    graph.replay()
+    check_close(output, baseline(), op)
+    residual.copy_(saved)
+
+
+def atomic_json(path, data):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temp = path.with_suffix(path.suffix + ".tmp")
+    temp.write_text(json.dumps(data, indent=2) + "\n")
+    temp.replace(path)
+
+
+def run(args, report):
+    assert torch.cuda.is_available(), "CUDA is required"
+    assert torch.cuda.get_device_capability() == (8, 0), "Run on SM80"
+    torch.backends.cuda.matmul.allow_tf32 = False
+    torch.backends.cudnn.allow_tf32 = False
+    props = torch.cuda.get_device_properties(0)
+    report["device"] = dict(
+        name=props.name,
+        sms=props.multi_processor_count,
+        capability=[8, 0],
+        torch=torch.__version__,
+    )
+    configs = {}
+    report["weight_ring_decode"] = args.weight_ring
+    report["weight_ring_prefill"] = min(args.weight_ring, 4)
+    configs_raw = Path(args.config).read_text() if args.config else ""
+    candidates = [
+        SM80Config(k, n, w)
+        for k, n, w in itertools.product((512, 1024, 2048), (2, 4, 8), (4, 8))
+    ]
+    for rows in row_list(args.rows):
+        for op, width in (
+            ("pre", 5120),
+            ("pre", 20480),
+            ("fused", 20480),
+            ("post", 5120),
+        ):
+            key = config_key(op, rows, width)
+            entry = dict(key=key, trials=[])
+            report["cases"].append(entry)
+            baseline, candidate, reference, residual = make_case(rows, op, width)
+            check_close(baseline(), reference, op)
+            timing = []
+            if args.mode != "check":
+                ring = args.weight_ring if rows <= 48 else min(args.weight_ring, 4)
+                timing = [
+                    make_case(rows, op, width, seed=1000 + i)[:2] for i in range(ring)
+                ]
+            old_timing = [item[0] for item in timing]
+            cfg = select_config(op, rows, width, configs_raw)
+            if cfg is None:
+                entry["route"] = "upstream"
+                if rows <= 48:
+                    configs[key] = None
+                if args.mode != "check":
+                    entry["upstream_us"] = graph_us(old_timing, rows, args.repeats)
+                # Exercise the actual enabled wrapper on prefill / null configs.
+                with (
+                    patch.object(envs, "VLLM_MHC_SM80", True),
+                    patch.object(envs, "VLLM_MHC_SM80_CONFIG", configs_raw),
+                ):
+                    check_close(baseline(), reference, op)
+                atomic_json(args.output, report)
+                continue
+            baseline_us = (
+                graph_us(old_timing, rows, args.repeats)
+                if args.mode != "check"
+                else None
+            )
+            entry["upstream_us"] = baseline_us
+            choices = candidates if args.mode == "tune" and op != "post" else [cfg]
+            if args.mode == "tune" and op == "post":
+                choices = [
+                    SM80Config(block_h=b, num_warps=w)
+                    for b, w in itertools.product((128, 256, 512, 1024), (4, 8))
+                ]
+            best, best_us = None, baseline_us
+            variants = ("normal", "identity", "no_norm", "zero", "stress")
+            if op == "fused":
+                variants += ("aux",)
+            validation = [
+                make_case(rows, op, width, seed, variant)
+                for seed in range(args.seeds)
+                for variant in variants
+            ]
+            for choice in choices:
+                trial = dict(config=choice.to_dict())
+                entry["trials"].append(trial)
+                try:
+                    validation_errors = []
+                    for old, new, ref, _ in validation:
+                        original = old()
+                        actual = new(choice)
+                        validation_errors.append(
+                            dict(
+                                torch=check_close(actual, ref, op),
+                                upstream=check_close(actual, original, op),
+                            )
+                        )
+                    trial["max_abs_errors"] = validation_errors
+                    graph_gate(baseline, candidate, choice, reference, op, residual)
+                    # Confirm public routing (the same entry points the model uses).
+                    raw = json.dumps(dict(version=1, configs={key: choice.to_dict()}))
+                    with (
+                        patch.object(envs, "VLLM_MHC_SM80", True),
+                        patch.object(envs, "VLLM_MHC_SM80_CONFIG", raw),
+                    ):
+                        check_close(baseline(), reference, op)
+                    trial["correct"] = True
+                    if args.mode != "check":
+                        new_timing = [partial(item[1], choice) for item in timing]
+                        trial["us"] = graph_us(new_timing, rows, args.repeats)
+                        # Require a 3% margin over upstream, then minimize latency.
+                        if trial["us"] < baseline_us * 0.97 and trial["us"] < best_us:
+                            best, best_us = choice, trial["us"]
+                except Exception as exc:
+                    trial["correct"] = False
+                    trial["error"] = str(exc)
+                    if args.mode != "tune":
+                        raise
+            entry["selected"] = None if best is None else best.to_dict()
+            configs[key] = entry["selected"]
+            entry["selected_us"] = best_us
+            print(key, "upstream_us=", baseline_us, "selected_us=", best_us, flush=True)
+            atomic_json(args.output, report)
+    report["status"] = "passed"
+    if args.mode == "tune":
+        report["status"] = "completed; only passing faster candidates selected"
+        atomic_json(
+            args.config_output,
+            dict(version=1, configs=configs, device=report["device"]),
+        )
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--mode", choices=("check", "bench", "tune"), default="check")
+    parser.add_argument("--rows", default="1:48,64,128,256,512,1024,2048")
+    parser.add_argument("--seeds", type=int, default=2)
+    parser.add_argument("--repeats", type=int, default=20)
+    parser.add_argument("--weight-ring", type=int, default=32)
+    parser.add_argument("--config", help="Read an offline configuration table")
+    parser.add_argument("--config-output", default="mhc-sm80-config.json")
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    if args.seeds < 1 or args.repeats < 1 or args.weight_ring < 1:
+        parser.error("seeds, repeats and weight-ring must be positive")
+    report = dict(status="running", mode=args.mode, cases=[], started=time.time())
+    try:
+        run(args, report)
+    except Exception:
+        report["status"] = "failed"
+        report["error"] = traceback.format_exc()
+        raise
+    finally:
+        report["finished"] = time.time()
+        atomic_json(args.output, report)
+
+
+if __name__ == "__main__":
+    main()
