@@ -0,0 +1,284 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU gates, runnable with unittest without importing vLLM's GPU test fixtures.
+
+The small torch interpreter executes the actual Triton function bodies. It
+checks indexing, split tails and BF16 boundaries; compilation and GPU reduction
+order still require benchmark_mhc_sm80.py --mode check on SM80.
+"""
+
+import importlib.util
+import itertools
+import json
+import sys
+import types
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import torch
+import torch.nn.functional as F
+
+ROOT = Path(__file__).resolve().parents[3]
+KERNELS = ROOT / "vllm/model_executor/kernels/mhc"
+
+
+def load_file(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+config_module = load_file("mhc_sm80_cpu_config", KERNELS / "sm80_config.py")
+reference = load_file("mhc_sm80_cpu_reference", KERNELS / "torch.py")
+
+
+class Pointer:
+    def __init__(self, tensor, offset=0):
+        self.tensor, self.offset = tensor.flatten(), offset
+
+    def __add__(self, offset):
+        return Pointer(self.tensor, self.offset + offset)
+
+
+class TorchLanguage:
+    constexpr = object
+    float32, bfloat16 = torch.float32, torch.bfloat16
+    arange = staticmethod(torch.arange)
+    static_range = staticmethod(range)
+    sum = staticmethod(torch.sum)
+    exp = staticmethod(torch.exp)
+    rsqrt = staticmethod(torch.rsqrt)
+    sigmoid = staticmethod(torch.sigmoid)
+    where = staticmethod(torch.where)
+    ids = (0, 0, 0)
+
+    def program_id(self, axis):
+        return self.ids[axis]
+
+    @staticmethod
+    def full(shape, value, dtype):
+        return torch.full(shape, value, dtype=dtype)
+
+    @staticmethod
+    def max(value, axis):
+        return value.max(axis).values
+
+    @staticmethod
+    def gather(value, index, axis):
+        return torch.gather(value, axis, index)
+
+    @staticmethod
+    def fma(a, b, c):
+        return (a.double() * b.double() + c.double()).float()
+
+    @staticmethod
+    def load(ptr, mask=None, other=0):
+        index = torch.as_tensor(ptr.offset, dtype=torch.int64)
+        if mask is None:
+            return ptr.tensor[index]
+        index, mask = torch.broadcast_tensors(index, torch.as_tensor(mask))
+        return torch.where(mask, ptr.tensor[torch.where(mask, index, 0)], other)
+
+    @staticmethod
+    def store(ptr, value, mask=None):
+        index, value = torch.broadcast_tensors(torch.as_tensor(ptr.offset), value)
+        if mask is None:
+            ptr.tensor[index] = value.to(ptr.tensor.dtype)
+        else:
+            mask = torch.broadcast_to(mask, index.shape)
+            ptr.tensor[index[mask]] = value[mask].to(ptr.tensor.dtype)
+
+
+language = TorchLanguage()
+
+
+class Jit:
+    def __init__(self, fn):
+        self.fn = fn
+
+    def __call__(self, *args, **kwargs):
+        return self.fn(*args, **kwargs)
+
+    def __getitem__(self, grid):
+        def launch(*args, **kwargs):
+            args = [Pointer(x) if isinstance(x, torch.Tensor) else x for x in args]
+            for ids in itertools.product(*(range(n) for n in grid)):
+                language.ids = ids
+                self.fn(*args)
+
+        return launch
+
+
+fake_vllm = types.ModuleType("vllm")
+fake_vllm.envs = types.SimpleNamespace(VLLM_MHC_SM80_CONFIG="")
+fake_triton = types.SimpleNamespace(
+    jit=Jit,
+    cdiv=lambda a, b: (a + b - 1) // b,
+    next_power_of_2=lambda n: 1 << (n - 1).bit_length(),
+)
+with patch.dict(
+    sys.modules,
+    {
+        "vllm": fake_vllm,
+        "vllm.triton_utils": types.SimpleNamespace(tl=language, triton=fake_triton),
+        "vllm.model_executor.kernels.mhc.sm80_config": config_module,
+    },
+):
+    kernels = load_file("mhc_sm80_cpu_kernel", KERNELS / "sm80.py")
+
+
+class SM80ConfigTests(unittest.TestCase):
+    def test_device_and_layout_guards_do_not_send_other_gpus_to_sm80(self):
+        tensor = types.SimpleNamespace(
+            ndim=3,
+            shape=(6, 4, 5120),
+            dtype=torch.bfloat16,
+            is_contiguous=lambda: True,
+            is_cuda=True,
+            device="cuda",
+        )
+        for capability in ((8, 6), (9, 0), (10, 0)):
+            with patch.object(
+                torch.cuda, "get_device_capability", return_value=capability
+            ):
+                self.assertIsNone(kernels.get_sm80_config(tensor, "fused", 20480))
+        with patch.object(torch.cuda, "get_device_capability", return_value=(8, 0)):
+            self.assertIsNotNone(kernels.get_sm80_config(tensor, "fused", 20480))
+        self.assertIsNone(
+            kernels.get_sm80_config(torch.empty(6, 4, 5120), "fused", 20480)
+        )
+
+    def test_every_decode_row_has_config_but_prefill_and_other_shapes_decline(self):
+        for rows in range(1, 49):
+            for op, width in (
+                ("pre", 5120),
+                ("pre", 20480),
+                ("fused", 20480),
+                ("post", 5120),
+            ):
+                self.assertIsNotNone(config_module.select_config(op, rows, width))
+        for rows in (0, 49, 64, 128, 2048):
+            self.assertIsNone(config_module.select_config("fused", rows, 20480))
+        self.assertIsNone(config_module.select_config("pre", 6, 28672))
+
+    def test_offline_selection_can_keep_upstream_per_shape(self):
+        raw = json.dumps(
+            {
+                "version": 1,
+                "configs": {
+                    "fused:6:20480": None,
+                    "pre:6:5120": {"block_k": 512, "tile_n": 2},
+                },
+            }
+        )
+        self.assertIsNone(config_module.select_config("fused", 6, 20480, raw))
+        self.assertEqual(config_module.select_config("pre", 6, 5120, raw).tile_n, 2)
+        self.assertIsNotNone(config_module.select_config("fused", 7, 20480, raw))
+
+    def test_bad_tuning_tables_fail_before_launch(self):
+        for raw in (
+            "{",
+            '{"version":2,"configs":{}}',
+            '{"version":1,"configs":{"pre:49:5120":{}}}',
+            '{"version":1,"configs":{"pre:6:5120":{"block_k":1000}}}',
+            '{"version":1,"configs":{"pre:6:5120":{"num_warps":true}}}',
+        ):
+            with self.assertRaises((ValueError, TypeError)):
+                config_module.parse_configs(raw)
+
+
+class SM80ArithmeticTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.previous_threads = torch.get_num_threads()
+        torch.set_num_threads(1)
+
+    @classmethod
+    def tearDownClass(cls):
+        torch.set_num_threads(cls.previous_threads)
+
+    def setUp(self):
+        context = torch.device("cpu")
+        context.__enter__()
+        self.addCleanup(context.__exit__, None, None, None)
+
+    def test_actual_kernel_bodies_match_torch_at_real_shapes(self):
+        for rows, width, fused, carried, norm, aux, block in (
+            (1, 5120, False, False, True, False, 2048),  # masked split tail
+            (6, 20480, False, True, False, False, 1024),
+            (6, 20480, True, True, True, True, 1024),
+            (48, 20480, True, False, True, False, 2048),
+        ):
+            with self.subTest(rows=rows, width=width, fused=fused, carried=carried):
+                torch.manual_seed(11)
+                residual = torch.randn(rows, 4, 5120).bfloat16()
+                x = torch.randn(rows, 5120).bfloat16()
+                fn = torch.randn(24, width) / width**0.5
+                scale, base = torch.randn(3) * 0.1, torch.randn(24) * 0.1
+                pre = torch.rand(rows, 4) if carried else None
+                norm_weight = torch.ones(5120).bfloat16() if norm else None
+                post = torch.rand(rows, 4, 1) * 2
+                comb = torch.softmax(torch.randn(rows, 4, 4), -1)
+                cfg = config_module.SM80Config(block_k=block)
+                updated = (
+                    reference.mhc_post_torch(x, residual, post, comb)
+                    if fused
+                    else residual
+                )
+                kwargs = dict(
+                    pre_mix=pre, norm_weight=norm_weight, capture_aux=aux, config=cfg
+                )
+                ref_kwargs = dict(pre_mix=pre)
+                if width == 5120:
+                    kwargs["x"] = ref_kwargs["x"] = x
+                if fused:
+                    kwargs.update(
+                        sublayer_out=x, post_layer_mix=post, comb_res_mix=comb
+                    )
+                actual = kernels.mhc_pre_sm80(
+                    residual, fn, scale, base, 1e-6, 1e-6, 1e-6, 2.0, 20, **kwargs
+                )
+                expected = list(
+                    reference.mhc_pre_delayed_torch(
+                        updated,
+                        fn,
+                        scale,
+                        base,
+                        1e-6,
+                        1e-6,
+                        1e-6,
+                        2.0,
+                        20,
+                        **ref_kwargs,
+                    )
+                )
+                if norm:
+                    expected[2] = F.rms_norm(expected[2], (5120,), norm_weight, 1e-6)
+                expected = [
+                    updated,
+                    *expected,
+                    updated.mean(1) if aux else updated.new_empty(0, 5120),
+                ]
+                for got, want in zip(actual, expected, strict=True):
+                    atol = 5e-4 if got.dtype == torch.float32 else 2e-2
+                    torch.testing.assert_close(got, want, atol=atol, rtol=1e-2)
+
+    def test_tiled_post_writes_every_element_without_mutating_inputs(self):
+        torch.manual_seed(3)
+        residual = torch.randn(6, 4, 5120).bfloat16()
+        saved = residual.clone()
+        x = torch.randn(6, 5120).bfloat16()
+        post, comb = torch.rand(6, 4, 1), torch.rand(6, 4, 4)
+        got = kernels.mhc_post_sm80(
+            x, residual, post, comb, config_module.SM80Config(block_h=512)
+        )
+        want = reference.mhc_post_torch(x, residual, post, comb)
+        torch.testing.assert_close(got, want, atol=2e-2, rtol=1e-2)
+        torch.testing.assert_close(residual, saved, atol=0, rtol=0)
+
+
+if __name__ == "__main__":
+    unittest.main()
