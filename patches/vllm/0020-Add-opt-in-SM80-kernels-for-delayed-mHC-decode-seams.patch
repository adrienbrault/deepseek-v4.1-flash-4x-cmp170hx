+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Fixed decode configurations; offline tuning never runs in a serving process."""
+
+import json
+from dataclasses import asdict, dataclass
+from functools import cache
+
+
+@dataclass(frozen=True)
+class SM80Config:
+    block_k: int = 1024
+    tile_n: int = 4
+    num_warps: int = 4
+    block_h: int = 256
+
+    def __post_init__(self):
+        for name, allowed in (
+            ("block_k", (256, 512, 1024, 2048)),
+            ("tile_n", (2, 4, 8)),
+            ("num_warps", (4, 8)),
+            ("block_h", (128, 256, 512, 1024)),
+        ):
+            value = getattr(self, name)
+            if type(value) is not int or value not in allowed:
+                raise ValueError(f"Invalid SM80 mHC {name}: {value!r}")
+
+    def to_dict(self):
+        return asdict(self)
+
+
+def config_key(op: str, rows: int, width: int) -> str:
+    return f"{op}:{rows}:{width}"
+
+
+@cache
+def parse_configs(raw: str) -> dict[str, SM80Config | None]:
+    if not raw:
+        return {}
+    data = json.loads(raw)
+    if (
+        not isinstance(data, dict)
+        or type(data.get("version")) is not int
+        or data.get("version") != 1
+        or not isinstance(data.get("configs"), dict)
+    ):
+        raise ValueError("SM80 mHC configuration requires version=1 and configs")
+    result = {}
+    for key, value in data["configs"].items():
+        op, rows, width = key.split(":")
+        if not supported_shape(op, int(rows), int(width)) or key != config_key(
+            op, int(rows), int(width)
+        ):
+            raise ValueError(f"Unsupported SM80 mHC configuration key: {key}")
+        result[key] = None if value is None else SM80Config(**value)
+    return result
+
+
+def supported_shape(op: str, rows: int, width: int) -> bool:
+    widths = {"pre": (5120, 20480), "fused": (20480,), "post": (5120,)}
+    return 1 <= rows <= 48 and width in widths.get(op, ())
+
+
+def select_config(op: str, rows: int, width: int, raw: str = ""):
+    if not supported_shape(op, rows, width):
+        return None
+    # Starting points, not measured winners. The tuner can select upstream
+    # (JSON null) independently for every row count and operation.
+    default = SM80Config(
+        block_k=512 if rows <= 2 else 1024 if rows <= 8 else 2048,
+        tile_n=4 if rows <= 8 else 8,
+    )
+    return parse_configs(raw).get(config_key(op, rows, width), default)
