new file mode 100644
index 0000000000..64eadfd17c
--- /dev/null
+++ b/vllm/model_executor/kernels/mhc/sm80.py
@@ -0,0 +1,299 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Opt-in SIMT mHC for V4.1's delayed pre-mix, hc=4, hidden=5120, SM80."""
+
+import torch
+
+from vllm import envs
+from vllm.model_executor.kernels.mhc.sm80_config import SM80Config, select_config
+from vllm.triton_utils import tl, triton
+
+
+def get_sm80_config(residual, op, width):
+    if (
+        residual.ndim != 3
+        or residual.shape[1:] != (4, 5120)
+        or residual.dtype != torch.bfloat16
+        or not residual.is_contiguous()
+        or not residual.is_cuda
+        or torch.cuda.get_device_capability(residual.device) != (8, 0)
+    ):
+        return None
+    return select_config(op, residual.shape[0], width, envs.VLLM_MHC_SM80_CONFIG)
+
+
+@triton.jit
+def _post_values(X, R, P, C, row, k, valid, H: tl.constexpr):
+    stream = k // H
+    h = k % H
+    value = tl.load(P + row * 4 + stream, valid, 0) * tl.load(
+        X + row * H + h, valid, 0
+    ).to(tl.float32)
+    for i in tl.static_range(4):
+        coeff = tl.load(C + row * 16 + i * 4 + stream, valid, 0)
+        residual = tl.load(R + row * 4 * H + i * H + h, valid, 0).to(tl.float32)
+        value = tl.fma(coeff, residual, value)
+    # Projection and collapse must both see the serialized BF16 residual.
+    return value.to(tl.bfloat16).to(tl.float32)
+
+
+@triton.jit
+def _project(
+    X,
+    R,
+    P,
+    C,
+    W,
+    R_OUT,
+    MIX,
+    SQR,
+    ROWS: tl.constexpr,
+    H: tl.constexpr,
+    K: tl.constexpr,
+    SPLITS: tl.constexpr,
+    BK: tl.constexpr,
+    BN: tl.constexpr,
+    POST: tl.constexpr,
+):
+    row = tl.program_id(0)
+    tile = tl.program_id(1)
+    split = tl.program_id(2)
+    k = split * BK + tl.arange(0, BK)
+    n = tile * BN + tl.arange(0, BN)
+    if POST:
+        value = _post_values(X, R, P, C, row, k, k < K, H)
+        if tile == 0:
+            tl.store(R_OUT + row * K + k, value, k < K)
+    else:
+        value = tl.load(X + row * K + k, k < K, 0).to(tl.float32)
+    weight = tl.load(
+        W + n[:, None] * K + k[None, :], (n[:, None] < 24) & (k[None, :] < K), 0
+    )
+    dot = tl.sum(weight * value[None, :], 1)
+    tl.store(MIX + (split * ROWS + row) * 24 + n, dot, n < 24)
+    if tile == 0:
+        tl.store(SQR + split * ROWS + row, tl.sum(value * value, 0))
+
+
+@triton.jit
+def _finish(
+    R,
+    MIX,
+    SQR,
+    SCALE,
+    BASE,
+    PRE,
+    NORM,
+    POST,
+    COMB,
+    INPUT,
+    NEXT_PRE,
+    AUX,
+    ROWS: tl.constexpr,
+    H: tl.constexpr,
+    K: tl.constexpr,
+    SPLITS: tl.constexpr,
+    BS: tl.constexpr,
+    BH: tl.constexpr,
+    RMS_EPS: tl.constexpr,
+    PRE_EPS: tl.constexpr,
+    SINK_EPS: tl.constexpr,
+    POST_MULT: tl.constexpr,
+    REPEAT: tl.constexpr,
+    NORM_EPS: tl.constexpr,
+    CARRIED: tl.constexpr,
+    NORMALIZE: tl.constexpr,
+    WRITE_AUX: tl.constexpr,
+):
+    row = tl.program_id(0)
+    s = tl.arange(0, BS)
+    n = tl.arange(0, 32)
+    sqr = tl.sum(tl.load(SQR + s * ROWS + row, s < SPLITS, 0), 0)
+    parts = tl.load(
+        MIX + (s[:, None] * ROWS + row) * 24 + n[None, :],
+        (s[:, None] < SPLITS) & (n[None, :] < 24),
+        0,
+    )
+    mix = tl.sum(parts, 0) * tl.rsqrt(sqr / K + RMS_EPS)
+    group = tl.where(n < 4, 0, tl.where(n < 8, 1, 2))
+    logits = mix * tl.load(SCALE + group) + tl.load(BASE + n, n < 24, 0)
+    j = tl.arange(0, 4)
+    pre = tl.sigmoid(tl.gather(logits, j, 0)) + PRE_EPS
+    post = tl.sigmoid(tl.gather(logits, j + 4, 0)) * POST_MULT
+    tl.store(NEXT_PRE + row * 4 + j, pre)
+    tl.store(POST + row * 4 + j, post)
+    ij = tl.arange(0, 16)
+    comb = tl.gather(logits, ij + 8, 0).reshape(4, 4)
+    comb = tl.exp(comb - tl.max(comb, 1)[:, None])
+    comb = comb / tl.sum(comb, 1)[:, None] + SINK_EPS
+    comb = comb / (tl.sum(comb, 0)[None, :] + SINK_EPS)
+    for _ in range(REPEAT - 1):
+        comb = comb / (tl.sum(comb, 1)[:, None] + SINK_EPS)
+        comb = comb / (tl.sum(comb, 0)[None, :] + SINK_EPS)
+    tl.store(COMB + row * 16 + ij, comb.reshape(16))
+
+    h = tl.arange(0, BH)
+    collapsed = tl.full((BH,), 0, tl.float32)
+    mean = tl.full((BH,), 0, tl.float32)
+    for i in tl.static_range(4):
+        value = tl.load(R + row * 4 * H + i * H + h, h < H, 0).to(tl.float32)
+        if CARRIED:
+            coeff = tl.load(PRE + row * 4 + i)
+            collapsed = tl.fma(coeff, value, collapsed)
+        elif i == 0:
+            collapsed = value
+        if WRITE_AUX:
+            mean += value
+    rounded = collapsed.to(tl.bfloat16).to(tl.float32)
+    if NORMALIZE:
+        rstd = tl.rsqrt(tl.sum(rounded * rounded, 0) / H + NORM_EPS)
+        rounded = rounded * rstd * tl.load(NORM + h, h < H, 0).to(tl.float32)
+    tl.store(INPUT + row * H + h, rounded, h < H)
+    if WRITE_AUX:
+        tl.store(AUX + row * H + h, mean * 0.25, h < H)
+
+
+@triton.jit
+def _post(X, R, P, C, OUT, H: tl.constexpr, B: tl.constexpr):
+    row = tl.program_id(0)
+    k = tl.program_id(1) * B + tl.arange(0, B)
+    value = _post_values(X, R, P, C, row, k, k < 4 * H, H)
+    tl.store(OUT + row * 4 * H + k, value, k < 4 * H)
+
+
+def mhc_post_sm80(x, residual, post, comb, config: SM80Config):
+    rows, _, hidden = residual.shape
+    assert residual.shape[1:] == (4, 5120) and 1 <= rows <= 48
+    assert residual.is_contiguous() and residual.dtype == torch.bfloat16
+    assert x.shape == (rows, hidden) and x.is_contiguous()
+    assert x.dtype == torch.bfloat16
+    assert post.shape in ((rows, 4), (rows, 4, 1)) and post.is_contiguous()
+    assert comb.shape == (rows, 4, 4) and comb.is_contiguous()
+    assert post.dtype == comb.dtype == torch.float32
+    out = torch.empty_like(residual)
+    _post[(rows, triton.cdiv(4 * hidden, config.block_h))](
+        x,
+        residual,
+        post,
+        comb,
+        out,
+        hidden,
+        config.block_h,
+        num_warps=config.num_warps,
+    )
+    return out
+
+
+def mhc_pre_sm80(
+    residual,
+    fn,
+    scale,
+    base,
+    rms_eps,
+    pre_eps,
+    sink_eps,
+    post_mult,
+    repeat,
+    pre_mix=None,
+    x=None,
+    norm_weight=None,
+    norm_eps=1e-6,
+    *,
+    sublayer_out=None,
+    post_layer_mix=None,
+    comb_res_mix=None,
+    capture_aux=False,
+    config: SM80Config,
+):
+    """Return the six delayed-seam outputs; standalone pre drops first/last."""
+    rows, _, hidden = residual.shape
+    fused = sublayer_out is not None
+    projection = residual.flatten(1) if x is None else x
+    width = projection.shape[1]
+    assert residual.is_contiguous() and residual.dtype == torch.bfloat16
+    assert residual.shape[1:] == (4, 5120) and 1 <= rows <= 48
+    assert projection.is_contiguous() and projection.dtype == torch.bfloat16
+    assert width in (hidden, 4 * hidden) and (not fused or x is None)
+    assert fn.shape == (24, width) and fn.dtype == torch.float32
+    assert fn.is_contiguous() and scale.is_contiguous() and base.is_contiguous()
+    assert scale.shape == (3,) and base.shape == (24,)
+    assert scale.dtype == base.dtype == torch.float32
+    assert repeat >= 1
+    if pre_mix is not None:
+        assert pre_mix.shape == (rows, 4) and pre_mix.is_contiguous()
+        assert pre_mix.dtype == torch.float32
+    if norm_weight is not None:
+        assert norm_weight.shape == (hidden,) and norm_weight.is_contiguous()
+        assert norm_weight.dtype == torch.bfloat16
+    if fused:
+        assert sublayer_out.shape == (rows, hidden)
+        assert sublayer_out.dtype == torch.bfloat16 and sublayer_out.is_contiguous()
+        assert post_layer_mix.shape in ((rows, 4), (rows, 4, 1))
+        assert comb_res_mix.shape == (rows, 4, 4)
+        assert post_layer_mix.is_contiguous() and comb_res_mix.is_contiguous()
+        assert post_layer_mix.dtype == comb_res_mix.dtype == torch.float32
+
+    splits = triton.cdiv(width, config.block_k)
+    mix = torch.empty((splits, rows, 24), device=residual.device, dtype=torch.float32)
+    sqr = torch.empty((splits, rows), device=residual.device, dtype=torch.float32)
+    updated = torch.empty_like(residual) if fused else residual
+    post = torch.empty((rows, 4, 1), device=residual.device, dtype=torch.float32)
+    comb = torch.empty((rows, 4, 4), device=residual.device, dtype=torch.float32)
+    next_pre = torch.empty((rows, 4), device=residual.device, dtype=torch.float32)
+    layer_input = torch.empty(
+        (rows, hidden), device=residual.device, dtype=torch.bfloat16
+    )
+    aux = torch.empty(
+        (rows if capture_aux else 0, hidden),
+        device=residual.device,
+        dtype=torch.bfloat16,
+    )
+    _project[(rows, triton.cdiv(24, config.tile_n), splits)](
+        sublayer_out if fused else projection,
+        residual,
+        post_layer_mix if fused else post,
+        comb_res_mix if fused else comb,
+        fn,
+        updated,
+        mix,
+        sqr,
+        rows,
+        hidden,
+        width,
+        splits,
+        config.block_k,
+        config.tile_n,
+        fused,
+        num_warps=config.num_warps,
+    )
+    _finish[(rows,)](
+        updated,
+        mix,
+        sqr,
+        scale,
+        base,
+        pre_mix if pre_mix is not None else next_pre,
+        norm_weight if norm_weight is not None else layer_input,
+        post,
+        comb,
+        layer_input,
+        next_pre,
+        aux,
+        rows,
+        hidden,
+        width,
+        splits,
+        triton.next_power_of_2(splits),
+        triton.next_power_of_2(hidden),
+        rms_eps,
+        pre_eps,
+        sink_eps,
+        post_mult,
+        repeat,
+        norm_eps,
+        pre_mix is not None,
+        norm_weight is not None,
+        capture_aux,
+        num_warps=4,
+    )
+    return updated, post, comb, layer_input, next_pre, aux
