+++ b/tests/distributed/test_custom_all_reduce.py
@@ -725,3 +725,27 @@ def test_custom_allreduce(
     if world_size > torch.accelerator.device_count():
         pytest.skip("Not enough GPUs to run the test.")
     multi_process_parallel(monkeypatch, tp_size, pipeline_parallel_size, test_target)
+
+
+def test_dsv41_int8_block_error_bound_cpu():
+    """Bound absolute error even for outliers, cancellation and zero blocks."""
+    from vllm.distributed.device_communicators.dsv41_int8_all_reduce import (
+        int8_reference,
+    )
+
+    generator = torch.Generator().manual_seed(170)
+    for rows in (1, 6, 24, 48):
+        x = torch.randn(4, rows, 5120, generator=generator).bfloat16()
+        for case in range(4):
+            values = x.clone()
+            if case == 1:
+                values[:, ::2, ::256] *= 64
+            elif case == 2:
+                values[1] = -values[0]
+                values[3] = -values[2]
+            elif case == 3:
+                values.zero_()
+            got, ref, bound = int8_reference(values)
+            assert ((got.float() - ref.float()).abs() <= bound + 1.e-6).all()
+            if case >= 2:
+                assert torch.equal(got, ref)
