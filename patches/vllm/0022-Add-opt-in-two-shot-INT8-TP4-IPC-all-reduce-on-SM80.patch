index 0000000000..387c8c76c9
--- /dev/null
+++ b/vllm/distributed/device_communicators/dsv41_int8_all_reduce.py
@@ -0,0 +1,278 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Experimental TP4 INT8 IPC all-reduce, with FP32 block scales and sums.
+
+Two-shot pull: publish quantized input, reduce each rank's quarter in FP32,
+requantize the sums, then gather the quantized quarters. Three rendezvous
+protect both phases and storage reuse. Uses vLLM's CUDA IPC allocator, with
+dedicated storage rather than aliasing FlashInfer's opaque mailbox.
+"""
+
+import torch
+import torch.distributed as dist
+
+from vllm.distributed.device_communicators.custom_all_reduce import CustomAllreduce
+from vllm.distributed.parallel_state import in_the_same_node_as
+from vllm.triton_utils import tl, triton
+
+WIDTH = 5120
+MAX_ROWS = 48
+BLOCK = 256
+PAYLOAD = MAX_ROWS * WIDTH
+SCALES = PAYLOAD // BLOCK
+# Header: input-ready, shard-ready, consumed epochs; data/scales follow it.
+HEADER = 256
+SCALE_OFFSET = HEADER + PAYLOAD
+SECOND_OFFSET = SCALE_OFFSET + SCALES * 4
+SECOND_SCALE_OFFSET = SECOND_OFFSET + PAYLOAD // 4
+BUFFER_BYTES = SECOND_SCALE_OFFSET + SCALES
+
+
+def int8_reference(inputs):
+    """Independent torch codec and conservative elementwise BF16 error budget.
+
+    Inputs are four finite BF16 rank tensors. The bound includes quantization,
+    FP32 dequantization/addition, and final/reference BF16 rounding.
+    """
+    values = inputs.float().reshape(4, -1, BLOCK)
+    scales = (values.abs().amax(-1, keepdim=True) / 127.0).clamp_min(1.0e-30)
+    quantized = torch.round(values / scales).clamp(-127, 127)
+    decoded = quantized * scales
+    total = torch.zeros_like(decoded[0])
+    exact = torch.zeros_like(values[0])
+    for rank in range(4):
+        total = total + decoded[rank]
+        exact = exact + values[rank]
+    output_scales = (total.abs().amax(-1, keepdim=True) / 127.0).clamp_min(1.0e-30)
+    requantized = torch.round(total / output_scales).clamp(-127, 127)
+    decoded_total = requantized * output_scales
+    result = decoded_total.to(torch.bfloat16).reshape(inputs.shape[1:])
+    reference = exact.to(torch.bfloat16).reshape(inputs.shape[1:])
+    fp32_budget = 1.0e-6 * values.abs().sum(0)
+    bound = (
+        0.5 * (scales.sum(0) + output_scales)
+        + fp32_budget
+        + (decoded_total.abs() + exact.abs()) / 256.0
+    )
+    return result, reference, bound.expand_as(total).reshape(inputs.shape[1:])
+
+
+@triton.jit
+def _quantize(
+    X,
+    Ptrs,
+    RANK: tl.constexpr,
+    HEADER: tl.constexpr,
+    SCALE_OFFSET: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    block = tl.program_id(0)
+    lane = tl.arange(0, BLOCK)
+    x = tl.load(X + block * BLOCK + lane).to(tl.float32)
+    scale = tl.maximum(tl.div_rn(tl.max(tl.abs(x), 0), 127.0), 1.0e-30)
+    # Explicit round-to-nearest-even; no FP8 instructions on Ampere.
+    q = tl.inline_asm_elementwise(
+        "cvt.rni.s32.f32 $0, $1;",
+        constraints="=r,f",
+        args=[tl.div_rn(x, scale)],
+        dtype=tl.int32,
+        is_pure=True,
+        pack=1,
+    )
+    base = tl.load(Ptrs + RANK)
+    values = (base + HEADER).to(tl.pointer_type(tl.int8))
+    scales = (base + SCALE_OFFSET).to(tl.pointer_type(tl.float32))
+    tl.store(values + block * BLOCK + lane, tl.minimum(127, tl.maximum(-127, q)))
+    tl.store(scales + block, scale)
+
+
+@triton.jit
+def _rendezvous(Ptrs, RANK: tl.constexpr, PHASE: tl.constexpr):
+    # One CTA only. Stream order completes quantize/reduce before publishing.
+    # Separate ready/consumed epochs prevent a fast rank overwriting a slow
+    # reader's payload. No host reset or capture-time sequence constants.
+    local = (tl.load(Ptrs + RANK) + PHASE * 8).to(tl.pointer_type(tl.uint64))
+    previous = tl.inline_asm_elementwise(
+        "ld.global.acquire.sys.u64 $0, [$1];", constraints="=l,l",
+        args=[local], dtype=tl.uint64, is_pure=False, pack=1)
+    epoch = previous + 1
+    tl.inline_asm_elementwise(
+        "st.global.release.sys.u64 [$1], $2; mov.u32 $0, 0;",
+        constraints="=r,l,l",
+        args=[local, epoch],
+        dtype=tl.uint32,
+        is_pure=False,
+        pack=1,
+    )
+    for peer in tl.static_range(4):
+        signal = (tl.load(Ptrs + peer) + PHASE * 8).to(tl.pointer_type(tl.uint64))
+        seen = tl.inline_asm_elementwise(
+            "ld.global.acquire.sys.u64 $0, [$1];",
+            constraints="=l,l",
+            args=[signal],
+            dtype=tl.uint64,
+            is_pure=False,
+            pack=1,
+        )
+        while seen < epoch:
+            seen = tl.inline_asm_elementwise(
+                "ld.global.acquire.sys.u64 $0, [$1];",
+                constraints="=l,l",
+                args=[signal],
+                dtype=tl.uint64,
+                is_pure=False,
+                pack=1,
+            )
+
+
+@triton.jit
+def _reduce_quantize(
+    Ptrs,
+    RANK: tl.constexpr,
+    SHARD_BLOCKS: tl.constexpr,
+    HEADER: tl.constexpr,
+    SCALE_OFFSET: tl.constexpr,
+    SECOND_OFFSET: tl.constexpr,
+    SECOND_SCALE_OFFSET: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    local_block = tl.program_id(0)
+    block = RANK * SHARD_BLOCKS + local_block
+    lane = tl.arange(0, BLOCK)
+    total = tl.full((BLOCK,), 0.0, tl.float32)
+    for rank in tl.static_range(4):
+        base = tl.load(Ptrs + rank)
+        values = (base + HEADER).to(tl.pointer_type(tl.int8))
+        scales = (base + SCALE_OFFSET).to(tl.pointer_type(tl.float32))
+        q = tl.load(values + block * BLOCK + lane, cache_modifier=".cg").to(tl.float32)
+        scale = tl.load(scales + block, cache_modifier=".cg")
+        total = total + q * scale
+    scale = tl.maximum(tl.div_rn(tl.max(tl.abs(total), 0), 127.0), 1.0e-30)
+    q = tl.inline_asm_elementwise(
+        "cvt.rni.s32.f32 $0, $1;",
+        constraints="=r,f",
+        args=[tl.div_rn(total, scale)],
+        dtype=tl.int32,
+        is_pure=True,
+        pack=1,
+    )
+    base = tl.load(Ptrs + RANK)
+    values = (base + SECOND_OFFSET).to(tl.pointer_type(tl.int8))
+    scales = (base + SECOND_SCALE_OFFSET).to(tl.pointer_type(tl.float32))
+    tl.store(values + local_block * BLOCK + lane, tl.minimum(127, tl.maximum(-127, q)))
+    tl.store(scales + local_block, scale)
+
+
+@triton.jit
+def _gather(
+    Ptrs,
+    Out,
+    SHARD_BLOCKS: tl.constexpr,
+    SECOND_OFFSET: tl.constexpr,
+    SECOND_SCALE_OFFSET: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    block = tl.program_id(0)
+    rank = block // SHARD_BLOCKS
+    local_block = block % SHARD_BLOCKS
+    lane = tl.arange(0, BLOCK)
+    base = tl.load(Ptrs + rank)
+    values = (base + SECOND_OFFSET).to(tl.pointer_type(tl.int8))
+    scales = (base + SECOND_SCALE_OFFSET).to(tl.pointer_type(tl.float32))
+    q = tl.load(values + local_block * BLOCK + lane, cache_modifier=".cg").to(
+        tl.float32
+    )
+    scale = tl.load(scales + local_block, cache_modifier=".cg")
+    tl.store(Out + block * BLOCK + lane, q * scale)
+
+
+class DSV41Int8AllReduce:
+    """Single serialized stream across eager/capture/replay, like FI IPC.
+
+    TBO's comm stream is joined back to its compute stream on every handoff;
+    that also orders storage reuse against subsequent non-TBO forwards.
+    """
+
+    def __init__(self, group, device):
+        if dist.get_world_size(group) != 4:
+            raise ValueError("INT8 IPC all-reduce requires TP4")
+        if not all(in_the_same_node_as(group, source_rank=0)):
+            raise ValueError("INT8 IPC all-reduce requires a single node")
+        self.rank = dist.get_rank(group)
+        self.group = group
+        self.device = torch.device(device)
+        supported = torch.cuda.get_device_capability(device) == (8, 0)
+        # Agree before allocating: a local-only refusal would strand the peers.
+        supported = supported and all(
+            peer == self.device.index
+            or torch.cuda.can_device_access_peer(self.device.index, peer)
+            for peer in range(torch.cuda.device_count())
+        )
+        votes = [None] * 4
+        dist.all_gather_object(votes, supported, group=group)
+        if not all(votes):
+            raise ValueError("INT8 IPC requires SM80 and complete GPU peer access")
+        self.pointers = CustomAllreduce.create_shared_buffer(BUFFER_BYTES, group)
+        self.ptrs = torch.tensor(self.pointers, device=device, dtype=torch.uint64)
+        self.closed = False
+        torch.cuda.synchronize(device)
+        dist.barrier(group=group)
+
+    @staticmethod
+    def supports(x):
+        return (
+            x.is_cuda
+            and x.dtype == torch.bfloat16
+            and x.is_contiguous()
+            and x.ndim == 2
+            and x.shape[1] == WIDTH
+            and 1 <= x.shape[0] <= MAX_ROWS
+        )
+
+    def all_reduce(self, x):
+        assert self.supports(x)
+        output = torch.empty_like(x)
+        blocks = x.numel() // BLOCK
+        _quantize[(blocks,)](
+            x,
+            self.ptrs,
+            self.rank,
+            HEADER,
+            SCALE_OFFSET,
+            BLOCK,
+            num_warps=4,
+            enable_fp_fusion=False,
+        )
+        _rendezvous[(1,)](self.ptrs, self.rank, 0, num_warps=1)
+        _reduce_quantize[(blocks // 4,)](
+            self.ptrs,
+            self.rank,
+            blocks // 4,
+            HEADER,
+            SCALE_OFFSET,
+            SECOND_OFFSET,
+            SECOND_SCALE_OFFSET,
+            BLOCK,
+            num_warps=4,
+            enable_fp_fusion=False,
+        )
+        _rendezvous[(1,)](self.ptrs, self.rank, 1, num_warps=1)
+        _gather[(blocks,)](
+            self.ptrs,
+            output,
+            blocks // 4,
+            SECOND_OFFSET,
+            SECOND_SCALE_OFFSET,
+            BLOCK,
+            num_warps=4,
+            enable_fp_fusion=False,
+        )
+        _rendezvous[(1,)](self.ptrs, self.rank, 2, num_warps=1)
+        return output
+
+    def destroy(self):
+        if not self.closed:
+            torch.cuda.synchronize(self.device)
+            dist.barrier(group=self.group)
+            CustomAllreduce.free_shared_buffer(self.pointers, rank=self.rank)
+            self.closed = True
