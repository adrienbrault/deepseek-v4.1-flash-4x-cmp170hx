@@ -356,6 +356,13 @@ class DeepseekV4IndexerBackend(DeepseekV32IndexerBackend):
 
 
 class DeepseekV41IndexerBackend(DeepseekV4IndexerBackend):
+    @classmethod
+    def supports_device_cpu_query_lens_mismatch(cls) -> bool:
+        return (
+            current_platform.is_cuda()
+            and current_platform.is_device_capability_family(80)
+        ) or super().supports_device_cpu_query_lens_mismatch()
+
     @staticmethod
     def get_name() -> str:
         return "DEEPSEEK_V41_INDEXER"
@@ -953,6 +960,22 @@ def _rocm_supports_flattened_device_query_lens(vllm_config: VllmConfig) -> bool:
     )
 
 
+def _sm80_adaptive_device_query_lens(vllm_config: VllmConfig) -> bool:
+    """Use device-built single-query rows for the Ampere V4.1 fallback."""
+    spec_config = vllm_config.speculative_config
+    if not (
+        spec_config is not None
+        and spec_config.enable_adaptive_verification
+        and current_platform.is_cuda()
+        and current_platform.is_device_capability_family(80)
+    ):
+        return False
+    model_config = vllm_config.model_config
+    return bool(
+        model_config is not None and model_config.hf_config.model_type == "deepseek_v41"
+    )
+
+
 def _supports_native_decode(next_n: int) -> bool:
     """Whether decode can pass `next_n` Q rows per request to the kernel
     instead of flattening to one single-token row per query, which re-reads
@@ -970,12 +993,16 @@ def _supports_native_decode(next_n: int) -> bool:
 def _use_flattening(vllm_config: VllmConfig) -> bool:
     speculative_config = vllm_config.speculative_config
     next_n = 1 + vllm_config.num_speculative_tokens
-    return not _supports_native_decode(next_n) or (
-        speculative_config is not None
-        and speculative_config.enable_adaptive_verification
-        and (
-            _supports_flattened_device_query_lens()
-            or _rocm_supports_flattened_device_query_lens(vllm_config)
+    return (
+        _sm80_adaptive_device_query_lens(vllm_config)
+        or not _supports_native_decode(next_n)
+        or (
+            speculative_config is not None
+            and speculative_config.enable_adaptive_verification
+            and (
+                _supports_flattened_device_query_lens()
+                or _rocm_supports_flattened_device_query_lens(vllm_config)
+            )
         )
     )
 
@@ -1030,6 +1057,16 @@ class DeepseekV32IndexerMetadataBuilder(AttentionMetadataBuilder):
         self.reorder_batch_threshold = None
         self.use_flattening = _use_flattening(self.vllm_config)
         self.supports_varlen = _supports_varlen_paged_mqa_logits()
+        # The Triton logits fallback consumes one query per expanded block-table
+        # row. Reuse the device metadata kernel without claiming DeepGEMM's
+        # native varlen logits support. Fixed-budget launches keep their old path.
+        self.use_device_decode_metadata = self.supports_varlen or (
+            _sm80_adaptive_device_query_lens(self.vllm_config)
+        )
+        if _sm80_adaptive_device_query_lens(self.vllm_config):
+            logger.info_once(
+                "SM80 adaptive indexer: device query metadata, single-query Triton rows"
+            )
         logger.info_once(
             "DSA indexer decode path: use_flattening=%s supports_varlen=%s "
             "(next_n=%d, use_fp4_cache=%s)",
@@ -1596,7 +1633,7 @@ class DeepseekV32IndexerMetadataBuilder(AttentionMetadataBuilder):
 
         decode_metadata = None
         if num_decodes > 0:
-            if not self.supports_varlen:
+            if not self.use_device_decode_metadata:
                 torch.diff(
                     common_attn_metadata.query_start_loc[: num_decodes + 1],
                     out=self.decode_lens_buffer[:num_decodes],
@@ -1639,7 +1676,7 @@ class DeepseekV32IndexerMetadataBuilder(AttentionMetadataBuilder):
                 and step_next_n_ok
             )
 
-            if not self.supports_varlen:
+            if not self.use_device_decode_metadata:
                 global_seq_lens_for_decode = self._prepare_global_decode_seq_lens(
                     global_seq_lens=global_seq_lens_for_decode,
                     decode_lens=decode_lens,
@@ -1651,7 +1688,7 @@ class DeepseekV32IndexerMetadataBuilder(AttentionMetadataBuilder):
                 )
 
             decode_indices = None
-            if self.supports_varlen:
+            if self.use_device_decode_metadata:
                 from vllm.v1.attention.ops.metadata import (
                     _indexer_decode_metadata_kernel,
                 )
