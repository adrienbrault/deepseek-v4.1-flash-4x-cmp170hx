+++ b/tests/v1/attention/test_sm80_adaptive_indexer.py
@@ -0,0 +1,47 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+from types import SimpleNamespace
+
+import pytest
+
+from vllm.platforms import current_platform
+from vllm.v1.attention.backends.mla import indexer
+
+
+@pytest.mark.parametrize("family", [8, 9, 10, 12])
+@pytest.mark.parametrize("adaptive", [False, True])
+@pytest.mark.parametrize("model_type", ["deepseek_v41", "deepseek_v32"])
+def test_sm80_device_metadata_is_scoped_to_adaptive_v41(
+    monkeypatch, family, adaptive, model_type
+):
+    monkeypatch.setattr(current_platform, "is_cuda", lambda: True)
+    monkeypatch.setattr(
+        current_platform, "is_device_capability_family", lambda n: n // 10 == family
+    )
+    config = SimpleNamespace(
+        speculative_config=SimpleNamespace(enable_adaptive_verification=adaptive),
+        model_config=SimpleNamespace(hf_config=SimpleNamespace(model_type=model_type)),
+    )
+    assert indexer._sm80_adaptive_device_query_lens(config) == (
+        family == 8 and adaptive and model_type == "deepseek_v41"
+    )
+
+
+def test_sm80_adaptive_flattens_even_a_two_row_verification(monkeypatch):
+    monkeypatch.setattr(current_platform, "is_cuda", lambda: True)
+    monkeypatch.setattr(current_platform, "is_rocm", lambda: False)
+    monkeypatch.setattr(
+        current_platform, "is_device_capability_family", lambda n: n == 80
+    )
+    monkeypatch.setattr(indexer, "is_deep_gemm_supported", lambda: False)
+    config = SimpleNamespace(
+        speculative_config=SimpleNamespace(enable_adaptive_verification=True),
+        model_config=SimpleNamespace(
+            hf_config=SimpleNamespace(model_type="deepseek_v41")
+        ),
+        num_speculative_tokens=1,
+    )
+    assert indexer.DeepseekV41IndexerBackend.supports_device_cpu_query_lens_mismatch()
+    assert indexer._use_flattening(config)
+    config.speculative_config.enable_adaptive_verification = False
+    assert not indexer._use_flattening(config)
diff --git a/vllm/v1/attention/backends/mla/indexer.py b/vllm/v1/attention/backends/mla/indexer.py
