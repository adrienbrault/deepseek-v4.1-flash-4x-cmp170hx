diff --git a/vllm/v1/worker/gpu/dsv41_tbo.py b/vllm/v1/worker/gpu/dsv41_tbo.py
new file mode 100644
index 0000000000..04015be700
--- /dev/null
+++ b/vllm/v1/worker/gpu/dsv41_tbo.py
@@ -0,0 +1,326 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Whole-request TP4 overlap; never split a non-causal DSpark query."""
+
+from dataclasses import replace
+from typing import Any, NamedTuple
+
+import numpy as np
+import torch
+
+from vllm.config import CUDAGraphMode
+from vllm.triton_utils import tl, triton
+from vllm.v1.worker.gpu.input_batch import InputBatch, InputBuffers
+from vllm.v1.worker.gpu.ubatch_utils import UBatchRunner
+from vllm.v1.worker.ubatch_utils import UBatchSlice
+
+
+def tbo_shape(num_reqs: int, query_len: int) -> tuple[int, int]:
+    """Equal request slots and worst-case row capacity, including odd batches."""
+    padded_reqs = 2 * ((num_reqs + 1) // 2)
+    return padded_reqs, padded_reqs * query_len
+
+
+@triton.jit
+def _pack_rows(
+    Src,
+    Dst,
+    Qloc,
+    START: tl.constexpr,
+    STOP: tl.constexpr,
+    REAL_REQS: tl.constexpr,
+    ROWS: tl.constexpr,
+    WIDTH: tl.constexpr,
+    SRC_STRIDE: tl.constexpr,
+    DST_STRIDE: tl.constexpr,
+    PAD: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    cols = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    start = tl.load(Qloc + min(START, REAL_REQS))
+    end = tl.load(Qloc + min(STOP, REAL_REQS))
+    value = tl.load(
+        Src + (start + row) * SRC_STRIDE + cols,
+        (row < end - start) & (cols < WIDTH),
+        other=PAD,
+    )
+    tl.store(Dst + row * DST_STRIDE + cols, value, cols < WIDTH)
+
+
+def pack_rows(src, dst, qloc, start, stop, real_reqs, pad=0):
+    width = src[0].numel() if src.ndim > 1 else 1
+    _pack_rows[(dst.shape[0], triton.cdiv(width, 256))](
+        src,
+        dst,
+        qloc,
+        start,
+        stop,
+        real_reqs,
+        dst.shape[0],
+        width,
+        src.stride(0),
+        dst.stride(0),
+        pad,
+        256,
+    )
+
+
+@triton.jit
+def _unpack_rows(
+    Src,
+    Dst,
+    Qloc,
+    SPLIT: tl.constexpr,
+    REAL_REQS: tl.constexpr,
+    CAPACITY: tl.constexpr,
+    WIDTH: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    cols = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    split = tl.load(Qloc + SPLIT)
+    end = tl.load(Qloc + REAL_REQS)
+    source_row = tl.where(row < split, row, CAPACITY + row - split)
+    value = tl.load(
+        Src + source_row * WIDTH + cols, (row < end) & (cols < WIDTH), other=0
+    )
+    tl.store(Dst + row * WIDTH + cols, value, cols < WIDTH)
+
+
+def unpack_rows(src, qloc, split, real_reqs):
+    out = torch.empty_like(src)
+    width = src[0].numel()
+    _unpack_rows[(src.shape[0], triton.cdiv(width, 256))](
+        src, out, qloc, split, real_reqs, src.shape[0] // 2, width, 256
+    )
+    return out
+
+
+class TBOState(NamedTuple):
+    slices: list[UBatchSlice]
+    forward_contexts: list[Any]
+    batches: list[InputBatch]
+    parent: InputBatch
+
+
+class DSV41TBORunner(UBatchRunner):
+    """Reuse DBO's cooperative threads, event handoffs and FULL graph capture.
+
+    Each half owns whole requests and has a persistent packed input buffer.
+    Device query offsets, including r9's reallocation, drive packing/unpacking.
+    """
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        config = self.vllm_config
+        self.query_len = config.num_speculative_tokens + 1
+        slots, rows = tbo_shape(config.scheduler_config.max_num_seqs, self.query_len)
+        self.inputs = [
+            InputBuffers(slots // 2, rows // 2, self.device) for _ in range(2)
+        ]
+        groups = len(self.kv_cache_config.kv_cache_groups)
+        self.slots = [
+            torch.empty((groups, rows // 2), dtype=torch.int64, device=self.device)
+            for _ in range(2)
+        ]
+
+    def prepare(
+        self,
+        input_batch,
+        block_tables,
+        slot_mappings,
+        cg_mode=CUDAGraphMode.NONE,
+        for_capture=False,
+    ):
+        parent = input_batch
+        reqs = parent.num_reqs_after_padding
+        assert reqs % 2 == 0 and reqs >= 2 and not parent.has_prefill
+        parent.query_start_loc[parent.num_reqs + 1 :].copy_(
+            parent.query_start_loc[parent.num_reqs].expand(reqs - parent.num_reqs)
+        )
+        half = reqs // 2
+        capacity = parent.num_tokens_after_padding // 2
+        assert capacity == half * self.query_len
+        batches, slices, metadata, mappings, padding = [], [], [], [], []
+        for i in range(2):
+            lo, hi = i * half, (i + 1) * half
+            real_lo, real_hi = min(lo, parent.num_reqs), min(hi, parent.num_reqs)
+            buf = self.inputs[i]
+            qloc = buf.query_start_loc[: half + 1]
+            # Clamp padded request slots to the real end, on the device too.
+            indices = torch.arange(lo, hi + 1, device=self.device).clamp_(
+                max=parent.num_reqs
+            )
+            torch.index_select(parent.query_start_loc, 0, indices, out=qloc)
+            qloc.sub_(parent.query_start_loc[real_lo])
+            qloc_np = parent.query_start_loc_np[
+                np.minimum(np.arange(lo, hi + 1), parent.num_reqs)
+            ]
+            qloc_np = qloc_np - qloc_np[0]
+            seq_lens = buf.seq_lens[:half]
+            seq_lens.copy_(parent.seq_lens[lo:hi])
+            slots = self.slots[i][:, :capacity]
+            ids, pos, pad = (
+                buf.input_ids[:capacity],
+                buf.positions[:capacity],
+                buf.is_padding[:capacity],
+            )
+            for src, dst, fill in (
+                (parent.input_ids, ids, 0),
+                (parent.positions, pos, 0),
+                (parent.is_padding, pad, True),
+            ):
+                pack_rows(
+                    src, dst, parent.query_start_loc, lo, hi, parent.num_reqs, fill
+                )
+            for group in range(slots.shape[0]):
+                pack_rows(
+                    slot_mappings[group],
+                    slots[group],
+                    parent.query_start_loc,
+                    lo,
+                    hi,
+                    parent.num_reqs,
+                    -1,
+                )
+            batch = replace(
+                parent,
+                req_ids=parent.req_ids[real_lo:real_hi],
+                num_reqs=real_hi - real_lo,
+                num_reqs_after_padding=half,
+                idx_mapping=parent.idx_mapping[lo:hi],
+                idx_mapping_np=parent.idx_mapping_np[lo:hi],
+                num_scheduled_tokens=parent.num_scheduled_tokens[real_lo:real_hi],
+                num_tokens=int(qloc_np[-1]),
+                num_tokens_after_padding=capacity,
+                query_start_loc=qloc,
+                query_start_loc_np=qloc_np,
+                seq_lens=seq_lens,
+                seq_lens_cpu_upper_bound=parent.seq_lens_cpu_upper_bound[lo:hi],
+                num_computed_tokens_np=parent.num_computed_tokens_np[real_lo:real_hi],
+                prefill_len_np=parent.prefill_len_np[real_lo:real_hi],
+                num_computed_prefill_tokens_np=(
+                    parent.num_computed_prefill_tokens_np[real_lo:real_hi]
+                ),
+                is_prefilling_np=parent.is_prefilling_np[real_lo:real_hi],
+                input_ids=ids,
+                positions=pos,
+                is_padding=pad,
+                max_query_len=self.query_len,
+                fast_prefill=None,
+            )
+            batches.append(batch)
+            slices.append(
+                UBatchSlice(slice(lo, hi), slice(i * capacity, (i + 1) * capacity))
+            )
+            metadata.append(
+                self.model_state.prepare_attn(
+                    batch,
+                    cg_mode,
+                    tuple(t[lo:hi] for t in block_tables),
+                    slots,
+                    self.attn_groups,
+                    self.kv_cache_config,
+                    ubatch_idx=i,
+                    for_capture=for_capture,
+                )
+            )
+            from vllm.v1.worker.gpu.attn_utils import build_slot_mappings_by_layer
+
+            mappings.append(build_slot_mappings_by_layer(slots, self.kv_cache_config))
+            padding.append(pad)
+        return TBOState(
+            slices,
+            self._make_forward_contexts(slices, metadata, mappings, padding),
+            batches,
+            parent,
+        )
+
+    def slice_inputs(self, model_inputs, state, index):
+        batch = state.batches[index]
+        inputs = dict(
+            model_inputs, input_ids=batch.input_ids, positions=batch.positions
+        )
+        lookback = inputs.get("lookback_token_ids")
+        if lookback is not None:
+            inputs["lookback_token_ids"] = lookback[state.slices[index].request_slice]
+        return inputs
+
+    def merge_outputs(self, outputs, state, model):
+        from vllm.v1.worker.gpu.ubatch_utils import merge_ubatch_outputs
+
+        merged = merge_ubatch_outputs(outputs)
+        split = state.slices[0].request_slice.stop
+        qloc, reqs = state.parent.query_start_loc, state.parent.num_reqs
+
+        def unpack(value):
+            return unpack_rows(value, qloc, split, reqs)
+
+        mtp = model.get_mtp_target_hidden_states()
+        if mtp is not None:
+            rows = state.parent.num_tokens_after_padding
+            mtp[:rows].copy_(unpack(mtp[:rows]))
+        if isinstance(merged, tuple):
+            return tuple(unpack(value) for value in merged)
+        return unpack(merged)
+
+
+def check_live_tbo(model, inputs, candidate, batch, metadata, mappings, config):
+    """Expensive qualification only: compare real EXL3 outputs and MTP states.
+
+    Rewriting this step's same KV slots with identical inputs is idempotent.
+    Copy candidate MTP back afterwards so the drafter consumes the tested path.
+    Greedy token parity is a separate mandatory end-to-end gate.
+    """
+    import json
+    import os
+    from pathlib import Path
+
+    from vllm.distributed import get_tp_group
+    from vllm.forward_context import set_forward_context
+
+    assert isinstance(candidate, torch.Tensor)
+    tested = candidate.clone()
+    rows = batch.num_tokens_after_padding
+    mtp_buffer = model.get_mtp_target_hidden_states()
+    mtp = mtp_buffer[:rows].clone() if mtp_buffer is not None else None
+    with set_forward_context(
+        metadata,
+        config,
+        num_tokens=rows,
+        cudagraph_runtime_mode=CUDAGraphMode.NONE,
+        slot_mapping=mappings,
+        is_padding=batch.is_padding,
+    ):
+        reference = model(**inputs)
+    valid = ~batch.is_padding
+
+    def error(a, b):
+        a, b = a[valid].float(), b[valid].float()
+        return {
+            "bit_equal": bool(torch.equal(a, b)),
+            "max_abs": float((a - b).abs().max()),
+            "rms": float((a - b).square().mean().sqrt()),
+            "pass": bool(torch.allclose(a, b, atol=0.01, rtol=0.01)),
+        }
+
+    receipt = {
+        "rows": rows,
+        "requests": batch.num_reqs,
+        "query_lens": torch.diff(batch.query_start_loc[: batch.num_reqs + 1])
+        .cpu()
+        .tolist(),
+        "output": error(tested, reference),
+    }
+    if mtp is not None:
+        receipt["mtp"] = error(mtp, mtp_buffer[:rows])
+        mtp_buffer[:rows].copy_(mtp)
+    rank = get_tp_group().rank_in_group
+    directory = Path(os.environ.get("DSV41_TBO_CHECK_DIR", "/results/tbo-check"))
+    directory.mkdir(parents=True, exist_ok=True)
+    with (directory / f"rank{rank}.jsonl").open("a") as stream:
+        stream.write(json.dumps(receipt) + "\n")
+    assert all(
+        value["pass"] for value in receipt.values() if isinstance(value, dict)
+    ), receipt
