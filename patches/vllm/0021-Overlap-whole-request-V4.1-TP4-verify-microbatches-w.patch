+def test_dsv41_tbo_keeps_whole_requests_with_device_trimmed_lengths(monkeypatch):
+    """Host upper bounds must not decide the split of a compacted GPU batch."""
+    from vllm.v1.worker.gpu import dsv41_tbo as tbo
+    from vllm.v1.worker.gpu.input_batch import InputBatch, InputBuffers
+
+    runner = tbo.DSV41TBORunner.__new__(tbo.DSV41TBORunner)
+    runner.device = torch.device("cpu")
+    runner.query_len = 6
+    runner.inputs = [InputBuffers(4, 24, runner.device) for _ in range(2)]
+    runner.slots = [torch.empty((1, 24), dtype=torch.int64) for _ in range(2)]
+    runner.attn_groups = []
+    runner.kv_cache_config = SimpleNamespace(kv_cache_groups=[None])
+    runner.model_state = SimpleNamespace(prepare_attn=lambda *a, **k: a[0])
+    runner._make_forward_contexts = lambda slices, meta, slots, pad: meta
+
+    def cpu_pack(src, dst, qloc, start, stop, real_reqs, pad=0):
+        lo, hi = qloc[min(start, real_reqs)], qloc[min(stop, real_reqs)]
+        dst.fill_(pad)
+        dst[: hi - lo].copy_(src[lo:hi])
+
+    monkeypatch.setattr(tbo, "pack_rows", cpu_pack)
+    for reqs, lengths in (
+        (2, [1, 6]),
+        (3, [6, 1, 2]),
+        (4, [1, 2, 3, 1]),
+        (7, [1, 6, 2, 5, 3, 4, 1]),
+        (8, [6] * 8),
+    ):
+        padded_reqs, rows = tbo.tbo_shape(reqs, 6)
+        buffers = InputBuffers(padded_reqs, rows, runner.device)
+        batch = InputBatch.make_dummy(padded_reqs, rows, buffers, max_query_len=6)
+        batch.num_reqs = reqs
+        batch.req_ids = batch.req_ids[:reqs]
+        # Host still describes all six scheduled verification rows per request.
+        # Device offsets instead describe adaptive reallocation and padding.
+        qloc = torch.tensor([0, *np.cumsum(lengths)], dtype=torch.int32)
+        batch.query_start_loc[: reqs + 1].copy_(qloc)
+        batch.input_ids.copy_(torch.arange(rows))
+        batch.positions.copy_(torch.arange(rows) + 100)
+        batch.is_padding.copy_(torch.arange(rows) >= sum(lengths))
+        slots = torch.arange(rows, dtype=torch.int64).view(1, -1)
+        state = runner.prepare(
+            batch,
+            (torch.arange(padded_reqs).view(-1, 1),),
+            slots,
+            cg_mode=CUDAGraphMode.FULL,
+        )
+        half = padded_reqs // 2
+        assert int(state.batches[0].query_start_loc[-1]) == sum(lengths[:half])
+        assert int(state.batches[1].query_start_loc[-1]) == sum(lengths[half:])
+        for i, sub in enumerate(state.batches):
+            lo, hi = sum(lengths[: i * half]), sum(lengths[: (i + 1) * half])
+            assert sub.input_ids[: hi - lo].tolist() == list(range(lo, hi))
+            assert not sub.is_padding[: hi - lo].any()
+            assert sub.is_padding[hi - lo :].all()
+            assert runner.slots[i][0, : hi - lo].tolist() == list(range(lo, hi))
+            assert (runner.slots[i][0, hi - lo : rows // 2] == -1).all()
+            expected = [0, *np.cumsum(lengths[i * half : (i + 1) * half])]
+            expected += [expected[-1]] * (half + 1 - len(expected))
+            assert sub.query_start_loc.tolist() == expected
+
+
+def test_dsv41_tbo_graphs_belong_only_to_the_target_runner(monkeypatch):
+    """The DSpark drafter shares config but has no threaded microbatch runner."""
+    from collections import defaultdict
+    from types import MethodType
+
+    from vllm.v1.worker.gpu.dsv41_tbo import tbo_shape
+
+    monkeypatch.setattr(cudagraph_utils.envs, "VLLM_DSV41_TBO", True)
+    mode = CUDAGraphMode
+    for target in (False, True):
+        manager = SimpleNamespace(
+            compilation_config=SimpleNamespace(
+                cudagraph_capture_sizes=list(range(1, 49)),
+                max_cudagraph_capture_size=48,
+            ),
+            max_num_reqs=8,
+            decode_query_len=6,
+            cudagraph_mode=mode.FULL_DECODE_ONLY,
+            varlen_decode=True,
+            vllm_config=SimpleNamespace(
+                speculative_config=None,
+                cache_config=SimpleNamespace(use_kda_recoverssm=False),
+            ),
+            lora_capture_cases=[0],
+            _capture_descs=defaultdict(list),
+            _candidates={},
+            ubatch_runner=object() if target else None,
+            _maybe_ubatch_twin=lambda desc: None,
+        )
+        manager._init_tbo_candidates = MethodType(
+            cudagraph_utils.CudaGraphManager._init_tbo_candidates, manager
+        )
+        cudagraph_utils.CudaGraphManager._init_candidates(manager)
+        tbo = [
+            desc for desc in manager._capture_descs[mode.FULL] if desc.num_ubatches == 2
+        ]
+        assert sorted((d.num_reqs, d.num_tokens) for d in tbo) == (
+            [tbo_shape(reqs, 6) for reqs in (2, 4, 6, 8)] if target else []
+        )
+
+        if target:
+            manager._graphs_captured = True
+            manager._resolve_effective_loras = lambda n: n
+            for reqs, rows in ((2, 7), (3, 13), (4, 17), (7, 29), (8, 37)):
+                desc = cudagraph_utils.CudaGraphManager.dispatch(
+                    manager, reqs, rows, None, 0, max_query_len=6, num_ubatches=2
+                )
+                assert (desc.num_reqs, desc.num_tokens) == tbo_shape(reqs, 6)
