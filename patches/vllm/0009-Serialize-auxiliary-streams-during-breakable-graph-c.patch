From 604dd844bb56ba27d3da52149aea25166b23c202 Mon Sep 17 00:00:00 2001
From: Adrien Brault <adrien.brault@gmail.com>
Date: Tue, 20 Oct 2026 19:26:43 +0200
Subject: [PATCH 09/10] Serialize auxiliary streams during breakable graph
 capture

Match the two-stream helper when capturing a breakable segment: run
auxiliary projections on the current stream so capture cannot cross an
eager break with pending side-stream work.

Origin: dsv41reap-pp
Upstream: none
---
 vllm/utils/multi_stream_utils.py | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/vllm/utils/multi_stream_utils.py b/vllm/utils/multi_stream_utils.py
index 5cb7f00f76..5ea2b6170f 100644
--- a/vllm/utils/multi_stream_utils.py
+++ b/vllm/utils/multi_stream_utils.py
@@ -108,6 +108,12 @@ def execute_in_parallel(
         result of aux_fns[i] (or None when skipped).
 
     """
+    if aux_streams is not None and enable:
+        from vllm.compilation.breakable_cudagraph import BreakableCUDAGraphCapture
+
+        if BreakableCUDAGraphCapture.is_active():
+            aux_streams = None
+
     aux_results: list[Any]
     if aux_streams is None or not enable:
         default_result = default_fn()
