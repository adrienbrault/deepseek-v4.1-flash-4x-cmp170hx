+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU math gates. Run directly to avoid importing the GPU-only vLLM package.
+
+Contract: shards plus shared draws produce the same token/prefix as a dense
+reference. Exercise the production math, with four synchronized CPU ranks;
+catch missing tail mass, token-id RNG mistakes, padding and q/residual errors.
+"""
+
+import importlib.util
+import unittest
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+from threading import Barrier
+
+import torch
+
+_PATH = Path(__file__).resolve().parents[3] / (
+    "vllm/v1/worker/gpu/sample/distributed.py"
+)
+_spec = importlib.util.spec_from_file_location("tp_sampling_math", _PATH)
+math = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(math)
+torch.set_num_threads(1)
+
+
+class Collective:
+    def __init__(self, ranks):
+        self.barrier = Barrier(ranks, timeout=30)
+        self.values = [None] * ranks
+
+    def group(self, rank):
+        parent = self
+
+        class Group:
+            def exchange(self, x, reduce, dim=-1):
+                parent.values[rank] = x
+                parent.barrier.wait()
+                out = (
+                    torch.stack(parent.values).sum(0)
+                    if reduce
+                    else torch.cat(parent.values, dim)
+                )
+                parent.barrier.wait()
+                return out
+
+            def all_gather(self, x, dim=-1):
+                return self.exchange(x, False, dim)
+
+            def all_reduce(self, x):
+                return self.exchange(x, True)
+
+        return Group()
+
+
+def run_ranks(logits, operation, ranks=4):
+    width = (logits.shape[-1] + ranks - 1) // ranks
+    padded = torch.nn.functional.pad(
+        logits, (0, width * ranks - logits.shape[-1]), value=10000
+    )
+    collective = Collective(ranks)
+
+    def run(rank):
+        start = rank * width
+        sampler = math.VocabParallelSampler(
+            collective.group(rank), start, logits.shape[-1]
+        )
+        local = sampler.mask_padding(padded[:, start : start + width])
+        return operation(sampler, local, start)
+
+    with ThreadPoolExecutor(ranks) as pool:
+        results = list(pool.map(run, range(ranks)))
+    return results
+
+
+def noise(shape, seed=42):
+    u = torch.rand(shape, generator=torch.Generator().manual_seed(seed)).double()
+    return -(-u.clamp_min(1e-15).log()).log()
+
+
+def draw_for(noise_tensor, start):
+    def draw(x):
+        n = torch.nn.functional.pad(
+            noise_tensor[:, start : start + x.shape[-1]],
+            (0, max(0, start + x.shape[-1] - noise_tensor.shape[-1])),
+        )
+        value, ids = (x.double() + n).max(-1)
+        return value, ids + start
+
+    return draw
+
+
+def dense_filter(logits, k, p):
+    values, ids = logits.sort(dim=-1, descending=True, stable=True)
+    threshold = values.gather(-1, (k.long() - 1)[:, None])
+    values = values.masked_fill(values < threshold, -torch.inf)
+    mass = values.double().softmax(-1)
+    keep = (p[:, None] >= 1) | (mass.cumsum(-1) - mass < p[:, None])
+    values = values.masked_fill(~keep, -torch.inf)
+    return torch.full_like(logits, -torch.inf).scatter(-1, ids, values)
+
+
+class SamplingMathTest(unittest.TestCase):
+    def test_greedy_ties_and_padding_use_lowest_global_id(self):
+        x = torch.zeros(5, 129)
+        x[1, [1, 66, 128]] = 10
+        x[2, 128] = 11
+        x[3] = -torch.inf
+        results = run_ranks(
+            x,
+            lambda s, local, start: s.sample(
+                local, lambda a: (a.max(-1).values, a.argmax(-1) + start)
+            ),
+        )
+        for result in results:
+            torch.testing.assert_close(result, x.argmax(-1), rtol=0, atol=0)
+
+    def test_seeded_gumbel_is_invariant_to_partition(self):
+        x = torch.randn(71, 137, generator=torch.Generator().manual_seed(7))
+        n = noise(x.shape)
+        expected = (x.double() + n).argmax(-1)
+        for result in run_ranks(x, lambda s, a, start: s.sample(a, draw_for(n, start))):
+            torch.testing.assert_close(result, expected, rtol=0, atol=0)
+
+    def test_real_vocab_six_verify_rows_pack_float32_token_ids_exactly(self):
+        x = torch.randn(6, 129280, generator=torch.Generator().manual_seed(5))
+        n = noise(x.shape).float()
+
+        def sample(s, a, start):
+            def draw(local):
+                value, ids = (local + n[:, start : start + local.shape[-1]]).max(-1)
+                return value, ids + start
+
+            return s.sample(a, draw)
+
+        for result in run_ranks(x, sample):
+            torch.testing.assert_close(result, (x + n).argmax(-1), rtol=0, atol=0)
+
+    def test_temperature_distribution_matches_softmax(self):
+        x = torch.tensor([0.1, -1.2, 0.8, 1.6]).repeat(24000, 1) / 0.7
+        n = noise(x.shape)
+        result = run_ranks(x, lambda s, a, start: s.sample(a, draw_for(n, start)))[0]
+        expected = x[0].double().softmax(-1)
+        freq = result.bincount(minlength=4).double() / x.shape[0]
+        sigma = (expected * (1 - expected) / x.shape[0]).sqrt()
+        self.assertTrue(bool(((freq - expected).abs() < 6 * sigma).all()))
+
+    def test_bounded_topk_keeps_cutoff_ties(self):
+        x = torch.arange(129).float().repeat(3, 1)
+        x[:, 126:128] = 128
+        k, p = torch.tensor([1, 4, 8]), torch.ones(3)
+        expected = dense_filter(x, k, p)
+        results = run_ranks(x, lambda s, a, start: s.filter(a, k, p, 16))
+        actual = torch.cat(results, -1)[:, :129]
+        torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+
+    def test_topp_coverage_and_combined_topk(self):
+        x = torch.arange(129).float().repeat(3, 1)
+        k, p = torch.tensor([129, 4, 129]), torch.tensor([0.9, 0.8, 0.5])
+        expected = dense_filter(x, k, p)
+        results = run_ranks(x, lambda s, a, start: s.filter(a, k, p, 8))
+        self.assertTrue(all(a is not None for a in results))
+        torch.testing.assert_close(torch.cat(results, -1)[:, :129], expected)
+
+    def test_insufficient_mass_ties_and_boundary_fall_back(self):
+        for x, k, p in (
+            (torch.zeros(2, 129), torch.full((2,), 129), torch.full((2,), 0.99)),
+            (torch.zeros(2, 129), torch.ones(2), torch.ones(2)),
+            (
+                torch.arange(129).float().repeat(2, 1),
+                torch.full((2,), 80),
+                torch.ones(2),
+            ),
+            (torch.zeros(2, 128), torch.full((2,), 128), torch.full((2,), 0.5)),
+        ):
+            results = run_ranks(x, lambda s, a, start, k=k, p=p: s.filter(a, k, p, 4))
+            self.assertTrue(all(a is None for a in results))
+
+    def test_log_partition_and_owning_token_at_extreme_logits(self):
+        x = torch.randn(7, 129) * 500
+        tokens = torch.tensor([0, 31, 32, 65, 98, 127, 128])
+        results = run_ranks(
+            x, lambda s, a, start: (s.lse(a), s.token_logprob(a, tokens, s.lse(a)))
+        )
+        for lse, lp in results:
+            torch.testing.assert_close(lse, x.double().logsumexp(-1, keepdim=True))
+            torch.testing.assert_close(
+                lp, x.double().log_softmax(-1).gather(-1, tokens[:, None]).squeeze(-1)
+            )
+
+    def test_rejection_dense_and_four_ranks_variable_lengths(self):
+        g = torch.Generator().manual_seed(91)
+        x, q = torch.randn(10, 129, generator=g), torch.randn(10, 129, generator=g)
+        proposed = torch.tensor([0, 45, 128, -1, 31, 98, 65, 12, 127, -1])
+        cu = torch.tensor([0, 4, 5, 8, 10])
+        bonus = torch.zeros(10, dtype=torch.bool)
+        bonus[cu[1:] - 1] = True
+        greedy = torch.tensor([False] * 5 + [True] * 5)
+        u, n = torch.rand(10, generator=g), noise(x.shape, 9)
+        # Greedy rows use zero noise; the stochastic reference uses the same
+        # global-token-indexed noise on every rank.
+        n[greedy] = 0
+        for draft in (None, q):
+
+            def verify(s, a, start, draft=draft):
+                local_q = None
+                if draft is not None:
+                    local_q = torch.nn.functional.pad(
+                        draft[:, start : start + a.shape[-1]],
+                        (0, max(0, start + a.shape[-1] - 129)),
+                        value=-torch.inf,
+                    )
+                return s.verify(
+                    a, local_q, proposed, bonus, greedy, u, draw_for(n, start), cu, 5
+                )
+
+            expected = run_ranks(x, verify, ranks=1)[0]
+            for output, count in run_ranks(x, verify):
+                torch.testing.assert_close(output, expected[0], rtol=0, atol=0)
+                torch.testing.assert_close(count, expected[1], rtol=0, atol=0)
+                self.assertTrue(bool((count <= cu.diff()).all()))
+
+    def test_probabilistic_rejection_preserves_target_distribution(self):
+        nreq = 24000
+        p = torch.tensor([0.05, 0.25, 0.4, 0.3])
+        q = torch.tensor([0.4, 0.3, 0.1, 0.2])
+        g = torch.Generator().manual_seed(123)
+        proposed = torch.multinomial(q, nreq, replacement=True, generator=g)
+        tokens = torch.stack((proposed, torch.zeros_like(proposed)), -1).flatten()
+        x = p.log().repeat(2 * nreq, 1)
+        draft = q.log().repeat(2 * nreq, 1)
+        bonus = torch.arange(2 * nreq) % 2 == 1
+        cu = torch.arange(nreq + 1) * 2
+        u, n = torch.rand(2 * nreq, generator=g), noise(x.shape, 21)
+
+        def verify(s, a, start):
+            return s.verify(
+                a,
+                draft[:, start : start + 1],
+                tokens,
+                bonus,
+                torch.zeros_like(bonus),
+                u,
+                draw_for(n, start),
+                cu,
+                1,
+            )
+
+        output = run_ranks(x, verify)[0][0][:, 0]
+        freq = output.bincount(minlength=4).float() / nreq
+        sigma = (p * (1 - p) / nreq).sqrt()
+        self.assertTrue(bool(((freq - p).abs() < 6 * sigma).all()))
+
+
+if __name__ == "__main__":
+    unittest.main()
