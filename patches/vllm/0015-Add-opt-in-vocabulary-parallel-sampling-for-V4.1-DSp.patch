+    if vocab_size > 2**24:
+        return None
+    parallel = VocabParallelSampler(group, start, vocab_size)
+    logits = parallel.mask_padding(
+        model.compute_logits_local(hidden_states[batch.logits_indices])
+    ).float()
+    mapping = batch.expanded_idx_mapping
+    temp = states.temperature.gpu[mapping]
+    greedy = temp == 0
