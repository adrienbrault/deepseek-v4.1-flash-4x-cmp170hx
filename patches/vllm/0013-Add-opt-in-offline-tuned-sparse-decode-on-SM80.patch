+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Dependency-free policy and exhaustive software-codec checks."""
+
+import ast
+import importlib.util
+import math
+import os
+import struct
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[3]
+OPS = ROOT / "vllm/v1/attention/ops"
+spec = importlib.util.spec_from_file_location(
+    "sm80_sparse_config_cpu", OPS / "sm80_sparse_config.py"
+)
+config = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = config
+spec.loader.exec_module(config)
+
+
+def scalar_cast(value, dtype, bitcast=False):
+    if bitcast:
+        fmt_in, fmt_out = ("I", "f") if dtype == "float32" else ("f", "I")
+        return struct.unpack("<" + fmt_out, struct.pack("<" + fmt_in, value))[0]
+    return float(value) if dtype == "float32" else int(value)
+
+
+class ScalarCasts(ast.NodeTransformer):
+    def visit_Call(self, node):
+        node = self.generic_visit(node)
+        if isinstance(node.func, ast.Attribute) and node.func.attr == "to":
+            return ast.copy_location(
+                ast.Call(
+                    func=ast.Name(id="scalar_cast", ctx=ast.Load()),
+                    args=[node.func.value, *node.args],
+                    keywords=node.keywords,
+                ),
+                node,
+            )
+        return node
+
+
+def load_scalar_decoder():
+    # Execute the actual JIT function body with scalar casts, rather than a
+    # second implementation of the bit trick. The oracle below uses E4M3 math.
+    module = ast.parse((OPS / "fp8_sm80.py").read_text())
+    fn = next(
+        n
+        for n in module.body
+        if isinstance(n, ast.FunctionDef) and n.name == "_e4m3fn_to_f32_bits"
+    )
+    fn.decorator_list = []
+    module = ast.fix_missing_locations(
+        ScalarCasts().visit(ast.Module(body=[fn], type_ignores=[]))
+    )
+    scope = dict(
+        scalar_cast=scalar_cast,
+        tl=SimpleNamespace(
+            uint32="uint32", float32="float32", where=lambda c, a, b: a if c else b
+        ),
+    )
+    exec(compile(module, "fp8_sm80", "exec"), scope)
+    return scope[fn.name]
+
+
+def load_launcher():
+    """Exercise the actual launcher with tensors that cannot read device data."""
+    source = ast.parse((OPS / "rocm_aiter_mla_sparse.py").read_text())
+    fn = next(
+        n
+        for n in source.body
+        if isinstance(n, ast.FunctionDef)
+        and (n.name == "_rocm_sparse_attn_decode_ragged_triton")
+    )
+    launches = []
+
+    class Tensor:
+        is_cpu = False
+        dtype = "bf16"
+        device = SimpleNamespace(index=0)
+
+        def __init__(self, shape):
+            self.shape = (shape,) if isinstance(shape, int) else shape
+            self.ndim = len(self.shape)
+
+        def numel(self):
+            return math.prod(self.shape)
+
+        def stride(self, dim):
+            return math.prod(self.shape[dim + 1 :])
+
+        def contiguous(self):
+            return self
+
+    class Kernel:
+        def __init__(self, name):
+            self.name = name
+
+        def __getitem__(self, grid):
+            return lambda *args, **kwargs: launches.append((self.name, grid, kwargs))
+
+    scope = dict(
+        torch=SimpleNamespace(
+            empty=lambda shape, **kwargs: Tensor(shape),
+            empty_like=lambda x, **kwargs: Tensor(x.shape),
+            zeros=lambda size, **kwargs: Tensor((size,)),
+            float32="f32",
+            int32="i32",
+            bfloat16="bf16",
+        ),
+        triton=SimpleNamespace(
+            cdiv=lambda x, y: (x + y - 1) // y,
+            next_power_of_2=lambda x: 1 << (x - 1).bit_length(),
+        ),
+        current_platform=SimpleNamespace(
+            is_cuda=lambda: True,
+            is_device_capability=lambda _: True,
+            is_fp8_fnuz=lambda: False,
+        ),
+        sparse_decode_enabled=lambda: False,
+        _ON_GFX942=False,
+        _ON_GFX950=False,
+        _as_int32_contiguous_1d=lambda x: x,
+        _validate_dsv4_sparse_dims=lambda *args: None,
+        rocm_inverse_rope_rows_=lambda *args: launches.append(("rope", None, {})),
+    )
+    for name in (
+        "_sparse_attn_decode_ragged_kernel",
+        "_sparse_attn_decode_partial_kernel",
+        "_sparse_attn_decode_reduce_kernel",
+    ):
+        scope[name] = Kernel(name)
+    future = ast.ImportFrom(
+        module="__future__", names=[ast.alias(name="annotations")], level=0
+    )
+    module = ast.fix_missing_locations(ast.Module(body=[future, fn], type_ignores=[]))
+    exec(compile(module, "sparse-launcher", "exec"), scope)
+    inputs = dict(
+        q=Tensor((6, 16, 512)),
+        main_cache=Tensor((8, 64, 584)),
+        main_indices=Tensor((6 * 128,)),
+        main_indptr=Tensor((7,)),
+        extra_cache=Tensor((16, 64, 584)),
+        extra_indices=Tensor((6 * 512,)),
+        extra_indptr=Tensor((7,)),
+        attn_sink=None,
+        scale=512**-0.5,
+        nope_head_dim=448,
+        rope_head_dim=64,
+    )
+    return scope[fn.name], inputs, launches, Tensor
+
+
+class TestSm80SparseCPU(unittest.TestCase):
+    def test_all_fp8_bytes_including_signed_zero_and_nan(self):
+        decode = load_scalar_decoder()
+        for byte in range(256):
+            sign = -1.0 if byte & 128 else 1.0
+            exponent, mantissa = (byte >> 3) & 15, byte & 7
+            actual = decode(byte)
+            if exponent == 15 and mantissa == 7:
+                self.assertTrue(math.isnan(actual))
+                continue
+            expected = sign * (
+                math.ldexp(mantissa / 8, -6)
+                if exponent == 0
+                else math.ldexp(1 + mantissa / 8, exponent - 7)
+            )
+            self.assertEqual(struct.pack("<f", actual), struct.pack("<f", expected))
+
+    def test_opt_in_is_frozen_until_restart(self):
+        config.sparse_decode_enabled.cache_clear()
+        with patch.dict(os.environ, {}, clear=True):
+            self.assertFalse(config.sparse_decode_enabled())
+            os.environ["VLLM_SM80_SPARSE_DECODE"] = "1"
+            self.assertFalse(config.sparse_decode_enabled())
+            config.sparse_decode_enabled.cache_clear()
+            self.assertTrue(config.sparse_decode_enabled())
+        config.sparse_decode_enabled.cache_clear()
+
+    def test_exact_shape_overrides_and_untuned_shape_fallback(self):
+        tuned = config.SparseDecodeConfig(block_k=16, splits=4, decode="lut")
+        table = {"configs": {config.shape_key(6, 16, 128, 512): tuned.to_dict()}}
+        self.assertEqual(config.select_config(6, 16, 128, 512, 70, table), tuned)
+        self.assertEqual(
+            config.select_config(5, 16, 128, 512, 70, table).decode, "bits"
+        )
+        self.assertEqual(config.select_config(48, 64, 128, 512, 70, {}).splits, 1)
+
+    def test_all_adaptive_rows_and_device_sizes_have_bounded_splits(self):
+        for rows in range(1, 49):
+            for heads in (16, 64):
+                for sms in (70, 74, 108):
+                    for topk in (0, 1, 512):
+                        chosen = config.select_config(rows, heads, 128, topk, sms, {})
+                        self.assertIn(chosen.splits, range(1, 17))
+                        self.assertLessEqual(chosen.splits, (128 + topk + 31) // 32)
+
+    def test_table_validation_rejects_unsafe_launches(self):
+        for kwargs in (
+            {"splits": 0},
+            {"splits": 1.0},
+            {"block_k": 7},
+            {"decode": "native"},
+        ):
+            with self.assertRaises(ValueError):
+                config.SparseDecodeConfig(**kwargs)
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / "table.json"
+            path.write_text('{"version": 0, "configs": {}}')
+            config.load_table.cache_clear()
+            with (
+                patch.dict(os.environ, VLLM_SM80_SPARSE_CONFIG=str(path)),
+                self.assertRaises(ValueError),
+            ):
+                config.load_table()
+            config.load_table.cache_clear()
+
+    def test_hardware_specific_table_cannot_cross_enabled_sm_counts(self):
+        device = dict(name="GA100", sm_count=70, capability=[8, 0])
+        config.validate_device({}, device)
+        config.validate_device({"device": device}, device)
+        with self.assertRaises(ValueError):
+            config.validate_device({"device": dict(device, sm_count=108)}, device)
+
+    def test_default_keeps_original_single_launch_and_compiler_defaults(self):
+        launch, inputs, calls, _ = load_launcher()
+        launch(**inputs)
+        self.assertEqual(len(calls), 1)
+        name, grid, kwargs = calls[0]
+        self.assertEqual(name, "_sparse_attn_decode_ragged_kernel")
+        self.assertEqual(grid, (6, 1))
+        self.assertEqual((kwargs["BLOCK_K"], kwargs["num_warps"]), (16, 8))
+        self.assertEqual(kwargs["DECODE_MODE"], 0)
+        self.assertNotIn("num_stages", kwargs)
+
+    def test_opt_in_splits_and_reduce_keep_device_lengths_dynamic(self):
+        launch, inputs, calls, tensor = load_launcher()
+        launch(
+            **inputs,
+            sm80_config=config.SparseDecodeConfig(splits=8),
+            inv_rope_positions=tensor((6,)),
+            inv_rope_cos_sin_cache=tensor((10, 64)),
+        )
+        self.assertEqual([c[1] for c in calls], [(6, 8, 1), (6, 16)])
+        self.assertEqual(calls[0][2]["DECODE_MODE"], 1)
+        self.assertEqual(calls[0][2]["NUM_SPLITS"], 8)
+        self.assertTrue(calls[1][2]["FUSE_INV_ROPE"])
+
+    def test_tuned_legacy_shape_still_honors_requested_rotation(self):
+        launch, inputs, calls, tensor = load_launcher()
+        launch(
+            **inputs,
+            sm80_config=config.SparseDecodeConfig(legacy=True),
+            inv_rope_positions=tensor((6,)),
+            inv_rope_cos_sin_cache=tensor((10, 64)),
+        )
+        self.assertEqual(calls[-1][0], "rope")
+
+
+if __name__ == "__main__":
+    unittest.main()
