+# Use upstream's dispatch decision without importing TileLang on a CPU host.
+dispatch_tree = ast.parse((KERNELS / "tilelang_kernels.py").read_text())
+dispatch_nodes = [
+    node
+    for node in dispatch_tree.body
+    if (
+        isinstance(node, ast.FunctionDef)
+        and node.name == "mhc_fused_post_pre_split_config"
+    )
+    or (
+        isinstance(node, ast.Assign)
+        and any(
+            isinstance(target, ast.Name)
+            and target.id in ("_FUSED_POST_PRE_N_THR", "_FUSED_POST_PRE_MAX_TOKENS")
+            for target in node.targets
+        )
+    )
+]
+dispatch = types.ModuleType("vllm.model_executor.kernels.mhc.tilelang_kernels")
+exec(
+    compile(ast.Module(body=dispatch_nodes, type_ignores=[]), "dispatch", "exec"),
+    dispatch.__dict__,
+)
