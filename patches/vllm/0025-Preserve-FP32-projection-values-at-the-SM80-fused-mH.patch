+    def test_fused_projection_preserves_upstream_fp32_seam_and_bf16_storage(self):
+        """Premature BF16 rounding corrupts next mixes, but not the residual ABI."""
+        for rows in (1, 32, 33, 48):
+            with self.subTest(rows=rows):
+                torch.manual_seed(19)
+                r = torch.randn(rows, 4, 5120).bfloat16()
+                x = torch.randn(rows, 5120).bfloat16()
+                post = torch.rand(rows, 4, 1) * 2
+                comb = torch.softmax(torch.randn(rows, 4, 4), -1)
+                fn = torch.randn(24, 20480) / 20480**0.5
+                scale, base = torch.ones(3), torch.randn(24) * 0.1
+                raw = post.double() * x.double().unsqueeze(1) + torch.einsum(
+                    "bij,bih->bjh", comb.double(), r.double()
+                )
+                stored = raw.bfloat16()
+                fused = dispatch.mhc_fused_post_pre_split_config(rows, 5120, 4)
+                projection = raw if fused is not None else stored.double()
+                expected = reference.mhc_pre_delayed_torch(
+                    stored,
+                    fn,
+                    scale,
+                    base,
+                    1e-6,
+                    1e-6,
+                    1e-6,
+                    2.0,
+                    20,
+                    x=projection.flatten(1),
+                    reference_dtype=torch.float64,
+                )
+                actual = kernels.mhc_pre_sm80(
+                    r,
+                    fn,
+                    scale,
+                    base,
+                    1e-6,
+                    1e-6,
+                    1e-6,
+                    2.0,
+                    20,
+                    sublayer_out=x,
+                    post_layer_mix=post,
+                    comb_res_mix=comb,
+                    capture_aux=True,
+                    config=config_module.SM80Config(block_k=2048),
+                )
+                torch.testing.assert_close(actual[0], stored, atol=2e-2, rtol=1e-2)
+                # The same tight FP32 tolerance as the GPU gate.
+                for i in (0, 1, 3):
+                    torch.testing.assert_close(
+                        actual[i + 1].double(),
+                        expected[i].double(),
+                        atol=5e-4,
+                        rtol=1e-3,
+                    )
+                torch.testing.assert_close(actual[3], actual[0][:, 0], atol=0, rtol=0)
+                torch.testing.assert_close(
+                    actual[5], actual[0].mean(1), atol=2e-2, rtol=1e-2
