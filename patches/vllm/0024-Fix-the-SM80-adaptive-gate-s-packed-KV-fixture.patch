+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU checks for the SM80 gate's writer/reader contract, without importing vLLM.
+
+Run directly with Python. The small tensor adapter executes source arithmetic;
+it does not emulate Triton lowering, tensor cores, or CUDA graphs.
+"""
+
+import ast
+import importlib.util
+import math
+import unittest
+from pathlib import Path
+
+import torch
+
+ROOT = Path(__file__).resolve().parents[3]
+GATE = Path(__file__).with_name("sm80_adaptive_gate.py")
+WRITER = ROOT / "vllm/models/deepseek_v41/common/ops/fused_compress_quant_cache.py"
+READER = ROOT / "vllm/v1/attention/ops/rocm_aiter_mla_sparse.py"
+
+
+def source_function(path, name, scope):
+    tree = ast.parse(path.read_text())
+    fn = next(
+        n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef) and n.name == name
+    )
+    fn.decorator_list = []
+    future = ast.ImportFrom(
+        module="__future__", names=[ast.alias(name="annotations")], level=0
+    )
+    module = ast.fix_missing_locations(ast.Module(body=[future, fn], type_ignores=[]))
+    exec(compile(module, str(path), "exec"), scope)
+    return scope[name]
+
+
+class Pointer:
+    def __init__(self, data, offset=0):
+        self.data = data.reshape(-1)
+        self.offset = torch.as_tensor(offset)
+
+    def __add__(self, offset):
+        return Pointer(self.data, self.offset + offset)
+
+    def __sub__(self, offset):
+        return self + (-offset)
+
+    def __getitem__(self, key):
+        return Pointer(self.data, self.offset[key])
+
+    def to(self, dtype):
+        byte_offset = self.offset * self.data.element_size()
+        size = torch.empty((), dtype=dtype).element_size()
+        assert torch.all(byte_offset % size == 0)
+        return Pointer(self.data.view(dtype), byte_offset // size)
+
+
+class TensorLanguage:
+    """Only the operations used by the canonical V4 writer and fallback reader."""
+
+    int32, int64, uint8 = torch.int32, torch.int64, torch.uint8
+    float32, bfloat16 = torch.float32, torch.bfloat16
+    arange = staticmethod(torch.arange)
+    zeros = staticmethod(torch.zeros)
+    full = staticmethod(
+        lambda shape, value, dtype: torch.full(shape, value, dtype=dtype)
+    )
+    exp, exp2 = staticmethod(torch.exp), staticmethod(torch.exp2)
+    log2, ceil = staticmethod(torch.log2), staticmethod(torch.ceil)
+    abs, sum = staticmethod(torch.abs), staticmethod(torch.sum)
+    cumsum = staticmethod(lambda x, axis: torch.cumsum(x, dim=axis))
+    where = staticmethod(torch.where)
+    reshape = staticmethod(torch.reshape)
+    clamp = staticmethod(torch.clamp)
+    range = staticmethod(range)
+    pointer_type = staticmethod(lambda dtype: dtype)
+    trans = staticmethod(lambda x: x.T)
+    split = staticmethod(lambda x: (x[:, 0], x[:, 1]))
+    interleave = staticmethod(lambda a, b: torch.stack((a, b), -1).flatten())
+    dot = staticmethod(lambda a, b: a.float() @ b.float())
+    maximum = staticmethod(
+        lambda a, b: torch.maximum(torch.as_tensor(a), torch.as_tensor(b))
+    )
+    minimum = staticmethod(
+        lambda a, b: torch.minimum(torch.as_tensor(a), torch.as_tensor(b))
+    )
+    max = staticmethod(lambda x, axis: x.max(dim=axis).values)
+
+    def program_id(self, axis):
+        return torch.tensor(self.ids[axis])
+
+    @staticmethod
+    def load(ptr, mask=True, other=0):
+        offsets, valid = torch.broadcast_tensors(
+            ptr.offset.long(), torch.as_tensor(mask)
+        )
+        assert not torch.any(valid & ((offsets < 0) | (offsets >= ptr.data.numel())))
+        return torch.where(
+            valid, ptr.data[offsets.clamp(0, ptr.data.numel() - 1)], other
+        )
+
+    @staticmethod
+    def store(ptr, value, mask=True):
+        offsets, values, valid = torch.broadcast_tensors(
+            ptr.offset.long(), torch.as_tensor(value), torch.as_tensor(mask)
+        )
+        assert not torch.any(valid & ((offsets < 0) | (offsets >= ptr.data.numel())))
+        ptr.data[offsets[valid]] = values[valid].to(ptr.data.dtype)
+
+
+def write_cache(raw, positions, slots, cache, ratio=1):
+    tl = TensorLanguage()
+    write = source_function(
+        WRITER,
+        "_rope_quant_insert_kernel",
+        dict(
+            tl=tl,
+            _encode_e4m3fn_u8=lambda x: x.to(torch.float8_e4m3fn).view(torch.uint8),
+        ),
+    )
+    cs = torch.cat((torch.ones(512, 32), torch.zeros(512, 32)), -1)
+    for row in range(raw.shape[0]):
+        tl.ids = (row,)
+        write(
+            *(Pointer(x) for x in (raw, positions, cs, cache, slots)),
+            COS_STRIDE=64,
+            CACHE_STRIDE=cache.stride(0),
+            CACHE_BLOCK=cache.shape[1],
+            COMPRESS_RATIO=ratio,
+            SANITIZE_CACHE_NANS=False,
+        )
+
+
+def read_attention(cache, q, selected, sink):
+    tl = TensorLanguage()
+    read = source_function(
+        READER,
+        "_sparse_attn_decode_ragged_kernel",
+        dict(
+            tl=tl,
+            _decode_sparse_fp8=lambda x, *_: (
+                x.contiguous().view(torch.float8_e4m3fn).float()
+            ),
+        ),
+    )
+    output = torch.full_like(q, float("nan"))
+    indices = torch.tensor(selected, dtype=torch.int32)
+    indptr = torch.tensor([0, len(selected)] + [len(selected)] * (q.shape[0] - 1))
+    for row in range(q.shape[0]):
+        for head in range(math.ceil(q.shape[1] / 16)):
+            tl.ids = (row, head)
+            read(
+                *(
+                    Pointer(x)
+                    for x in (
+                        q,
+                        cache,
+                        indices,
+                        indptr,
+                        cache,
+                        indices,
+                        indptr,
+                        sink,
+                        output,
+                    )
+                ),
+                q.stride(0),
+                q.stride(1),
+                output.stride(0),
+                output.stride(1),
+                cache.stride(0),
+                cache.stride(0),
+                cache.shape[0] * cache.shape[1],
+                cache.shape[0] * cache.shape[1],
+                cache.shape[1],
+                cache.shape[1],
+                512**-0.5,
+                q.shape[1],
+                HAS_ATTN_SINK=True,
+                HAS_EXTRA=True,
+                NOPE_DIM=448,
+                NOPE_BLOCK=512,
+                ROPE_DIM=64,
+                IS_FNUZ_MAIN=False,
+                IS_FNUZ_EXTRA=False,
+                BLOCK_H=16,
+                BLOCK_K=16,
+            )
+    return output
+
+
+class GateCacheTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        spec = importlib.util.spec_from_file_location("sm80_adaptive_gate", GATE)
+        cls.gate = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(cls.gate)
+        torch.set_num_threads(1)
+
+    def test_dense_padding_compacts_to_one_live_row_without_losing_its_indices(self):
+        tl = TensorLanguage()
+        count = source_function(READER, "_count_valid_row_entries_kernel", dict(tl=tl))
+        compact = source_function(
+            READER, "_compact_dense_row_to_ragged_kernel", dict(tl=tl)
+        )
+        indices = torch.full((6, 16), -1, dtype=torch.int32)
+        selected = torch.arange(128, 144, dtype=torch.int32)
+        indices[0] = selected
+        lengths = torch.tensor([16, 0, 0, 0, 0, 0], dtype=torch.int32)
+        counts = torch.full((6,), -99, dtype=torch.int32)
+        indptr = torch.full((7,), -99, dtype=torch.int32)
+        tl.ids = (0,)
+        count(
+            *(Pointer(x) for x in (indices, lengths, counts, indptr)),
+            indices.stride(0),
+            3 * 128,
+            6,
+            16,
+            BLOCK_R=64,
+            BLOCK_W=16,
+        )
+        indptr[1:] = counts.cumsum(0)
+        flat = torch.full((6 * 16,), -99, dtype=torch.int32)
+        for row in range(6):
+            tl.ids = (row,)
+            compact(
+                *(Pointer(x) for x in (indices, lengths, indptr, flat)),
+                indices.stride(0),
+                3 * 128,
+                16,
+                BLOCK_W=16,
+            )
+        self.assertEqual(counts.tolist(), [16, 0, 0, 0, 0, 0])
+        self.assertEqual(indptr.tolist(), [0, 16, 16, 16, 16, 16, 16])
+        self.assertTrue(torch.equal(flat[:16], selected))
+        self.assertTrue(torch.all(flat[16:] == -99))
+
+    def test_reference_matches_native_writer_payload_scales_and_pad_slots(self):
+        """Compare both page regions; a flattened 584-byte struct is incorrect."""
+        torch.manual_seed(17)
+        block = 128
+        raw = torch.randn(2 * block, 512).to(torch.bfloat16)
+        positions = torch.arange(2 * block)
+        slots = torch.arange(2 * block)
+        slots[:block] = -1
+        data, scales, _ = self.gate.packed_reference(raw)
+        for ratio in (1, 2):
+            with self.subTest(ratio=ratio):
+                actual = torch.full((2, block, 584), 0xA5, dtype=torch.uint8)
+                write_cache(raw, positions, slots, actual, ratio)
+                expected = torch.full_like(actual, 0xA5)
+                payload, scale_bytes = self.gate.cache_views(expected)
+                for t in range(block, 2 * block):
+                    if (int(positions[t]) + 1) % ratio == 0:
+                        payload[1, t - block] = data[t]
+                        scale_bytes[1, t - block] = scales[t]
+                torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+
+    def test_live_row_and_empty_padding_match_float_attention_at_both_head_counts(self):
+        """Execute the source reader on the gate fixture, including both sources."""
+        torch.manual_seed(17)
+        block = 128
+        raw = torch.randn(3 * block, 512).to(torch.bfloat16)
+        data, scales, decoded = self.gate.packed_reference(raw)
+        cache = torch.full((3, block, 584), 0xA5, dtype=torch.uint8)
+        payload, scale_bytes = self.gate.cache_views(cache)
+        payload[1:] = data.reshape(3, block, 576)[1:]
+        scale_bytes[1:] = scales.reshape(3, block, 8)[1:]
+        selected = [block + i for i in (0, 1, 7, 31, 63, 64, 115, 127)]
+        for heads in (16, 64):
+            with self.subTest(heads=heads):
+                q = torch.randn(6, heads, 512).to(torch.bfloat16)
+                sink = torch.linspace(-2, 2, heads)
+                actual = read_attention(cache, q, selected, sink)
+                kv = decoded[selected * 2]
+                scores = q[0].float() @ kv.T / math.sqrt(512)
+                probs = torch.cat((scores, sink[:, None]), -1).softmax(-1)[:, :-1]
+                torch.testing.assert_close(
+                    actual[0].float(), probs @ kv, rtol=1e-2, atol=1e-2
+                )
+                self.assertGreater(actual[0].abs().max().item(), 0.1)
+                self.assertTrue(torch.equal(actual[1:], torch.zeros_like(actual[1:])))
+
+
+if __name__ == "__main__":
+    unittest.main()
